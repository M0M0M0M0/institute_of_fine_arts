# Sample configuration for docker-compose.yml
# Copy this file to .env (same folder) and set YOUR OWN password. The .env file is never committed to Git.

# Password of the sa account of SQL Server in Docker
# Requirements: at least 8 characters, with upper case, lower case, digit and symbol
MSSQL_SA_PASSWORD=ChangeMe@123

# SQL Server port on the host machine (change it if another SQL Server already uses 1433)
SQL_PORT=1433
