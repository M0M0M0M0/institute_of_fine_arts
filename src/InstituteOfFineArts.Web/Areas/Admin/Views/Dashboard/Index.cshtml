@model InstituteOfFineArts.Web.ViewModels.Admin.AdminDashboardVm
@using InstituteOfFineArts.Web.Infrastructure.Security
@using InstituteOfFineArts.Web.Models.Enums
@*
    Admin – dashboard (/admin): accounts, students, competitions, submissions, exhibitions and recent logins.
    Created by BE2-04; styled by FE2-02 (one ledger strip of figures, quick actions, recent logins ledger).
*@
@{
    ViewData["Title"] = "Administrator";
}

<div class="page-head">
    <div>
        <h1>Welcome, @User.GetFullName()</h1>
        <p class="page-sub">Accounts, competitions and exhibitions of the institute at a glance.</p>
    </div>
    <div class="page-actions">
        <a href="/admin/staff/new" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i>New staff member</a>
    </div>
</div>

<partial name="_Alerts" />

@* Key figures: one ledger strip, each figure with its breakdown *@
<dl class="ledger">
    <div id="card-staff">
        <dt>Staff accounts</dt>
        <dd data-stat="staff-total">@Model.StaffTotal</dd>
        <ul class="ledger-list">
            <li>Staff: <strong data-stat="staff-STAFF">@Model.StaffByRole[Role.STAFF]</strong></li>
            <li>Manager: <strong data-stat="staff-MANAGER">@Model.StaffByRole[Role.MANAGER]</strong></li>
            <li>Admin: <strong data-stat="staff-ADMIN">@Model.StaffByRole[Role.ADMIN]</strong></li>
            <li>Active: <strong data-stat="staff-active">@Model.StaffActive</strong>, locked: <strong data-stat="staff-locked">@Model.StaffLocked</strong></li>
        </ul>
    </div>
    <div id="card-students">
        <dt>Students</dt>
        <dd data-stat="students-total">@Model.StudentsTotal</dd>
        <ul class="ledger-list">
            <li>Active: <strong data-stat="students-active">@Model.StudentsActive</strong>, locked: <strong data-stat="students-locked">@Model.StudentsLocked</strong></li>
            @foreach (var (status, count) in Model.StudentsByEnrollment)
            {
                <li>@status: <strong data-stat="enrollment-@status">@count</strong></li>
            }
        </ul>
    </div>
    <div id="card-competitions">
        <dt>Competitions</dt>
        <dd data-stat="competitions-total">@Model.CompetitionsByStatus.Values.Sum()</dd>
        <ul class="ledger-list">
            @foreach (var (status, count) in Model.CompetitionsByStatus)
            {
                <li>@status: <strong data-stat="competition-@status">@count</strong></li>
            }
        </ul>
    </div>
    <div id="card-submissions">
        <dt>Submissions</dt>
        <dd data-stat="submissions-total">@Model.TotalSubmissions</dd>
        <ul class="ledger-list">
            <li>Waiting for evaluation (closed competitions): <strong data-stat="submissions-awaiting">@Model.SubmissionsAwaitingEvaluation</strong></li>
        </ul>
    </div>
    <div id="card-exhibitions">
        <dt>Exhibitions</dt>
        <dd data-stat="exhibitions-total">@Model.ExhibitionsByStatus.Values.Sum()</dd>
        <ul class="ledger-list">
            @foreach (var (status, count) in Model.ExhibitionsByStatus)
            {
                <li>@status: <strong data-stat="exhibition-@status">@count</strong></li>
            }
        </ul>
    </div>
</dl>

@* Quick actions *@
<h2 class="visually-hidden">Quick actions</h2>
<ul class="quick-actions">
    <li><a href="/admin/staff" class="btn btn-outline-primary"><i class="bi bi-person-badge" aria-hidden="true"></i>Staff</a></li>
    <li><a href="/admin/students" class="btn btn-outline-primary"><i class="bi bi-people" aria-hidden="true"></i>Students</a></li>
    <li><a href="/admin/students/import" class="btn btn-outline-primary"><i class="bi bi-filetype-csv" aria-hidden="true"></i>Import students</a></li>
    <li><a href="/admin/audit-log" class="btn btn-outline-primary"><i class="bi bi-journal-text" aria-hidden="true"></i>Audit log</a></li>
    <li><a href="/reports" class="btn btn-outline-primary"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>Reports</a></li>
    <li><a href="/profile" class="btn btn-outline-primary"><i class="bi bi-person" aria-hidden="true"></i>My profile</a></li>
    <li><a href="/profile/change-password" class="btn btn-outline-primary"><i class="bi bi-key" aria-hidden="true"></i>Change password</a></li>
    <li>
        @* Log out with POST plus the anti-forgery token *@
        <form method="post" action="/logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>Log out</button>
        </form>
    </li>
</ul>

@* Most recent logins of any role *@
<section class="section">
    <div class="section-head">
        <h2>Recent logins</h2>
        <a href="/admin/audit-log?Activity=LOGIN" class="btn btn-sm btn-link">Audit log</a>
    </div>
    @if (Model.RecentLogins.Count == 0)
    {
        <div class="empty">
            <i class="bi bi-clock-history" aria-hidden="true"></i>
            <p>Nobody has logged in yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table" id="recent-logins">
                <thead>
                    <tr><th>Username</th><th>Name</th><th>Role</th><th>Time</th></tr>
                </thead>
                <tbody>
                    @foreach (var login in Model.RecentLogins)
                    {
                        <tr>
                            <td>@login.Username</td>
                            <td>@login.FullName</td>
                            <td>@login.Role</td>
                            <td>@login.LastLoginAt.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
