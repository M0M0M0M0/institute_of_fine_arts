@model InstituteOfFineArts.Web.ViewModels.Admin.Grading.CriterionFormVm
@* Admin – new / edit grading criterion (/admin/grading/criteria/new, /admin/grading/criteria/{id}/edit). *@
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New criterion" : "Edit criterion";
}
<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Grading</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(isNew ? "New criterion" : Model.Name)</li>
            </ol>
        </nav>
        <h1>@(isNew ? "New criterion" : "Edit criterion")</h1>
    </div>
</div>
<form method="post" class="form-sheet" style="max-width: 40rem;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" maxlength="100" placeholder="e.g. Light and shadow" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" maxlength="500" placeholder="What the judges look at for this criterion"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Active" class="form-check-input" />
        <label asp-for="Active" class="form-check-label"></label>
        <div class="form-text">Hidden criteria cannot be chosen for new competitions; competitions that already use them keep them.</div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
