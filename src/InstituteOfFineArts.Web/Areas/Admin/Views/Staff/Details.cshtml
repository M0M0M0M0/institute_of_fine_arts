@model InstituteOfFineArts.Web.ViewModels.Admin.Staff.StaffDetailsVm
@*
    Admin – staff details (/admin/staff/{id}, SCR-13) with reset password, lock/unlock and delete.
    Created by BE2-02; styled by FE2-02 (dl.details groups, account actions with styled confirmations).
*@
@{
    ViewData["Title"] = Model.FullName;
    string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "–" : value;
    string Day(DateOnly? d) => d?.ToString("dd MMM yyyy") ?? "–";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Staff</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
            </ol>
        </nav>
        <h1>@Model.FullName</h1>
        <p class="page-sub d-flex flex-wrap gap-2 align-items-center">
            <span>@Model.StaffCode</span><span>@Model.Role</span>
            @if (Model.Active) { <span class="tag tag-ACTIVE">Active</span> } else { <span class="tag tag-INACTIVE">Locked</span> }
        </p>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
    </div>
</div>

<partial name="_Alerts" />

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="details-head">Login</h2>
        <dl class="details">
            <dt>Username</dt><dd>@Model.Username</dd>
            <dt>Email</dt><dd>@Model.Email</dd>
            <dt>Last login</dt><dd>@(Model.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "Never")</dd>
            <dt>Created</dt><dd>@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
        </dl>
        <h2 class="details-head">Personal</h2>
        <dl class="details">
            <dt>Gender</dt><dd>@(Model.Gender?.ToString() ?? "–")</dd>
            <dt>Date of birth</dt><dd>@Day(Model.DateOfBirth)</dd>
            <dt>Phone</dt><dd>@Show(Model.Phone)</dd>
            <dt>Address</dt><dd>@Show(Model.Address)</dd>
        </dl>
    </div>
    <div class="col-lg-6">
        <h2 class="details-head">Job</h2>
        <dl class="details">
            <dt>Joined</dt><dd>@Day(Model.JoinedDate)</dd>
            <dt>Position</dt><dd>@Show(Model.Position)</dd>
            <dt>Classes in charge</dt><dd>@Show(Model.ClassesInCharge)</dd>
            <dt>Subjects in charge</dt><dd>@Show(Model.SubjectsInCharge)</dd>
            <dt>Qualification</dt><dd>@Show(Model.Qualification)</dd>
            <dt>Notes</dt><dd>@Show(Model.Notes)</dd>
        </dl>
        <h2 class="details-head">Related data</h2>
        <dl class="details">
            <dt>Competitions</dt><dd class="num">@Model.CompetitionCount</dd>
            <dt>Evaluations</dt><dd class="num">@Model.EvaluationCount</dd>
            <dt>Awards issued</dt><dd class="num">@Model.AwardCount</dd>
            <dt>Exhibition work</dt><dd class="num">@Model.ExhibitionCount</dd>
        </dl>
    </div>
</div>

<section class="section">
    <div class="section-head"><h2>Account actions</h2></div>
    <div class="account-actions">
        <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="reset-form">
            <div>
                <label class="form-label" for="NewPassword">Temporary password</label>
                <input class="form-control" type="password" id="NewPassword" name="NewPassword" autocomplete="new-password" />
            </div>
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-key" aria-hidden="true"></i>Reset password</button>
        </form>
        @if (!Model.IsCurrentUser)
        {
            <div class="state-forms">
                @if (Model.Active)
                {
                    <form asp-action="Lock" asp-route-id="@Model.Id" method="post"
                          data-confirm="Lock this account? The person will not be able to log in." data-confirm-ok="Lock">
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-lock" aria-hidden="true"></i>Lock</button>
                    </form>
                }
                else
                {
                    <form asp-action="Unlock" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-unlock" aria-hidden="true"></i>Unlock</button>
                    </form>
                }
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      data-confirm="@(Model.HasRelatedData ? "This person has related data, so the account will be locked instead of deleted. Continue?" : "Delete this staff member permanently?")"
                      data-confirm-ok="@(Model.HasRelatedData ? "Lock instead" : "Delete")">
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i>Delete</button>
                </form>
            </div>
        }
        else
        {
            <p class="text-muted small mb-0">This is your own account: it cannot be locked or deleted here.</p>
        }
    </div>
</section>

<a asp-action="Index" class="btn btn-link px-0 mt-4"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to staff list</a>
