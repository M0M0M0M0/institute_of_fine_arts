@model InstituteOfFineArts.Web.ViewModels.Admin.Staff.StaffFormVm
@*
    Admin – edit staff member (/admin/staff/{id}/edit, SCR-12). The username cannot change.
    Created by BE2-02; styled by FE2-02 (form sheet).
*@
@{
    ViewData["Title"] = "Edit staff member";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Staff</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Username</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
        <h1>Edit staff member</h1>
        <p class="page-sub">Username <strong>@Model.Username</strong> (cannot change).</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate class="form-sheet">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
