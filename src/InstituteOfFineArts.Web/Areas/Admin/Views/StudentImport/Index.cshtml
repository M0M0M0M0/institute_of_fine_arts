@using InstituteOfFineArts.Web.Services.Implementations
@*
    Admin – import students from CSV, step 1 upload (/admin/students/import, F-M04-08).
    Created by BE2-OPT 4; styled by FE2-OPT (upload sheet, column reference ledger).
*@
@{
    ViewData["Title"] = "Import students";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/students">Students</a></li>
                <li class="breadcrumb-item active" aria-current="page">Import</li>
            </ol>
        </nav>
        <h1>Import students from CSV</h1>
        <p class="page-sub">Nothing is saved until you have seen the result of the check.</p>
    </div>
    <div class="page-actions">
        <a href="/admin/students/import/template.csv" class="btn btn-outline-primary"><i class="bi bi-download" aria-hidden="true"></i>Download the template</a>
    </div>
</div>

<partial name="_Alerts" />

<p>
    Upload a UTF-8 CSV file (at most 1 MB and @StudentImportService.MaxRows students) whose first row contains the column names.
    Every row is checked with the same rules as the <a href="/admin/students/new">New student</a> form; you see the result before anything is saved.
</p>

<form method="post" action="/admin/students/import" enctype="multipart/form-data" novalidate class="form-sheet mb-5">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
    <div class="mb-3">
        <label for="file" class="form-label">CSV file</label>
        <input type="file" id="file" name="file" accept=".csv,text/csv" class="form-control" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-square" aria-hidden="true"></i>Check the file</button>
        <a href="/admin/students" class="btn btn-link">Cancel</a>
    </div>
</form>

<section class="section">
    <div class="section-head"><h2>Columns</h2></div>
    <div class="table-responsive">
        <table class="table table-sm w-auto">
            <thead><tr><th>Column</th><th>Required</th><th>Format</th></tr></thead>
            <tbody>
                <tr><td class="row-title">StudentCode</td><td>No</td><td>Letters, digits and dashes; empty = next HVnnnn code</td></tr>
                <tr><td class="row-title">FullName</td><td>Yes</td><td>At most 100 characters</td></tr>
                <tr><td class="row-title">Username</td><td>Yes</td><td>3–50 letters, digits, dots or underscores; unique</td></tr>
                <tr><td class="row-title">Email</td><td>Yes</td><td>Valid email address; unique</td></tr>
                <tr><td class="row-title">Password</td><td>Yes</td><td>At least 8 characters with a letter and a digit</td></tr>
                <tr><td class="row-title">Gender</td><td>No</td><td>M, F or O</td></tr>
                <tr><td class="row-title">DateOfBirth</td><td>No</td><td>2004-05-01 or 01/05/2004, in the past</td></tr>
                <tr><td class="row-title">Phone</td><td>No</td><td>Phone number</td></tr>
                <tr><td class="row-title">Address</td><td>No</td><td>At most 255 characters</td></tr>
                <tr><td class="row-title">EnrollmentDate</td><td>Yes</td><td>2025-09-01 or 01/09/2025</td></tr>
                <tr><td class="row-title">Course</td><td>Yes</td><td>e.g. Painting</td></tr>
                <tr><td class="row-title">Class</td><td>No</td><td>e.g. PT03</td></tr>
                <tr><td class="row-title">Status</td><td>No</td><td>STUDYING (default), GRADUATED, SUSPENDED or DROPPED</td></tr>
                <tr><td class="row-title">Notes</td><td>No</td><td>At most 500 characters</td></tr>
            </tbody>
        </table>
    </div>
</section>
