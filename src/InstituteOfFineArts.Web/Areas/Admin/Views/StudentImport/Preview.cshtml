@model InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentImportPreviewVm
@*
    Admin – import students from CSV, step 1 result + step 2 button (POST /admin/students/import, F-M04-08).
    Minimal version created by BE (BE2-OPT 4); FE2 builds the real design in FE2-OPT.
    Passwords from the file are never shown; the file goes to step 2 only inside the encrypted token.
*@
@{
    ViewData["Title"] = "Import students – check";
}

<h1 class="h3 mb-3">Import students – check</h1>
<p>
    File <strong>@Model.FileName</strong>: <span class="text-success">@Model.ValidCount valid</span>,
    <span class="text-danger">@Model.InvalidCount with errors</span> (rows with errors are skipped).
</p>

<div class="table-responsive">
    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Line</th><th>Student code</th><th>Full name</th><th>Username</th><th>Email</th><th>Course</th><th>Class</th><th>Result</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                @* Rows with errors are highlighted and list every problem *@
                <tr class="@(row.IsValid ? "" : "table-danger")">
                    <td>@row.Line</td>
                    <td>@(string.IsNullOrEmpty(row.StudentCode) ? "(generated)" : row.StudentCode)</td>
                    <td>@row.FullName</td>
                    <td>@row.Username</td>
                    <td>@row.Email</td>
                    <td>@row.CourseName</td>
                    <td>@row.ClassName</td>
                    <td>
                        @if (row.IsValid)
                        {
                            <span class="badge bg-success">OK</span>
                        }
                        else
                        {
                            <ul class="mb-0 ps-3 text-danger">
                                @foreach (var error in row.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Token != null)
{
    @* Step 2 posts only the encrypted token; the server checks every row again before saving *@
    <form method="post" action="/admin/students/import/confirm" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@Model.Token" />
        <button type="submit" class="btn btn-primary">Import @Model.ValidCount valid @(Model.ValidCount == 1 ? "row" : "rows")</button>
    </form>
}
else
{
    <div class="alert alert-warning">No row can be imported. Correct the file and upload it again.</div>
}
<a href="/admin/students/import" class="btn btn-link">Upload another file</a>
