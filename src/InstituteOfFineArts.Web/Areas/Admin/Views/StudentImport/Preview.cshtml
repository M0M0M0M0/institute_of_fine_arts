@model InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentImportPreviewVm
@*
    Admin – import students from CSV, step 1 result + step 2 button (POST /admin/students/import, F-M04-08).
    Passwords from the file are never shown; the file goes to step 2 only inside the encrypted token.
    Created by BE2-OPT 4; styled by FE2-OPT (preview ledger, per-line errors as danger tags, neutral confirmation).
*@
@{
    ViewData["Title"] = "Import students – check";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/students">Students</a></li>
                <li class="breadcrumb-item"><a href="/admin/students/import">Import</a></li>
                <li class="breadcrumb-item active" aria-current="page">Check</li>
            </ol>
        </nav>
        <h1>Import students – check</h1>
        <p class="page-sub">
            File <strong>@Model.FileName</strong>: <span class="tag tag-ACTIVE">@Model.ValidCount valid</span>,
            <span class="tag tag-REJECTED">@Model.InvalidCount with errors</span> (rows with errors are skipped).
        </p>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm">
        <thead>
            <tr>
                <th class="text-end">Line</th><th>Student code</th><th>Full name</th><th>Username</th><th>Email</th><th>Course</th><th>Class</th><th>Result</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                @* Rows with errors list every problem as a danger tag *@
                <tr>
                    <td class="text-end">@row.Line</td>
                    <td>@(string.IsNullOrEmpty(row.StudentCode) ? "(generated)" : row.StudentCode)</td>
                    <td>@row.FullName</td>
                    <td>@row.Username</td>
                    <td>@row.Email</td>
                    <td>@row.CourseName</td>
                    <td>@row.ClassName</td>
                    <td>
                        @if (row.IsValid)
                        {
                            <span class="tag tag-ACTIVE">OK</span>
                        }
                        else
                        {
                            <ul class="error-list">
                                @foreach (var error in row.Errors)
                                {
                                    <li class="tag tag-REJECTED tag-wrap">@error</li>
                                }
                            </ul>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="form-actions d-flex flex-wrap gap-2 align-items-center mt-4">
    @if (Model.Token != null)
    {
        @* Step 2 posts only the encrypted token; the server checks every row again before saving *@
        <form method="post" action="/admin/students/import/confirm" class="d-inline"
              data-confirm="@Model.ValidCount @(Model.ValidCount == 1 ? "student account" : "student accounts") will be created. Rows with errors are skipped."
              data-confirm-title="Import students?" data-confirm-ok="Import" data-confirm-tone="neutral">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@Model.Token" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i>Import @Model.ValidCount valid @(Model.ValidCount == 1 ? "row" : "rows")</button>
        </form>
    }
    else
    {
        <div class="alert alert-warning w-100"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div>No row can be imported. Correct the file and upload it again.</div></div>
    }
    <a href="/admin/students/import" class="btn btn-link">Upload another file</a>
</div>
