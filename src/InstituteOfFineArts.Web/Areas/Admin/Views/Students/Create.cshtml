@model InstituteOfFineArts.Web.ViewModels.Admin.Students.CreateStudentVm
@*
    Admin – new student (/admin/students/new, SCR-15).
    Created by BE2-03; styled by FE2-03 (form sheet).
*@
@{
    ViewData["Title"] = "New student";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Students</a></li>
                <li class="breadcrumb-item active" aria-current="page">New</li>
            </ol>
        </nav>
        <h1>New student</h1>
        <p class="page-sub">The username and the first password cannot be changed here later.</p>
    </div>
</div>

<form asp-action="Create" method="post" novalidate class="form-sheet">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <h2 class="details-head">Login</h2>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="NewUsername" class="form-label"></label>
            <input asp-for="NewUsername" class="form-control" autocomplete="off" />
            <span asp-validation-for="NewUsername" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <div class="form-text">At least 8 characters, with a letter and a digit.</div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div>

    <partial name="_Form" model="Model" />

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create student</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
