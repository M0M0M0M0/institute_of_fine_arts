@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentListItemVm>
@*
    Admin – student list & search (/admin/students, SCR-14).
    Created by BE2-03; styled by FE2-03 (page head, shared filters bar and ledger table).
*@
@{
    ViewData["Title"] = "Students";
}

<div class="page-head">
    <div>
        <h1>Students</h1>
        <p class="page-sub">Every student account, with course, class and study status.</p>
    </div>
    <div class="page-actions">
        <a href="/admin/students/import" class="btn btn-outline-primary"><i class="bi bi-filetype-csv" aria-hidden="true"></i>Import from CSV</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>New student</a>
    </div>
</div>

<partial name="_Alerts" />
<partial name="_SearchForm" model="(InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentSearchVm)ViewBag.Search" />
<partial name="_List" model="Model" />
