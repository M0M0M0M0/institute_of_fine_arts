@model InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentDetailsVm
@*
    Login, personal and study information plus related data counts of one student (never the password).
    Shared by /admin/students/{id}, /staff/students/{id} and /manager/students/{id}.
    Created by BE2-03; styled by FE2-03 (dl.details groups).
*@
@{
    string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "–" : value;
    string Day(DateOnly? d) => d?.ToString("dd MMM yyyy") ?? "–";
}

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="details-head">Login</h2>
        <dl class="details">
            <dt>Username</dt><dd>@Model.Username</dd>
            <dt>Email</dt><dd>@Model.Email</dd>
            <dt>Last login</dt><dd>@(Model.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "Never")</dd>
            <dt>Created</dt><dd>@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
        </dl>
        <h2 class="details-head">Personal</h2>
        <dl class="details">
            <dt>Gender</dt><dd>@(Model.Gender?.ToString() ?? "–")</dd>
            <dt>Date of birth</dt><dd>@Day(Model.DateOfBirth)</dd>
            <dt>Phone</dt><dd>@Show(Model.Phone)</dd>
            <dt>Address</dt><dd>@Show(Model.Address)</dd>
        </dl>
    </div>
    <div class="col-lg-6">
        <h2 class="details-head">Study</h2>
        <dl class="details">
            <dt>Student code</dt><dd>@Model.StudentCode</dd>
            <dt>Enrolled</dt><dd>@Day(Model.EnrollmentDate)</dd>
            <dt>Course</dt><dd>@Show(Model.CourseName)</dd>
            <dt>Class</dt><dd>@Show(Model.ClassName)</dd>
            <dt>Study status</dt><dd><span class="tag tag-plain">@Model.EnrollmentStatus</span></dd>
            <dt>Notes</dt><dd>@Show(Model.Notes)</dd>
        </dl>
        <h2 class="details-head">Related data</h2>
        <dl class="details">
            <dt>Submissions</dt><dd class="num">@Model.SubmissionCount</dd>
            <dt>Exhibition entries</dt><dd class="num">@Model.ExhibitionEntryCount</dd>
            <dt>Awards won</dt><dd class="num">@Model.AwardCount</dd>
        </dl>
    </div>
</div>
