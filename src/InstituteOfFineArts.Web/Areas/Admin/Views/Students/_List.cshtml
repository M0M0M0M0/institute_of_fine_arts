@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentListItemVm>
@*
    Minimal version created by BE (BE2-03); FE2 builds the real design in FE2-03.
    Student table with pager, shared by /admin/students and /staff/students (links go to the current controller).
    The filters are read from ViewBag.Search so the pager keeps them.
*@
@{
    var search = (InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentSearchVm)ViewBag.Search;
    object PageRoute(int page) => new
    {
        search.Keyword, search.Course, search.ClassName, search.Status, search.Active,
        EnrolledFrom = search.EnrolledFrom?.ToString("yyyy-MM-dd"), EnrolledTo = search.EnrolledTo?.ToString("yyyy-MM-dd"), page,
    };
}

@if (Model.TotalCount == 0)
{
    <p class="text-muted">No results found.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Code</th><th>Name</th><th>Username</th><th>Course</th><th>Class</th><th>Enrolled</th><th>Study status</th><th>Account</th></tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Items)
            {
                <tr>
                    <td>@s.StudentCode</td>
                    <td><a asp-action="Details" asp-route-id="@s.Id">@s.FullName</a><div class="small text-muted">@s.Email</div></td>
                    <td>@s.Username</td>
                    <td>@s.CourseName</td>
                    <td>@s.ClassName</td>
                    <td>@s.EnrollmentDate.ToString("dd MMM yyyy")</td>
                    <td>@s.EnrollmentStatus</td>
                    <td>@if (s.Active) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Locked</span> }</td>
                </tr>
            }
        </tbody>
    </table>

    @* Pager keeps the current filters *@
    <nav class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">@Model.TotalCount student(s) · page @Model.Page of @Model.TotalPages</span>
        <div>
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", PageRoute(Model.Page - 1))">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next</a>
            }
        </div>
    </nav>
}
