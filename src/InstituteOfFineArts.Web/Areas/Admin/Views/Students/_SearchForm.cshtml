@model InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentSearchVm
@*
    Student filters (F-M04-04), shared by /admin/students, /staff/students and /manager/students
    (submits to the current controller's Index).
    Created by BE2-03; styled by FE2-03 (filters bar).
*@

<form method="get" asp-action="Index" class="filters">
    <div class="filter">
        <label class="form-label" for="Keyword">Name, username, code or email</label>
        <input class="form-control" id="Keyword" name="Keyword" value="@Model.Keyword" />
    </div>
    <div class="filter">
        <label class="form-label" for="Course">Course</label>
        <input class="form-control" id="Course" name="Course" value="@Model.Course" />
    </div>
    <div class="filter">
        <label class="form-label" for="ClassName">Class</label>
        <input class="form-control" id="ClassName" name="ClassName" value="@Model.ClassName" />
    </div>
    <div class="filter">
        <label class="form-label" for="Status">Study status</label>
        <select class="form-select" id="Status" name="Status">
            <option value="">All</option>
            @foreach (var st in Enum.GetValues<EnrollmentStatus>())
            {
                <option value="@st" selected="@(Model.Status == st)">@st</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Active">Account</label>
        <select class="form-select" id="Active" name="Active">
            <option value="">All</option>
            <option value="true" selected="@(Model.Active == true)">Active</option>
            <option value="false" selected="@(Model.Active == false)">Locked</option>
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="EnrolledFrom">Enrolled from</label>
        <input class="form-control" type="date" id="EnrolledFrom" name="EnrolledFrom" value="@Model.EnrolledFrom?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="EnrolledTo">Enrolled to</label>
        <input class="form-control" type="date" id="EnrolledTo" name="EnrolledTo" value="@Model.EnrolledTo?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>
