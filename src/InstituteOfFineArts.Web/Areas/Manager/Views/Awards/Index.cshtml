@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Staff.Awards.AwardIssuedListItemVm>
@*
    Manager – issued awards, read only (/manager/awards, F-M11-04): same filters as /staff/awards (competition,
    student, award, issued date range) and paging; no issue / edit / revoke (TC-M11-02).
    Created by BE2-13; styled by FE2-10: the awarded paintings hang in a gilt-framed, wall-labelled grid.
*@
@using InstituteOfFineArts.Web.ViewModels.Staff.Awards
@using InstituteOfFineArts.Web.ViewModels.Staff.Submissions
@{
    ViewData["Title"] = "Issued awards";
    var search = (AwardIssuedSearchVm)ViewBag.Search;
    var competitions = (IReadOnlyList<CompetitionOptionVm>)ViewBag.Competitions;
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new
    {
        search.CompetitionId, search.Student, search.Award,
        From = search.From?.ToString("yyyy-MM-dd"), To = search.To?.ToString("yyyy-MM-dd"), page,
    };
    var filtered = search.CompetitionId != null || !string.IsNullOrEmpty(search.Student) || !string.IsNullOrEmpty(search.Award) || search.From != null || search.To != null;
}

<div class="page-head">
    <div>
        <h1>Issued awards</h1>
        <p class="page-sub">The paintings that won a prize, with the award and when it was given. Read only.</p>
    </div>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Index" class="filters" role="search">
    <div class="filter is-wide">
        <label class="form-label" for="CompetitionId">Competition</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">All competitions</option>
            @foreach (var c in competitions)
            {
                <option value="@c.Id" selected="@(search.CompetitionId == c.Id)">@c.Code – @c.Title</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Student">Student name or code</label>
        <input class="form-control" id="Student" name="Student" value="@search.Student" />
    </div>
    <div class="filter">
        <label class="form-label" for="Award">Award</label>
        <input class="form-control" id="Award" name="Award" value="@search.Award" placeholder="e.g. First Prize" />
    </div>
    <div class="filter">
        <label class="form-label" for="From">Issued from</label>
        <input class="form-control" type="date" id="From" name="From" value="@search.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="To">Issued to</label>
        <input class="form-control" type="date" id="To" name="To" value="@search.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-link">Clear</a>
        }
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-trophy" aria-hidden="true"></i>
        <p>No issued awards found.</p>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-outline-primary">Clear the filters</a>
        }
    </div>
}
else
{
    @* Links go to the manager's read-only pages of submissions, students and competitions (BE2-13 part 1) *@
    <div class="art-grid">
        @foreach (var a in Model.Items)
        {
            <figure class="artwork is-awarded">
                @* The frame repeats the title link, so it is hidden from the keyboard and screen readers *@
                <a class="artwork-frame" href="/manager/submissions/@a.SubmissionId" tabindex="-1" aria-hidden="true">
                    <img src="/files/submissions/@a.SubmissionId/thumb" alt="@a.SubmissionTitle – @a.StudentName" loading="lazy" />
                </a>
                <figcaption class="wall-label">
                    <span class="wl-title"><a href="/manager/submissions/@a.SubmissionId">@a.SubmissionTitle</a></span>
                    <span class="wl-artist"><a href="/manager/students/@a.StudentId">@a.StudentName</a> <span class="text-muted">@a.StudentCode</span></span>
                    <span class="wl-meta"><a href="/manager/competitions/@a.CompetitionId">@a.CompetitionTitle</a> <span class="text-muted">@a.CompetitionCode</span></span>
                    <span class="wl-state">
                        <span class="tag tag-award"><i class="bi bi-award" aria-hidden="true"></i>@a.AwardName</span>
                        <span class="small">(rank @a.Rank)</span>
                        <span class="num">@a.PrizeValue.ToString("$#,##0.00")</span>
                    </span>
                    <span class="wl-meta num">@a.IssuedDate.ToString("dd MMM yyyy") by @a.IssuedByName</span>
                    @* Remarks typed by staff: encoded by Razor, line breaks kept *@
                    @if (a.Remarks != null)
                    {
                        <span class="wl-note pre-line">@a.Remarks</span>
                    }
                </figcaption>
            </figure>
        }
    </div>

    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount award(s), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next<i class="bi bi-chevron-right ms-1" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}
