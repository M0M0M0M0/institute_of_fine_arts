@model InstituteOfFineArts.Web.ViewModels.Staff.Customers.CustomerDetailsVm
@*
    Manager – customer details, read only (/manager/customers/{id}): contact information and the artworks bought,
    each linked to its exhibition entry. No edit / delete.
    Created by BE2-13; styled by FE2-10 (contact in dl.details, purchases as a ledger strip + ledger table).
*@
@{
    ViewData["Title"] = Model.FullName;
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Customers</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
            </ol>
        </nav>
        <h1>@Model.FullName</h1>
    </div>
</div>

<partial name="_Alerts" />

<dl class="details">
    <dt>Phone</dt>
    <dd class="num">@(Model.Phone ?? "–")</dd>
    <dt>Email</dt>
    <dd>@(Model.Email ?? "–")</dd>
    <dt>Address</dt>
    <dd>@(Model.Address ?? "–")</dd>
    <dt>Notes</dt>
    <dd class="pre-line">@(Model.Notes ?? "–")</dd>
    <dt>Recorded</dt>
    <dd class="num">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
</dl>

@* Artworks bought (sold exhibition entries), read only *@
<section class="section" aria-labelledby="purchases-heading">
    <div class="section-head"><h2 id="purchases-heading">Purchases</h2></div>
    @if (Model.Purchases.Count == 0)
    {
        <div class="empty">
            <i class="bi bi-bag" aria-hidden="true"></i>
            <p>This customer has not bought any artwork yet.</p>
        </div>
    }
    else
    {
        <dl class="ledger">
            <div><dt>Artworks bought</dt><dd>@Model.Purchases.Count</dd></div>
            <div><dt>Total spent</dt><dd class="money">@Model.PurchaseTotal.ToString("$#,##0.00")</dd></div>
        </dl>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th scope="col">Artwork</th><th scope="col">Exhibition</th><th scope="col" class="text-end">Sold price</th><th scope="col" class="text-end">Sold date</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Purchases)
                    {
                        <tr>
                            <td class="row-title"><a asp-controller="ExhibitionEntries" asp-action="Details" asp-route-id="@p.EntryId">@p.ArtworkTitle</a></td>
                            <td><a asp-controller="Exhibitions" asp-action="Details" asp-route-id="@p.ExhibitionId">@p.ExhibitionName</a></td>
                            <td class="text-end">@(p.SoldPrice?.ToString("$#,##0.00") ?? "–")</td>
                            <td class="text-end">@(p.SoldDate?.ToString("dd MMM yyyy") ?? "–")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="2">Total</td><td class="text-end">@Model.PurchaseTotal.ToString("$#,##0.00")</td><td></td></tr>
                </tfoot>
            </table>
        </div>
    }
</section>

<p class="mt-4"><a asp-action="Index" class="btn btn-link px-0"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to customers</a></p>
