@model InstituteOfFineArts.Web.ViewModels.Staff.ExhibitionEntries.EntryDetailsVm
@*
    Manager – exhibition entry details, read only (/manager/exhibition-entries/{id}, SCR-55; F-M09-11 = F-M11-07):
    painting, student, exhibition, asking / sold price, customer, payment to the student. The Can* flags and action
    forms of the model are ignored on purpose: only STAFF changes entries.
    Created by BE2-13; styled by FE2-10 (artwork stage + state ladder shared with the Staff page, no forms).
*@
@{
    ViewData["Title"] = $"Entry – {Model.Title}";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Exhibition entries</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-route-exhibitionId="@Model.ExhibitionId">@Model.ExhibitionName</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <h1>@Model.Title</h1>
        <p class="page-sub"><partial name="_Status" model="Model.Status" /> <span class="ms-1">@Model.StudentName (@Model.StudentCode), @Model.ExhibitionName</span></p>
    </div>
</div>

<partial name="_Alerts" />

<div class="artwork-stage">
    <partial name="~/Views/Shared/Exhibitions/_EntryPainting.cshtml" model="Model" />
    <div>
        <partial name="~/Views/Shared/Exhibitions/_EntryFacts.cshtml" model="Model" />
    </div>
</div>

<p class="mt-4"><a asp-action="Index" asp-route-exhibitionId="@Model.ExhibitionId" class="btn btn-link px-0"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to the entries</a></p>
