@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Staff.ExhibitionEntries.EntryListItemVm>
@*
    Manager – exhibition entries, read only (/manager/exhibition-entries, SCR-54; F-M09-11 = F-M11-07): filters
    exhibition (?exhibitionId= from the exhibition details page) / status / paid to student / student, paging.
    No add / accept / sell / pay actions (those stay with STAFF). Filters and results are shared with the Staff area.
    Created by BE2-13; styled by FE2-10.
*@
@using InstituteOfFineArts.Web.ViewModels.Staff.ExhibitionEntries
@{
    ViewData["Title"] = "Exhibition entries";
    var search = (EntrySearchVm)ViewBag.Search;
    var exhibitions = (List<EntryExhibitionOptionVm>)ViewBag.Exhibitions;
    var chosen = exhibitions.FirstOrDefault(x => x.Id == search.ExhibitionId);
}

<div class="page-head">
    <div>
        @if (chosen != null)
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Exhibitions" asp-action="Index">Exhibitions</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Exhibitions" asp-action="Details" asp-route-id="@chosen.Id">@chosen.Name</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Artworks</li>
                </ol>
            </nav>
        }
        <h1>Exhibition entries</h1>
        <p class="page-sub">
            @if (chosen != null)
            {
                @:The paintings of @chosen.Name, @chosen.StartDate.ToString("dd MMM yyyy") – @chosen.EndDate.ToString("dd MMM yyyy").
            }
            else
            {
                @:Every painting sent to an exhibition, with its sale and payment. Read only.
            }
        </p>
    </div>
</div>

<partial name="_Alerts" />

<partial name="~/Views/Shared/Exhibitions/_EntryFilters.cshtml" model="search" />
<partial name="~/Views/Shared/Exhibitions/_EntryList.cshtml" model="Model" />
