@model InstituteOfFineArts.Web.ViewModels.Staff.Exhibitions.ExhibitionFormVm
@*
    Manager – edit exhibition (/manager/exhibitions/{id}/edit, SCR-56). Form shared with the other area
    (Views/Shared/Exhibitions/_ExhibitionForm.cshtml).
    Created by BE2-09; styled by FE2-07.
*@
@{
    ViewData["Title"] = "Edit exhibition";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Exhibitions</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@(string.IsNullOrWhiteSpace(Model.Name) ? "Exhibition" : Model.Name)</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
        <h1>Edit exhibition</h1>
    </div>
</div>

<partial name="~/Views/Shared/Exhibitions/_ExhibitionForm.cshtml" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
