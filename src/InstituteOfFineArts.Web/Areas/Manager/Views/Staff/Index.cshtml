@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Admin.Staff.StaffListItemVm>
@*
    Manager – staff list & search, read only (/manager/staff, SCR-51; F-M11-02, TC-M11-01): no create / edit / delete buttons.
    Created by BE2-13; styled by FE2-03 (filters bar, ledger table with ACTIVE / INACTIVE tags, pager).
*@
@{
    ViewData["Title"] = "Staff";
    var search = (InstituteOfFineArts.Web.ViewModels.Admin.Staff.StaffSearchVm)ViewBag.Search;
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new { search.Keyword, search.Role, search.Subject, search.ClassName, search.Active, page };
}

<div class="page-head">
    <div>
        <h1>Staff</h1>
        <p class="page-sub">Teachers, managers and administrators of the institute, read only.</p>
    </div>
</div>

<partial name="_Alerts" />

@* GET search form: filters only, nothing is changed *@
<form method="get" asp-action="Index" class="filters">
    <div class="filter">
        <label class="form-label" for="Keyword">Name, username, code or email</label>
        <input class="form-control" id="Keyword" name="Keyword" value="@search.Keyword" />
    </div>
    <div class="filter">
        <label class="form-label" for="Role">Role</label>
        <select class="form-select" id="Role" name="Role">
            <option value="">All</option>
            @foreach (var r in new[] { Role.STAFF, Role.MANAGER, Role.ADMIN })
            {
                <option value="@r" selected="@(search.Role == r)">@r</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Subject">Subject</label>
        <input class="form-control" id="Subject" name="Subject" value="@search.Subject" />
    </div>
    <div class="filter">
        <label class="form-label" for="ClassName">Class</label>
        <input class="form-control" id="ClassName" name="ClassName" value="@search.ClassName" />
    </div>
    <div class="filter">
        <label class="form-label" for="Active">Status</label>
        <select class="form-select" id="Active" name="Active">
            <option value="">All</option>
            <option value="true" selected="@(search.Active == true)">Active</option>
            <option value="false" selected="@(search.Active == false)">Locked</option>
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-person-badge" aria-hidden="true"></i>
        <p>No results found.</p>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">Clear filters</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>Code</th><th>Name</th><th>Username</th><th>Role</th><th>Subjects</th><th>Classes</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    <tr>
                        <td>@s.StaffCode</td>
                        <td><a class="row-title" asp-action="Details" asp-route-id="@s.Id">@s.FullName</a><div class="small text-muted">@s.Position</div></td>
                        <td>@s.Username</td>
                        <td>@s.Role</td>
                        <td>@s.SubjectsInCharge</td>
                        <td>@s.ClassesInCharge</td>
                        <td>@if (s.Active) { <span class="tag tag-ACTIVE">Active</span> } else { <span class="tag tag-INACTIVE">Locked</span> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Pager keeps the current filters *@
    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount staff member(s). Page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next<i class="bi bi-chevron-right ms-1 me-0" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}
