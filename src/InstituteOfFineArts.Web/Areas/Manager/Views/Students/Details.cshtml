@model InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentDetailsVm
@*
    Manager – student details, read only (/manager/students/{id}, SCR-51; F-M11-02): personal and study information,
    no account actions. Reuses the information partial of the Admin area.
    Created by BE2-13; styled by FE2-03 (page head, dl.details groups).
*@
@{
    ViewData["Title"] = Model.FullName;
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Students</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
            </ol>
        </nav>
        <h1>@Model.FullName</h1>
        <p class="page-sub d-flex flex-wrap gap-2 align-items-center">
            <span>@Model.StudentCode</span><span>@Model.CourseName @Model.ClassName</span>
            @if (Model.Active) { <span class="tag tag-ACTIVE">Active</span> } else { <span class="tag tag-INACTIVE">Locked</span> }
        </p>
    </div>
    <div class="page-actions">
        @* The student's entries in the manager submission list (filter by student code) *@
        <a asp-controller="Submissions" asp-action="Index" asp-route-student="@Model.StudentCode" class="btn btn-outline-primary"><i class="bi bi-images" aria-hidden="true"></i>Submissions</a>
    </div>
</div>

<partial name="~/Areas/Admin/Views/Students/_Info.cshtml" model="Model" />

<a asp-action="Index" class="btn btn-link px-0 mt-4"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to student list</a>
