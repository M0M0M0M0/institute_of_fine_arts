@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentListItemVm>
@*
    Manager – student list & search, read only (/manager/students, SCR-51; F-M11-02, TC-M11-01): no create / edit / delete buttons.
    Reuses the search form and table partials of the Admin area (links go to the current controller).
    Created by BE2-13; styled by FE2-03 (page head, filters bar, ledger table).
*@
@{
    ViewData["Title"] = "Students";
}

<div class="page-head">
    <div>
        <h1>Students</h1>
        <p class="page-sub">Students of the institute with course, class and study status, read only.</p>
    </div>
</div>

<partial name="_Alerts" />
<partial name="~/Areas/Admin/Views/Students/_SearchForm.cshtml" model="(InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentSearchVm)ViewBag.Search" />
<partial name="~/Areas/Admin/Views/Students/_List.cshtml" model="Model" />
