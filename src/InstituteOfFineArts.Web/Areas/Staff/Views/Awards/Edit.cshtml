@model InstituteOfFineArts.Web.ViewModels.Staff.Awards.AwardIssuedFormVm
@*
    Staff – edit or revoke an issued award (/staff/awards/{id}/edit, SCR-28, F-M08-02/03): change the entry, award,
    date or remarks with the same rules as issuing; revoking needs a reason, which is logged (BR-33).
    Created by BE1 (BE1-11); styled by FE1-07.
*@
@{
    ViewData["Title"] = "Edit issued award";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Issued awards</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
        <h1>Edit issued award</h1>
        <p class="page-sub d-flex flex-wrap align-items-center gap-2">
            <span>@Model.CompetitionTitle, @Model.CompetitionCode</span>
            @if (Model.CompetitionStatus is { } status)
            {
                <partial name="~/Areas/Staff/Views/Competitions/_Status.cshtml" model="status" />
            }
        </p>
    </div>
</div>
<partial name="_Alerts" />

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate class="form-sheet">
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-controller="Competitions" asp-action="Details" asp-route-id="@Model.CompetitionId" class="btn btn-link">Cancel</a>
    </div>
</form>

@* Revoke (F-M08-03, BR-33): POST with anti-forgery token, reason required, a confirmation dialog asks first *@
<section class="section form-sheet" aria-labelledby="revoke-title">
    <div class="section-head"><h2 id="revoke-title" class="text-danger">Revoke this award</h2></div>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
          data-confirm="Revoke this award?" data-confirm-ok="Revoke award">
        <div class="mb-3">
            <label for="Reason" class="form-label">Reason</label>
            <textarea name="Reason" id="Reason" class="form-control" rows="2" maxlength="500" required></textarea>
            <div class="form-text">Required. The reason is recorded in the system log.</div>
        </div>
        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle" aria-hidden="true"></i>Revoke award</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
