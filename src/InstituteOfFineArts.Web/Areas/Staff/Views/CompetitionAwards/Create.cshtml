@model InstituteOfFineArts.Web.ViewModels.Staff.Competitions.CompetitionAwardFormVm
@*
    Staff – add an award to a competition (/staff/competitions/{competitionId}/awards/new, F-M05-06).
    Minimal version created by BE1 (BE1-06); FE1 builds the real design in FE1-03.
*@
@{
    ViewData["Title"] = "Add award";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-1">Add award</h1>
        <p class="text-muted">@Model.CompetitionTitle · @Model.CompetitionCode</p>

        <form asp-action="Create" asp-route-competitionId="@Model.CompetitionId" method="post" novalidate>
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary">Add award</button>
            <a asp-controller="Competitions" asp-action="Details" asp-route-id="@Model.CompetitionId" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
