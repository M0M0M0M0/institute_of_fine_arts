@model InstituteOfFineArts.Web.ViewModels.Staff.Competitions.CompetitionFormVm
@*
    Staff – new competition (/staff/competitions/new, SCR-24).
    Created by BE1 (BE1-05); styled by FE1-03.
*@
@{
    ViewData["Title"] = "New competition";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Competitions</a></li>
                <li class="breadcrumb-item active" aria-current="page">New</li>
            </ol>
        </nav>
        <h1>New competition</h1>
        <p class="page-sub">The code is generated automatically and the status follows the dates.</p>
    </div>
</div>
<partial name="_Alerts" />

@* multipart/form-data is required to upload the cover image *@
<form asp-action="Create" method="post" enctype="multipart/form-data" novalidate class="form-sheet">
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create competition</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
