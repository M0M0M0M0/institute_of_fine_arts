@model InstituteOfFineArts.Web.ViewModels.Staff.Competitions.CompetitionFormVm
@*
    Staff – new competition (/staff/competitions/new, SCR-24).
    Minimal version created by BE1 (BE1-05); FE1 builds the real design in FE1-03.
*@
@{
    ViewData["Title"] = "New competition";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">New competition</h1>
        <p class="text-muted">The code is generated automatically and the status follows the dates.</p>

        @* multipart/form-data is required to upload the cover image *@
        <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary">Create competition</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
