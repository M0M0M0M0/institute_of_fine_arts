@model InstituteOfFineArts.Web.ViewModels.Staff.Competitions.CompetitionDetailsVm
@*
    Staff – competition details (/staff/competitions/{id}, SCR-25): information, rules, awards, entries, status.
    Created by BE1 (BE1-05, award controls BE1-06, issued awards + publish BE1-11); styled by FE1-03 / FE1-07:
    cover + key facts, grading progress, awards ledger with the issued winners in gilt, publish form.
*@
@{
    ViewData["Title"] = Model.Title;
    var gradingStarted = Model.Status is CompetitionStatus.CLOSED or CompetitionStatus.GRADED;
    var percent = Model.SubmissionCount == 0 ? 0 : (int)Math.Round(100.0 * Model.EvaluatedCount / Model.SubmissionCount);
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Competitions</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Code</li>
            </ol>
        </nav>
        <h1>@Model.Title</h1>
        <p class="page-sub d-flex flex-wrap align-items-center gap-2"><span>@Model.Code</span> <partial name="_Status" model="Model.Status" /></p>
    </div>
    <div class="page-actions">
        <a href="/staff/submissions?competitionId=@Model.Id" class="btn btn-primary"><i class="bi bi-images" aria-hidden="true"></i>View entries</a>
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
        }
        @if (Model.CanDelete)
        {
            @* POST with anti-forgery token; a confirmation dialog asks first *@
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  data-confirm="Delete this competition and its awards?" data-confirm-ok="Delete">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i>Delete</button>
            </form>
        }
    </div>
</div>
<partial name="_Alerts" />

@foreach (var warning in Model.Warnings)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div>@warning</div></div>
}

<div class="@(Model.HasCover ? "artwork-stage" : "")">
    @if (Model.HasCover)
    {
        <div class="artwork-frame"><img src="/files/competitions/@Model.Id/cover" alt="Cover of @Model.Title" /></div>
    }
    <div>
        <dl class="details">
            <dt>Start date</dt>
            <dd class="num">@Model.StartDate.ToString("dd MMM yyyy")</dd>
            <dt>End date (deadline)</dt>
            <dd class="num">@Model.EndDate.ToString("dd MMM yyyy"), 23:59:59</dd>
            <dt>Entries</dt>
            <dd>
                @Model.SubmissionCount
                <a href="/staff/submissions?competitionId=@Model.Id" class="ms-2">View entries</a>
            </dd>
            <dt>Created by</dt>
            <dd>@Model.CreatedByName, @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
            @if (Model.PublishedAt is { } published)
            {
                <dt>Results published</dt>
                <dd>@published.ToString("dd MMM yyyy HH:mm")@(Model.PublishedByName != null ? $" by {Model.PublishedByName}" : "")</dd>
                <dt>Result remarks</dt>
                <dd style="white-space: pre-line">@(Model.ResultRemarks ?? "–")</dd>
            }
        </dl>

        @* Grading progress (F-M07-09) once the deadline has passed *@
        @if (gradingStarted)
        {
            <div class="grading-progress">
                <div class="d-flex justify-content-between gap-2">
                    <span class="fw-medium">Grading</span>
                    <span class="num text-muted" id="grading-progress">@Model.EvaluatedCount/@Model.SubmissionCount graded</span>
                </div>
                <div class="progress" role="progressbar" aria-label="Grading progress" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @percent%"></div>
                </div>
            </div>
        }
    </div>
</div>

@* white-space: pre-line keeps the line breaks typed by staff; Razor still encodes the text (no HTML/XSS) *@
<section class="section" aria-labelledby="about-title">
    <div class="section-head"><h2 id="about-title">Description</h2></div>
    <p style="white-space: pre-line">@(Model.Description ?? "–")</p>
    <h3>Rules &amp; conditions</h3>
    <p style="white-space: pre-line">@(Model.Rules ?? "–")</p>
</section>

@* Awards (F-M05-06, BE1-06): add / edit / delete while the competition is not GRADED *@
<section class="section" aria-labelledby="awards-title">
    <div class="section-head">
        <h2 id="awards-title">Awards</h2>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.CanIssueAwards)
            {
                @* Issue an award to a BEST entry (F-M08-01, BE1-11) *@
                <a asp-controller="Awards" asp-action="Create" asp-route-competitionId="@Model.Id" class="btn btn-sm btn-primary"><i class="bi bi-trophy" aria-hidden="true"></i>Issue award</a>
            }
            @if (Model.CanManageAwards)
            {
                <a asp-controller="CompetitionAwards" asp-action="Create" asp-route-competitionId="@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Add award</a>
            }
        </div>
    </div>
    @if (Model.Awards.Count == 0)
    {
        <div class="empty">
            <i class="bi bi-trophy" aria-hidden="true"></i>
            <p>No awards defined yet.</p>
            @if (Model.CanManageAwards)
            {
                <a asp-controller="CompetitionAwards" asp-action="Create" asp-route-competitionId="@Model.Id" class="btn btn-primary">Add award</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th class="text-end">Rank</th><th>Award</th><th class="text-end">Prize</th><th class="text-end">Quantity</th><th class="text-end">Given</th><th>Description</th><th>Winners</th>
                        @if (Model.CanManageAwards)
                        {
                            <th><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Awards)
                    {
                        <tr>
                            <td class="text-end">@a.Rank</td>
                            <td class="row-title">@a.Name</td>
                            <td class="text-end">@a.PrizeValue.ToString("$#,##0.00")</td>
                            <td class="text-end">@a.Quantity</td>
                            <td class="text-end">@a.IssuedCount</td>
                            <td>@a.Description</td>
                            <td>
                                @* Issued awards of this row (BE1-11): student + artwork, edit / revoke on the award page *@
                                <ul class="winners">
                                    @foreach (var w in a.Winners)
                                    {
                                        <li>
                                            <i class="bi bi-award-fill" aria-hidden="true"></i>
                                            <span>
                                                <a asp-controller="Submissions" asp-action="Details" asp-route-id="@w.SubmissionId" class="wl-title">@w.SubmissionTitle</a>
                                                – @w.StudentName <span class="text-muted small">@w.StudentCode, @w.IssuedDate.ToString("dd MMM yyyy")</span>
                                                <a asp-controller="Awards" asp-action="Edit" asp-route-id="@w.IssuedId" class="small ms-1">Edit</a>
                                            </span>
                                        </li>
                                    }
                                </ul>
                                @if (Model.CanIssueAwards && a.IssuedCount < a.Quantity)
                                {
                                    <a asp-controller="Awards" asp-action="Create" asp-route-competitionId="@Model.Id" asp-route-competitionAwardId="@a.Id" class="btn btn-sm btn-outline-primary">Issue</a>
                                }
                            </td>
                            @if (Model.CanManageAwards)
                            {
                                <td class="table-actions">
                                    <a asp-controller="CompetitionAwards" asp-action="Edit" asp-route-competitionId="@Model.Id" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    @* An award that has been given cannot be deleted; POST with anti-forgery token otherwise *@
                                    @if (a.IssuedCount == 0)
                                    {
                                        <form asp-controller="CompetitionAwards" asp-action="Delete" asp-route-competitionId="@Model.Id" asp-route-id="@a.Id" method="post" class="d-inline"
                                              data-confirm="Delete this award?" data-confirm-ok="Delete">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@* Publish results (F-M05-08, BR-08, BE1-11): only while CLOSED; refused while entries are not graded *@
@if (Model.CanPublish)
{
    <section class="section" id="publish-results" aria-labelledby="publish-title">
        <div class="section-head"><h2 id="publish-title">Publish results</h2></div>
        <div class="publish-sheet">
            <p class="mb-2">Graded: <strong class="num">@Model.EvaluatedCount/@Model.SubmissionCount</strong></p>
            @if (Model.PublishBlockedReason != null)
            {
                <div class="alert alert-warning mb-3"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div>@Model.PublishBlockedReason</div></div>
            }
            <p class="text-muted small">
                After publishing, students see their ratings, comments and awards; the competition, its awards and the evaluations become read only.
            </p>
            @* POST with anti-forgery token; a confirmation dialog asks first *@
            <form asp-controller="CompetitionResults" asp-action="Publish" asp-route-id="@Model.Id" method="post" class="form-sheet"
                  data-confirm="Publish the results? The competition will become read only." data-confirm-ok="Publish results"
                  data-confirm-title="Publish results" data-confirm-tone="neutral">
                <div class="mb-3">
                    <label for="ResultRemarks" class="form-label">Result remarks (optional)</label>
                    <textarea id="ResultRemarks" name="ResultRemarks" class="form-control" rows="3" maxlength="2000"></textarea>
                </div>
                <button type="submit" class="btn btn-primary" disabled="@(Model.PublishBlockedReason != null)"><i class="bi bi-megaphone" aria-hidden="true"></i>Publish results</button>
            </form>
        </div>
    </section>
}

<p class="mt-4"><a asp-action="Index" class="btn btn-link px-0">Back to competitions</a></p>
