@model InstituteOfFineArts.Web.ViewModels.Staff.Competitions.CompetitionFormVm
@*
    Staff – edit competition (/staff/competitions/{id}/edit, SCR-24).
    Created by BE1 (BE1-05); styled by FE1-03.
*@
@{
    ViewData["Title"] = "Edit competition";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Competitions</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Code</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
        <h1>Edit competition <small class="text-muted">@Model.Code</small></h1>
    </div>
</div>
<partial name="_Alerts" />

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate class="form-sheet">
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
