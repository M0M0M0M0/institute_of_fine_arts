@model InstituteOfFineArts.Web.ViewModels.Staff.Competitions.CompetitionFormVm
@*
    Fields shared by the create and edit forms (SCR-24). When entries exist (BR-10) the title and start date are
    read-only (still posted, so the server can check they did not change).
*@
@{
    var locked = Model.HasSubmissions;
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

@if (locked)
{
    <div class="alert alert-warning">
        Students have already submitted entries. You can only extend the end date and change the description, rules and cover image.
    </div>
}

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" readonly="@locked" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" class="form-control" readonly="@locked" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <div class="form-text">Entries are accepted until 23:59:59 on this day.</div>
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Rules" class="form-label"></label>
    <textarea asp-for="Rules" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Rules" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CoverImage" class="form-label"></label>
    @if (Model.HasCover)
    {
        <div class="mb-2"><img src="/files/competitions/@Model.Id/cover" alt="Current cover" class="img-thumbnail" style="max-height:160px" /></div>
    }
    <input asp-for="CoverImage" type="file" accept=".jpg,.jpeg,image/jpeg" class="form-control" />
    <div class="form-text">Optional. JPEG only, up to 5 MB.</div>
    <span asp-validation-for="CoverImage" class="text-danger"></span>
    @if (Model.HasCover)
    {
        <div class="form-check mt-2">
            <input asp-for="RemoveCover" class="form-check-input" />
            <label asp-for="RemoveCover" class="form-check-label"></label>
        </div>
    }
</div>
