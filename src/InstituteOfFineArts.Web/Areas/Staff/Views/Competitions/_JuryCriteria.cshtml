@model InstituteOfFineArts.Web.ViewModels.Staff.Competitions.CompetitionFormVm
@*
    Jury and grading criteria of the competition create / edit form (TODO steps 4–5), saved with the competition.
    - Jury: tick the teachers who grade; one of them is the chair (radio). A judge who already graded cannot be unticked.
    - Criteria: one row per criterion of the library with its weight; the weights must add up to 100 % (the total is
      shown live by wwwroot/js/criteria-rows.js and checked again by CompetitionService). Locked once grading started.
    - Rows use the "Criteria[i]" index; the script renumbers them when a row is added or removed.
*@
@{
    string? Error(string key)
        => ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
    var selected = Model.JudgeIds.ToHashSet();
    var criteriaError = Error("Criteria");
    var juryError = Error("JudgeIds");
}

<fieldset class="mb-4" aria-describedby="jury-help">
    <legend class="form-label fw-semibold mb-1">Jury</legend>
    <p class="form-text mt-0 mb-2" id="jury-help">
        The teachers who grade the entries. Each judge grades every entry on their own; the result is the average of the jury.
        Only the jury sees the entries, and only after the deadline.
    </p>
    @if (Model.JudgeOptions.Count == 0)
    {
        <p class="text-muted">There is no active teacher account yet. Ask the administrator to create one.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle jury-table">
                <thead><tr><th scope="col">On the jury</th><th scope="col">Teacher</th><th scope="col">Chair</th></tr></thead>
                <tbody>
                    @foreach (var t in Model.JudgeOptions)
                    {
                        var on = selected.Contains(t.StaffId);
                        <tr>
                            <td>
                                <input class="form-check-input" type="checkbox" name="JudgeIds" value="@t.StaffId" id="judge-@t.StaffId" checked="@on"
                                       data-locked="@(t.HasGraded && on ? "true" : null)" onclick="@(t.HasGraded && on ? "return false;" : null)" />
                            </td>
                            <td>
                                <label for="judge-@t.StaffId">@t.Name</label>
                                @if (!string.IsNullOrWhiteSpace(t.Subjects))
                                {
                                    <span class="small text-muted d-block">@t.Subjects</span>
                                }
                                @if (t.HasGraded && on)
                                {
                                    <span class="small text-muted d-block"><i class="bi bi-lock" aria-hidden="true"></i> Has graded entries, stays on the jury</span>
                                }
                            </td>
                            <td><input class="form-check-input" type="radio" name="ChairId" value="@t.StaffId" aria-label="Chair: @t.Name" checked="@(Model.ChairId == t.StaffId)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (juryError != null)
    {
        <span class="text-danger small">@juryError</span>
    }
</fieldset>

<fieldset class="mb-4" data-criteria-rows aria-describedby="criteria-help">
    <legend class="form-label fw-semibold mb-1">Grading criteria</legend>
    <p class="form-text mt-0 mb-2" id="criteria-help">
        Each judge scores every criterion from 0 to 100; the entry's score is the weighted total. The weights must add up to 100 %.
    </p>
    @if (Model.CriteriaLocked)
    {
        <div class="alert alert-info py-2"><i class="bi bi-lock me-1" aria-hidden="true"></i>Entries have already been graded, so the criteria and weights can no longer change.</div>
    }
    <div data-criteria-list>
        @for (var i = 0; i < Model.Criteria.Count; i++)
        {
            var row = Model.Criteria[i];
            <div class="criterion-row" data-criterion-row>
                <select class="form-select" name="Criteria[@i].CriterionId" aria-label="Criterion" disabled="@Model.CriteriaLocked">
                    <option value="0">Choose a criterion…</option>
                    @foreach (var c in Model.CriterionOptions)
                    {
                        <option value="@c.Id" selected="@(row.CriterionId == c.Id)" title="@c.Description">@c.Name@(c.Active ? "" : " (hidden)")</option>
                    }
                </select>
                <div class="input-group">
                    <input class="form-control" name="Criteria[@i].Weight" value="@row.Weight?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                           type="number" min="0.01" max="100" step="0.01" aria-label="Weight in percent" data-criterion-weight readonly="@Model.CriteriaLocked" />
                    <span class="input-group-text">%</span>
                </div>
                @if (!Model.CriteriaLocked)
                {
                    <button type="button" class="btn btn-sm btn-link text-danger" data-criterion-remove aria-label="Remove this criterion"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                }
                @if (Model.CriteriaLocked)
                {
                    @* Disabled selects are not posted: send the values as hidden fields *@
                    <input type="hidden" name="Criteria[@i].CriterionId" value="@row.CriterionId" />
                }
                @foreach (var field in new[] { "CriterionId", "Weight" })
                {
                    if (Error($"Criteria[{i}].{field}") is { } e)
                    {
                        <span class="text-danger small criterion-error">@e</span>
                    }
                }
            </div>
        }
    </div>
    <div class="d-flex flex-wrap align-items-center gap-3 mt-1">
        @if (!Model.CriteriaLocked)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" data-criterion-add><i class="bi bi-plus-lg" aria-hidden="true"></i>Add criterion</button>
        }
        <span class="small">Total: <strong data-criteria-total class="num">0</strong> %</span>
    </div>
    @if (criteriaError != null)
    {
        <span class="text-danger small d-block mt-1">@criteriaError</span>
    }

    <template data-criterion-template>
        <div class="criterion-row" data-criterion-row>
            <select class="form-select" name="Criteria[__i__].CriterionId" aria-label="Criterion">
                <option value="0">Choose a criterion…</option>
                @foreach (var c in Model.CriterionOptions.Where(c => c.Active))
                {
                    <option value="@c.Id" title="@c.Description">@c.Name</option>
                }
            </select>
            <div class="input-group">
                <input class="form-control" name="Criteria[__i__].Weight" type="number" min="0.01" max="100" step="0.01" aria-label="Weight in percent" data-criterion-weight />
                <span class="input-group-text">%</span>
            </div>
            <button type="button" class="btn btn-sm btn-link text-danger" data-criterion-remove aria-label="Remove this criterion"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    </template>
</fieldset>
