@model InstituteOfFineArts.Web.ViewModels.Staff.Customers.CustomerFormVm
@*
    Staff – edit customer (/staff/customers/{id}/edit, SCR-32).
    Created by BE2-10; styled by FE2-07 (page head, form sheet).
*@
@{
    ViewData["Title"] = "Edit customer";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Customers</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@(string.IsNullOrWhiteSpace(Model.FullName) ? "Customer" : Model.FullName)</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
        <h1>Edit customer</h1>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate class="form-sheet">
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
