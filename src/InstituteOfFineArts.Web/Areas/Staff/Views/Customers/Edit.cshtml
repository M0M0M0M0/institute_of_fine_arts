@model InstituteOfFineArts.Web.ViewModels.Staff.Customers.CustomerFormVm
@*
    Staff – edit customer (/staff/customers/{id}/edit, SCR-32).
    Minimal version created by BE2-10; FE2 builds the real design in FE2-07.
*@
@{
    ViewData["Title"] = "Edit customer";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">Edit customer</h1>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
