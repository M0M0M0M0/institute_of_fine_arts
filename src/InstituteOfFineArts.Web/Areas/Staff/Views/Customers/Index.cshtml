@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Staff.Customers.CustomerListItemVm>
@*
    Staff – customer list & search (/staff/customers, SCR-32).
    Created by BE2-10; styled by FE2-07 (page head, filter band, ledger table, pager).
*@
@{
    ViewData["Title"] = "Customers";
    var search = (InstituteOfFineArts.Web.ViewModels.Staff.Customers.CustomerSearchVm)ViewBag.Search;
    // Keeps the filter when moving between pages
    object PageRoute(int page) => new { search.Keyword, page };
}

<div class="page-head">
    <div>
        <h1>Customers</h1>
        <p class="page-sub">The people who buy the students' paintings at exhibitions.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i>New customer</a>
    </div>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Index" class="filters" role="search">
    <div class="filter is-wide">
        <label class="form-label" for="Keyword">Name, phone or email</label>
        <input class="form-control" id="Keyword" name="Keyword" value="@search.Keyword" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        @if (!string.IsNullOrEmpty(search.Keyword))
        {
            <a asp-action="Index" class="btn btn-link">Clear</a>
        }
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-person-vcard" aria-hidden="true"></i>
        <p>No customers found.</p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i>New customer</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th scope="col">Full name</th><th scope="col">Phone</th><th scope="col">Email</th><th scope="col" class="text-end">Purchases</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td class="row-title"><a asp-action="Details" asp-route-id="@c.Id">@c.FullName</a></td>
                        <td class="num">@(c.Phone ?? "–")</td>
                        <td>@(c.Email ?? "–")</td>
                        <td class="text-end">@c.PurchaseCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount customer(s), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next<i class="bi bi-chevron-right ms-1" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}
