@model InstituteOfFineArts.Web.ViewModels.Staff.Evaluations.EvaluationPageVm
@*
    Staff – evaluate a submission (/staff/evaluations/{submissionId}, SCR-27, F-M07-03..05, F-M07-08): entry summary,
    current evaluation and the form (create / edit), or the read-only evaluation with the reason.
    Minimal version created by BE1 (BE1-10); FE1 builds the real design in FE1-06.
*@
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = $"Evaluate – {Model.Title}";
    // A late entry only offers DISQUALIFIED (BR-14); otherwise the six ratings
    var ratings = Model.AllowedRatings.Select(r => new SelectListItem(r.ToString(), r.ToString()));
}

<partial name="_Alerts" />

<div class="mb-3">
    <h1 class="h3 mb-1">Evaluate entry</h1>
    <div class="text-muted">
        @Model.CompetitionTitle · @Model.CompetitionCode ·
        <partial name="~/Areas/Staff/Views/Competitions/_Status.cshtml" model="Model.CompetitionStatus" />
    </div>
</div>

@* BR-14: an entry received after the deadline can only be disqualified *@
@if (Model.IsLate)
{
    <div class="alert alert-warning">
        <strong>Late entry.</strong> This entry was submitted after the deadline (@Model.EndDate.ToString("dd MMM yyyy"), 23:59:59),
        so it can only be rated DISQUALIFIED.
    </div>
}

@if (Model.ReadOnlyReason != null)
{
    <div class="alert alert-info">@Model.ReadOnlyReason</div>
}

<div class="row g-4">
    @* Entry summary (F-M07-02); the full details stay on the submission page *@
    <div class="col-lg-5">
        <img src="/files/submissions/@Model.SubmissionId/thumb" alt="@Model.Title" class="img-fluid rounded border mb-3" />
        <dl class="row mb-2">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>
            <dt class="col-sm-4">Student</dt>
            <dd class="col-sm-8">@Model.StudentName (@Model.StudentCode)</dd>
            <dt class="col-sm-4">Submitted at</dt>
            <dd class="col-sm-8">
                @Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")
                @if (Model.IsLate)
                {
                    <span class="badge bg-danger">Late</span>
                }
            </dd>
            <dt class="col-sm-4">Text (@Model.TextType)</dt>
            <dd class="col-sm-8" style="white-space: pre-line">@Model.TextContent</dd>
            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8" style="white-space: pre-line">@Model.Description</dd>
        </dl>
        <a href="/staff/submissions/@Model.SubmissionId" class="btn btn-sm btn-outline-secondary">Submission details</a>
        <a href="/staff/submissions?competitionId=@Model.CompetitionId" class="btn btn-sm btn-link">Back to entries</a>
    </div>

    <div class="col-lg-7">
        <h2 class="h5">Evaluation</h2>
        @if (Model.HasEvaluation)
        {
            <p class="text-muted small">
                Last evaluated by @Model.EvaluatedByName, @Model.EvaluatedAt?.ToString("dd MMM yyyy HH:mm")
            </p>
        }

        @if (Model.CanEvaluate)
        {
            @* Create the first time, edit afterwards (BR-22); BR-23 is checked again on the server *@
            <form asp-action="Index" asp-route-submissionId="@Model.SubmissionId" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Form.Rating" class="form-label"></label>
                    <select asp-for="Form.Rating" asp-items="ratings" class="form-select">
                        @if (!Model.IsLate)
                        {
                            <option value="">– Select a rating –</option>
                        }
                    </select>
                    <span asp-validation-for="Form.Rating" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.PositivePoints" class="form-label"></label>
                    <textarea asp-for="Form.PositivePoints" class="form-control" rows="3" maxlength="2000"></textarea>
                    <div class="form-text">Required unless the entry is disqualified.</div>
                    <span asp-validation-for="Form.PositivePoints" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.NegativePoints" class="form-label"></label>
                    <textarea asp-for="Form.NegativePoints" class="form-control" rows="3" maxlength="2000"></textarea>
                    <div class="form-text">For DISQUALIFIED, write the reason here (required).</div>
                    <span asp-validation-for="Form.NegativePoints" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.ImprovementAreas" class="form-label"></label>
                    <textarea asp-for="Form.ImprovementAreas" class="form-control" rows="3" maxlength="2000"></textarea>
                    <span asp-validation-for="Form.ImprovementAreas" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">@(Model.HasEvaluation ? "Save changes" : "Save evaluation")</button>
            </form>
        }
        else if (Model.HasEvaluation)
        {
            @* Read only (GRADED): comments are encoded by Razor, line breaks kept *@
            <dl class="row">
                <dt class="col-sm-4">Rating</dt>
                <dd class="col-sm-8"><span class="badge bg-dark">@Model.Form.Rating</span></dd>
                <dt class="col-sm-4">Positive points</dt>
                <dd class="col-sm-8" style="white-space: pre-line">@(Model.Form.PositivePoints ?? "–")</dd>
                <dt class="col-sm-4">Negative points</dt>
                <dd class="col-sm-8" style="white-space: pre-line">@(Model.Form.NegativePoints ?? "–")</dd>
                <dt class="col-sm-4">Improvement areas</dt>
                <dd class="col-sm-8" style="white-space: pre-line">@(Model.Form.ImprovementAreas ?? "–")</dd>
            </dl>
        }
        else
        {
            <p class="text-muted">Not evaluated yet.</p>
        }

        @if (Model.CanDelete)
        {
            @* POST with anti-forgery token; the browser asks for confirmation first *@
            <form asp-action="Delete" asp-route-submissionId="@Model.SubmissionId" method="post" class="mt-3"
                  onsubmit="return confirm('Delete this evaluation?');">
                <button type="submit" class="btn btn-outline-danger btn-sm">Delete evaluation</button>
            </form>
        }
        else if (Model.HasEvaluation && Model.DeleteBlockedReason != null && Model.CompetitionStatus != CompetitionStatus.GRADED)
        {
            <p class="form-text mt-3">@Model.DeleteBlockedReason</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
