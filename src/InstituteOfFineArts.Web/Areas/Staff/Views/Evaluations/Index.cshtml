@model InstituteOfFineArts.Web.ViewModels.Staff.Evaluations.EvaluationPageVm
@*
    Staff – evaluate a submission (/staff/evaluations/{submissionId}, SCR-27, F-M07-03..05, F-M07-08): entry summary,
    current evaluation and the form (create / edit), or the read-only evaluation with the reason.
    Created by BE1 (BE1-10); styled by FE1-06: the painting large on its stone mat with the wall label and text,
    the evaluation form beside it, the rating as a pill radio group (same name Form.Rating and values as the old select).
*@
@using InstituteOfFineArts.Web.ViewModels.Staff.Evaluations
@{
    ViewData["Title"] = $"Evaluate – {Model.Title}";
    // A late entry only offers DISQUALIFIED (BR-14); otherwise the six ratings
    var ratings = Model.AllowedRatings;
    // The old select pre-selected the only option of a late entry; the radio group does the same
    Rating? selected = Model.Form.Rating ?? (Model.IsLate && ratings.Count == 1 ? ratings[0] : null);
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/staff/submissions?competitionId=@Model.CompetitionId">Submissions</a></li>
                <li class="breadcrumb-item"><a href="/staff/submissions/@Model.SubmissionId">@Model.Title</a></li>
                <li class="breadcrumb-item active" aria-current="page">Evaluate</li>
            </ol>
        </nav>
        <h1>Evaluate entry</h1>
        <p class="page-sub d-flex flex-wrap align-items-center gap-2">
            <span>@Model.CompetitionTitle, @Model.CompetitionCode</span>
            <partial name="~/Areas/Staff/Views/Competitions/_Status.cshtml" model="Model.CompetitionStatus" />
        </p>
    </div>
    <div class="page-actions">
        <a href="/staff/submissions/@Model.SubmissionId" class="btn btn-outline-primary"><i class="bi bi-file-earmark-image" aria-hidden="true"></i>Submission details</a>
        <a href="/staff/submissions?competitionId=@Model.CompetitionId" class="btn btn-link">Back to entries</a>
    </div>
</div>
<partial name="_Alerts" />

@* BR-14: an entry received after the deadline can only be disqualified *@
@if (Model.IsLate)
{
    <div class="alert alert-danger late-warning" role="alert">
        <i class="bi bi-clock-history" aria-hidden="true"></i>
        <div>
            <strong>Late entry.</strong> This entry was submitted after the deadline (@Model.EndDate.ToString("dd MMM yyyy"), 23:59:59),
            so it can only be rated DISQUALIFIED.
        </div>
    </div>
}

@if (Model.ReadOnlyReason != null)
{
    <div class="alert alert-info"><i class="bi bi-lock" aria-hidden="true"></i><div>@Model.ReadOnlyReason</div></div>
}

<div class="artwork-stage grading-stage">
    @* Entry summary (F-M07-02); the full details stay on the submission page *@
    <figure class="artwork m-0">
        <div class="artwork-frame"><img src="/files/submissions/@Model.SubmissionId" alt="@Model.Title – @Model.StudentName" /></div>
        <figcaption class="wall-label wall-label-long">
            <span class="wl-title">@Model.Title</span>
            <span class="wl-artist">@Model.StudentName (@Model.StudentCode)</span>
            <span class="wl-meta">@Model.CompetitionTitle</span>
            <span class="wl-meta num">Submitted at @Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")</span>
            @if (Model.IsLate)
            {
                <span class="wl-state"><span class="tag tag-DISQUALIFIED tag-plain"><i class="bi bi-clock-history" aria-hidden="true"></i>Late</span></span>
            }
        </figcaption>

        @* .artwork-text keeps the line breaks (pre-line); Razor encodes the text *@
        <div class="mt-4">
            <h2 class="h3">Text (@Model.TextType)</h2>
            <p class="artwork-text">@Model.TextContent</p>
            <h2 class="h3">Description</h2>
            <p style="white-space: pre-line">@Model.Description</p>
        </div>
    </figure>

    <div class="grading-panel">
        <div class="section-head"><h2>Evaluation</h2></div>
        @if (Model.HasEvaluation)
        {
            <p class="text-muted small">
                Last evaluated by @Model.EvaluatedByName, @Model.EvaluatedAt?.ToString("dd MMM yyyy HH:mm")
            </p>
        }

        @if (Model.CanEvaluate)
        {
            @* Create the first time, edit afterwards (BR-22); BR-23 is checked again on the server *@
            <form asp-action="Index" asp-route-submissionId="@Model.SubmissionId" method="post" novalidate class="form-sheet">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <fieldset class="mb-4">
                    <legend class="form-label">@Html.DisplayNameFor(m => m.Form.Rating)</legend>
                    <div class="rating-pills">
                        @foreach (var r in ratings)
                        {
                            <input type="radio" name="Form.Rating" id="Form_Rating_@r" value="@r" checked="@(selected == r)"
                                   data-val="true" data-val-required="@EvaluationFormVm.RatingRequiredMessage" />
                            <label for="Form_Rating_@r" class="rating-@r">
                                @if (r == Rating.BEST)
                                {
                                    <i class="bi bi-award" aria-hidden="true"></i>
                                }
                                @r
                            </label>
                        }
                    </div>
                    <span asp-validation-for="Form.Rating" class="text-danger"></span>
                </fieldset>

                <div class="mb-3">
                    <label asp-for="Form.PositivePoints" class="form-label"></label>
                    <textarea asp-for="Form.PositivePoints" class="form-control" rows="4" maxlength="2000"></textarea>
                    <div class="form-text">Required unless the entry is disqualified.</div>
                    <span asp-validation-for="Form.PositivePoints" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.NegativePoints" class="form-label"></label>
                    <textarea asp-for="Form.NegativePoints" class="form-control" rows="4" maxlength="2000"></textarea>
                    <div class="form-text">For DISQUALIFIED, write the reason here (required).</div>
                    <span asp-validation-for="Form.NegativePoints" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.ImprovementAreas" class="form-label"></label>
                    <textarea asp-for="Form.ImprovementAreas" class="form-control" rows="4" maxlength="2000"></textarea>
                    <span asp-validation-for="Form.ImprovementAreas" class="text-danger"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check2" aria-hidden="true"></i>@(Model.HasEvaluation ? "Save changes" : "Save evaluation")</button>
                </div>
            </form>
        }
        else if (Model.HasEvaluation)
        {
            @* Read only (GRADED): comments are encoded by Razor, line breaks kept *@
            <dl class="details">
                <dt>Rating</dt>
                <dd><span class="tag tag-@Model.Form.Rating">@Model.Form.Rating</span></dd>
                <dt>Positive points</dt>
                <dd style="white-space: pre-line">@(Model.Form.PositivePoints ?? "–")</dd>
                <dt>Negative points</dt>
                <dd style="white-space: pre-line">@(Model.Form.NegativePoints ?? "–")</dd>
                <dt>Improvement areas</dt>
                <dd style="white-space: pre-line">@(Model.Form.ImprovementAreas ?? "–")</dd>
            </dl>
        }
        else
        {
            <p class="text-muted">Not evaluated yet.</p>
        }

        @if (Model.CanDelete)
        {
            @* POST with anti-forgery token; a confirmation dialog asks first *@
            <form asp-action="Delete" asp-route-submissionId="@Model.SubmissionId" method="post" class="mt-3"
                  data-confirm="Delete this evaluation?" data-confirm-ok="Delete">
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash" aria-hidden="true"></i>Delete evaluation</button>
            </form>
        }
        else if (Model.HasEvaluation && Model.DeleteBlockedReason != null && Model.CompetitionStatus != CompetitionStatus.GRADED)
        {
            <p class="form-text mt-3">@Model.DeleteBlockedReason</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
