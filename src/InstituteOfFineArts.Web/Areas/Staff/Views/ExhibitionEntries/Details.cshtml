@model InstituteOfFineArts.Web.ViewModels.Staff.ExhibitionEntries.EntryDetailsVm
@*
    Staff – exhibition entry details and actions (/staff/exhibition-entries/{id}, SCR-30, SCR-31; F-M09-05, 06, 08):
    accept / reject (PENDING), sold (ACCEPTED, or UNSOLD entered late) / unsold (ACCEPTED), paid to student (SOLD), delete (before the exhibition starts).
    Only the actions allowed in the current state are shown; the server checks every rule again (state diagram §4.7c).
    Created by BE1 (BE1-12, BE1-13); styled by FE1-08 / FE1-09: artwork stage with the painting left, the state ladder
    and only the forms valid for the current state right, each state change confirmed (data-confirm).
*@
@{
    ViewData["Title"] = $"Entry – {Model.Title}";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Exhibition entries</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-route-exhibitionId="@Model.ExhibitionId">@Model.ExhibitionName</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <h1>@Model.Title</h1>
        <p class="page-sub"><partial name="_Status" model="Model.Status" /> <span class="ms-1">@Model.StudentName (@Model.StudentCode), @Model.ExhibitionName</span></p>
    </div>
    @if (Model.CanDelete)
    {
        <div class="page-actions">
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this entry?" data-confirm-ok="Delete">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i>Delete</button>
            </form>
        </div>
    }
</div>

<partial name="_Alerts" />

<div class="artwork-stage">
    <partial name="~/Views/Shared/Exhibitions/_EntryPainting.cshtml" model="Model" />

    <div>
        <partial name="~/Views/Shared/Exhibitions/_EntryFacts.cshtml" model="Model" />

        @* PENDING: accept (before the exhibition starts, BR-42) or reject with a reason *@
        @if (Model.CanAccept || Model.CanReject)
        {
            <section class="entry-action" aria-labelledby="review-heading">
                <h2 id="review-heading">Review the proposal</h2>
                @if (Model.CanAccept)
                {
                    <form asp-action="Accept" asp-route-id="@Model.Id" method="post" class="mb-3"
                          data-confirm="Accept this painting for the exhibition?" data-confirm-ok="Accept" data-confirm-tone="neutral">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i>Accept</button>
                    </form>
                }
                else
                {
                    <p class="small text-muted">The exhibition has started, so this proposal can only be rejected.</p>
                }
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" novalidate
                      data-confirm="Reject this proposal?" data-confirm-ok="Reject">
                    <label asp-for="RejectForm.Reason" class="form-label"></label>
                    <textarea asp-for="RejectForm.Reason" class="form-control mb-1" rows="2"></textarea>
                    <span asp-validation-for="RejectForm.Reason" class="text-danger d-block"></span>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-lg" aria-hidden="true"></i>Reject</button>
                    </div>
                </form>
            </section>
        }

        @* ACCEPTED (or UNSOLD entered late, after the status job): record the sale (BR-44) *@
        @if (Model.CanSell)
        {
            <section class="entry-action" aria-labelledby="sale-heading">
                <h2 id="sale-heading">Record the sale</h2>
                <form asp-action="Sold" asp-route-id="@Model.Id" method="post" novalidate
                      data-confirm="Mark this painting as sold?" data-confirm-ok="Mark as sold" data-confirm-tone="neutral">
                    <div class="row">
                        <div class="col-sm-6 mb-2">
                            <label asp-for="SoldForm.SoldPrice" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="SoldForm.SoldPrice" type="number" min="0.01" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="SoldForm.SoldPrice" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label asp-for="SoldForm.SoldDate" class="form-label"></label>
                            <input asp-for="SoldForm.SoldDate" type="date" min="@Model.StartDate.ToString("yyyy-MM-dd")"
                                   max="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
                            <span asp-validation-for="SoldForm.SoldDate" class="text-danger"></span>
                        </div>
                        <div class="col-12 mb-2">
                            <label asp-for="SoldForm.CustomerId" class="form-label"></label>
                            <select asp-for="SoldForm.CustomerId" class="form-select">
                                <option value="">Choose a customer…</option>
                                @foreach (var c in Model.Customers)
                                {
                                    <option value="@c.Id">@c.FullName @(c.Phone ?? c.Email)</option>
                                }
                            </select>
                            <span asp-validation-for="SoldForm.CustomerId" class="text-danger"></span>
                            <div class="form-text"><a href="/staff/customers/new"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>New customer</a></div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-bag-check" aria-hidden="true"></i>Mark as sold</button>
                    </div>
                </form>
            </section>
        }

        @* ACCEPTED after the exhibition: unsold (the nightly status job does the same) *@
        @if (Model.CanMarkUnsold)
        {
            <section class="entry-action" aria-labelledby="unsold-heading">
                <h2 id="unsold-heading">Not sold</h2>
                <form asp-action="Unsold" asp-route-id="@Model.Id" method="post"
                      data-confirm="Mark this painting as unsold?" data-confirm-ok="Mark as unsold" data-confirm-tone="neutral">
                    <button type="submit" class="btn btn-outline-primary">Mark as unsold</button>
                </form>
            </section>
        }

        @* SOLD and not paid: record the payment of the whole sale price (BR-45) *@
        @if (Model.CanPay)
        {
            <section class="entry-action" aria-labelledby="pay-heading">
                <h2 id="pay-heading">Pay the student</h2>
                <form asp-action="Paid" asp-route-id="@Model.Id" method="post" novalidate
                      data-confirm="Record the payment to the student?" data-confirm-ok="Record payment" data-confirm-tone="neutral">
                    <div class="row">
                        <div class="col-sm-6 mb-2">
                            <label asp-for="PaidForm.PaidAmount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PaidForm.PaidAmount" type="number" min="0.01" step="0.01" class="form-control" aria-describedby="paid-hint" />
                            </div>
                            <div class="form-text" id="paid-hint">The whole sale price goes to the student (no commission).</div>
                            <span asp-validation-for="PaidForm.PaidAmount" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label asp-for="PaidForm.PaidDate" class="form-label"></label>
                            <input asp-for="PaidForm.PaidDate" type="date" min="@Model.SoldDate?.ToString("yyyy-MM-dd")" class="form-control" />
                            <span asp-validation-for="PaidForm.PaidDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-cash-coin" aria-hidden="true"></i>Record payment</button>
                    </div>
                </form>
            </section>
        }
    </div>
</div>

<p class="mt-4"><a asp-action="Index" asp-route-exhibitionId="@Model.ExhibitionId" class="btn btn-link px-0"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to the entries</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
