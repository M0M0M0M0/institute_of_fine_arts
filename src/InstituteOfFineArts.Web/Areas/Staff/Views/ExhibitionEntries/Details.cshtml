@model InstituteOfFineArts.Web.ViewModels.Staff.ExhibitionEntries.EntryDetailsVm
@*
    Staff – exhibition entry details and actions (/staff/exhibition-entries/{id}, SCR-30, SCR-31; F-M09-05, 06, 08):
    accept / reject (PENDING), sold / unsold (ACCEPTED), paid to student (SOLD), delete (before the exhibition starts).
    Only the actions allowed in the current state are shown; the server checks every rule again (state diagram §4.7c).
    Minimal version created by BE1 (BE1-12, BE1-13); FE1 builds the real design in FE1-08 / FE1-09.
*@
@{
    ViewData["Title"] = $"Entry – {Model.Title}";
}

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Title</h1>
        <div class="text-muted">
            @Model.StudentName (@Model.StudentCode) · @Model.ExhibitionName · <partial name="_Status" model="Model.Status" />
        </div>
    </div>
    @if (Model.CanDelete)
    {
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this entry?');">
            <button type="submit" class="btn btn-outline-danger">Delete</button>
        </form>
    }
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <img src="/files/submissions/@Model.SubmissionId/thumb" alt="@Model.Title" class="img-fluid rounded border mb-2" />
        <div class="small">
            <a href="/staff/submissions/@Model.SubmissionId">Submission details</a> · @Model.CompetitionTitle
            @if (Model.Rating is { } rating)
            {
                <span>· @rating</span>
            }
        </div>
    </div>
    <div class="col-lg-8">
        <dl class="row">
            <dt class="col-sm-4">Exhibition</dt>
            <dd class="col-sm-8">
                <a asp-action="Index" asp-route-exhibitionId="@Model.ExhibitionId">@Model.ExhibitionName</a>, @Model.City
                <div class="small text-muted">@Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy") (@Model.ExhibitionStatus)</div>
            </dd>
            <dt class="col-sm-4">Asking price</dt>
            <dd class="col-sm-8">@Model.AskingPrice.ToString("$#,##0.00")</dd>
            <dt class="col-sm-4">Created</dt>
            <dd class="col-sm-8">
                @Model.CreatedAt.ToString("dd MMM yyyy HH:mm") by @Model.ProposedByName
                <span class="small text-muted">(@(Model.ProposedByRole == Role.STUDENT ? "student proposal" : "sent by staff"))</span>
            </dd>
            @if (Model.Notes != null)
            {
                <dt class="col-sm-4">Notes</dt>
                <dd class="col-sm-8" style="white-space: pre-line">@Model.Notes</dd>
            }
            @if (Model.ReviewedByName != null)
            {
                <dt class="col-sm-4">Reviewed by</dt>
                <dd class="col-sm-8">@Model.ReviewedByName</dd>
            }
            @if (Model.RejectReason != null)
            {
                <dt class="col-sm-4">Reason for rejecting</dt>
                <dd class="col-sm-8" style="white-space: pre-line">@Model.RejectReason</dd>
            }
            @if (Model.Status == EntryStatus.SOLD)
            {
                <dt class="col-sm-4">Sold</dt>
                <dd class="col-sm-8">@Model.SoldPrice?.ToString("$#,##0.00") on @Model.SoldDate?.ToString("dd MMM yyyy")</dd>
                <dt class="col-sm-4">Customer</dt>
                <dd class="col-sm-8">
                    @Model.CustomerName
                    <div class="small text-muted">@Model.CustomerPhone @Model.CustomerEmail</div>
                </dd>
                <dt class="col-sm-4">Paid to student</dt>
                <dd class="col-sm-8">
                    @if (Model.PaidToStudent)
                    {
                        <span class="badge bg-success">Paid</span>
                        <span>@Model.PaidAmount?.ToString("$#,##0.00") on @Model.PaidDate?.ToString("dd MMM yyyy")</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Not paid to student</span>
                    }
                </dd>
            }
        </dl>

        @* PENDING: accept (before the exhibition starts, BR-42) or reject with a reason *@
        @if (Model.CanAccept || Model.CanReject)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">Review the proposal</h2>
                    @if (Model.CanAccept)
                    {
                        <form asp-action="Accept" asp-route-id="@Model.Id" method="post" class="mb-3">
                            <button type="submit" class="btn btn-success">Accept</button>
                        </form>
                    }
                    else
                    {
                        <p class="small text-muted">The exhibition has started, so this proposal can only be rejected.</p>
                    }
                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post" novalidate>
                        <label asp-for="RejectForm.Reason" class="form-label"></label>
                        <textarea asp-for="RejectForm.Reason" class="form-control mb-1" rows="2"></textarea>
                        <span asp-validation-for="RejectForm.Reason" class="text-danger d-block mb-2"></span>
                        <button type="submit" class="btn btn-outline-danger">Reject</button>
                    </form>
                </div>
            </div>
        }

        @* ACCEPTED: record the sale (BR-44) *@
        @if (Model.CanSell)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">Record the sale</h2>
                    <form asp-action="Sold" asp-route-id="@Model.Id" method="post" novalidate>
                        <div class="row">
                            <div class="col-md-4 mb-2">
                                <label asp-for="SoldForm.SoldPrice" class="form-label"></label>
                                <input asp-for="SoldForm.SoldPrice" type="number" min="0.01" step="0.01" class="form-control" />
                                <span asp-validation-for="SoldForm.SoldPrice" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-2">
                                <label asp-for="SoldForm.SoldDate" class="form-label"></label>
                                <input asp-for="SoldForm.SoldDate" type="date" min="@Model.StartDate.ToString("yyyy-MM-dd")"
                                       max="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
                                <span asp-validation-for="SoldForm.SoldDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-2">
                                <label asp-for="SoldForm.CustomerId" class="form-label"></label>
                                <select asp-for="SoldForm.CustomerId" class="form-select">
                                    <option value="">Choose a customer…</option>
                                    @foreach (var c in Model.Customers)
                                    {
                                        <option value="@c.Id">@c.FullName @(c.Phone ?? c.Email)</option>
                                    }
                                </select>
                                <span asp-validation-for="SoldForm.CustomerId" class="text-danger"></span>
                                <div class="form-text"><a href="/staff/customers/new">New customer</a></div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success">Mark as sold</button>
                    </form>
                </div>
            </div>
        }

        @* ACCEPTED after the exhibition: unsold (the nightly status job does the same) *@
        @if (Model.CanMarkUnsold)
        {
            <form asp-action="Unsold" asp-route-id="@Model.Id" method="post" class="mb-3" onsubmit="return confirm('Mark this painting as unsold?');">
                <button type="submit" class="btn btn-outline-secondary">Mark as unsold</button>
            </form>
        }

        @* SOLD and not paid: record the payment of the whole sale price (BR-45) *@
        @if (Model.CanPay)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">Pay the student</h2>
                    <form asp-action="Paid" asp-route-id="@Model.Id" method="post" novalidate>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label asp-for="PaidForm.PaidAmount" class="form-label"></label>
                                <input asp-for="PaidForm.PaidAmount" type="number" min="0.01" step="0.01" class="form-control" />
                                <div class="form-text">The whole sale price goes to the student (no commission).</div>
                                <span asp-validation-for="PaidForm.PaidAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label asp-for="PaidForm.PaidDate" class="form-label"></label>
                                <input asp-for="PaidForm.PaidDate" type="date" min="@Model.SoldDate?.ToString("yyyy-MM-dd")" class="form-control" />
                                <span asp-validation-for="PaidForm.PaidDate" class="text-danger"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success">Record payment</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<a asp-action="Index" asp-route-exhibitionId="@Model.ExhibitionId" class="btn btn-link px-0">Back to the entries</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
