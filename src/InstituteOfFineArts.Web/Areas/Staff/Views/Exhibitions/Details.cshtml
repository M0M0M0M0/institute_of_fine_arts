@model InstituteOfFineArts.Web.ViewModels.Staff.Exhibitions.ExhibitionDetailsVm
@*
    Staff – exhibition details (/staff/exhibitions/{id}, SCR-29): information, status, artworks by status.
    The markup is shared with the other area (Views/Shared/Exhibitions/_ExhibitionDetails.cshtml).
    Created by BE2-09; styled by FE2-07.
*@
@{
    ViewData["Title"] = Model.Name;
    // Staff only: link to the artworks of this exhibition (page built by BE1-12)
    ViewData["ArtworksUrl"] = $"/staff/exhibition-entries?exhibitionId={Model.Id}";
}

<partial name="~/Views/Shared/Exhibitions/_ExhibitionDetails.cshtml" model="Model" />

@* History of this object (audit log): who did what and when *@
@if (ViewBag.History is InstituteOfFineArts.Web.ViewModels.Admin.AuditLog.HistoryVm history)
{
    <partial name="_History" model="history" />
}
