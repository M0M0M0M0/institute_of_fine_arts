@model InstituteOfFineArts.Web.ViewModels.Staff.Submissions.StudentHistoryVm
@*
    Staff – study history of one student (/staff/students/{studentId}/history, SCR-22; F-M07-07): every entry with
    rating, comments, award and exhibition entries.
    Minimal version created by BE2 (BE2-07); FE2 builds the real design in FE2-05.
*@
@{
    ViewData["Title"] = $"History – {Model.FullName}";
}

<div class="mb-3">
    <h1 class="h3 mb-1">Study history: @Model.FullName</h1>
    <div class="text-muted">
        @Model.StudentCode · @Model.CourseName @Model.ClassName ·
        @Model.Entries.Count entry(ies), @Model.EvaluatedCount evaluated, @Model.AwardCount award(s)
    </div>
</div>

@if (Model.Entries.Count == 0)
{
    <p class="text-muted">This student has not submitted any entries yet.</p>
}

@foreach (var s in Model.Entries)
{
    <div class="card mb-3" id="entry-@s.Id">
        <div class="card-body">
            <div class="d-flex gap-3">
                <img src="/files/submissions/@s.Id/thumb" alt="Thumbnail of @s.Title" width="96" height="96" class="rounded" style="object-fit: cover" />
                <div class="flex-grow-1">
                    <h2 class="h5 mb-1"><a asp-controller="Submissions" asp-action="Details" asp-route-id="@s.Id">@s.Title</a></h2>
                    <div class="text-muted small mb-2">
                        <a asp-controller="Competitions" asp-action="Details" asp-route-id="@s.CompetitionId">@s.CompetitionTitle</a>
                        · <partial name="~/Areas/Staff/Views/Competitions/_Status.cshtml" model="s.CompetitionStatus" />
                        · submitted @s.SubmittedAt.ToString("dd MMM yyyy HH:mm")
                        @if (s.IsLate)
                        {
                            <span class="badge bg-danger">Late entry</span>
                        }
                    </div>

                    @if (s.Evaluation is { } e)
                    {
                        <p class="mb-1"><span class="badge bg-primary">@e.Rating</span> <span class="text-muted small">by @e.EvaluatorName, @e.EvaluatedAt.ToString("dd MMM yyyy")</span></p>
                        @* Comments keep their line breaks; Razor encodes the text *@
                        <dl class="row small mb-1">
                            <dt class="col-sm-3">Positive points</dt>
                            <dd class="col-sm-9" style="white-space: pre-line">@(e.PositivePoints ?? "–")</dd>
                            <dt class="col-sm-3">Negative points</dt>
                            <dd class="col-sm-9" style="white-space: pre-line">@(e.NegativePoints ?? "–")</dd>
                            <dt class="col-sm-3">Improvement areas</dt>
                            <dd class="col-sm-9" style="white-space: pre-line">@(e.ImprovementAreas ?? "–")</dd>
                        </dl>
                    }
                    else
                    {
                        <p class="text-muted mb-1">Not evaluated</p>
                    }

                    @if (s.Award is { } a)
                    {
                        <p class="mb-1">Award: <strong>@a.AwardName</strong> (@a.PrizeValue.ToString("$#,##0.00"), @a.IssuedDate.ToString("dd MMM yyyy"))</p>
                    }

                    @if (s.ExhibitionEntries.Count > 0)
                    {
                        <partial name="_ExhibitionEntries" model="s.ExhibitionEntries" />
                    }
                </div>
            </div>
        </div>
    </div>
}

<a asp-controller="Students" asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-link px-0">Back to student</a>
