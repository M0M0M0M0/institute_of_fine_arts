    Reuses the search form and table partials of the Admin area.
    Created by BE2-03; styled by FE2-03 (page head, filters bar, ledger table).
*@
@{
    ViewData["Title"] = "Students";
}

<div class="page-head">
    <div>
        <h1>Students</h1>
        <p class="page-sub">Students of the institute with course, class and study status.</p>
    </div>
</div>

<partial name="_Alerts" />
<partial name="~/Areas/Admin/Views/Students/_SearchForm.cshtml" model="(InstituteOfFineArts.Web.ViewModels.Admin.Students.StudentSearchVm)ViewBag.Search" />
<partial name="~/Areas/Admin/Views/Students/_List.cshtml" model="Model" />
