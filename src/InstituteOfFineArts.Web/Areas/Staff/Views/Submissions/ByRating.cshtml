@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Staff.Submissions.SubmissionListItemVm>
@*
    Staff – search entries by rating (/staff/submissions/by-rating?rating=BEST&competitionId=, SCR-26; F-M07-06):
    entries of CLOSED or GRADED competitions, used to pick paintings for exhibitions.
    Created by BE2 (BE2-07); styled by FE2-05 as a wall of paintings with museum wall labels.
*@
@using InstituteOfFineArts.Web.ViewModels.Staff.Submissions
@{
    ViewData["Title"] = "Search by rating";
    var search = (RatingSearchVm)ViewBag.Search;
    var competitions = (IReadOnlyList<CompetitionOptionVm>)ViewBag.Competitions;
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new { search.Rating, search.CompetitionId, page };
}

<div class="page-head">
    <div>
        <h1>Search by rating</h1>
        <p class="page-sub">Entries of closed or graded competitions with the chosen rating, e.g. to pick paintings for an exhibition.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-list-ul" aria-hidden="true"></i>All submissions</a>
    </div>
</div>
<partial name="_Alerts" />

<form method="get" asp-action="ByRating" class="filters" role="search">
    <div class="filter">
        <label class="form-label" for="Rating">Rating</label>
        <select class="form-select" id="Rating" name="Rating">
            @foreach (var r in Enum.GetValues<Rating>())
            {
                <option value="@r" selected="@(search.Rating == r)">@r</option>
            }
        </select>
    </div>
    <div class="filter filter-wide">
        <label class="form-label" for="CompetitionId">Competition</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">All closed / graded competitions</option>
            @foreach (var c in competitions)
            {
                <option value="@c.Id" selected="@(search.CompetitionId == c.Id)">@c.Code – @c.Title</option>
            }
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-images" aria-hidden="true"></i>
        <p>No entries with rating @search.Rating found.</p>
    </div>
}
else
{
    <div class="art-grid">
        @foreach (var s in Model.Items)
        {
            var awarded = s.Rating == Rating.BEST || s.AwardName != null;
            <figure class="artwork @(awarded ? "is-awarded" : "")">
                <a class="artwork-frame" asp-controller="Submissions" asp-action="Details" asp-route-id="@s.Id">
                    <img src="/files/submissions/@s.Id/thumb" alt="@s.Title – @s.StudentName" loading="lazy" />
                </a>
                <figcaption class="wall-label">
                    <span class="wl-title"><a asp-controller="Submissions" asp-action="Details" asp-route-id="@s.Id">@s.Title</a></span>
                    <span class="wl-artist">@s.StudentName <span class="text-muted">@s.StudentCode</span></span>
                    <span class="wl-meta"><a asp-controller="Competitions" asp-action="Details" asp-route-id="@s.CompetitionId">@s.CompetitionTitle</a>, @s.SubmittedAt.ToString("dd MMM yyyy")</span>
                    <span class="wl-state">
                        @if (s.Rating is { } rating)
                        {
                            <span class="tag tag-@rating">@rating</span>
                        }
                        @if (s.AwardName != null)
                        {
                            <span class="tag tag-award"><i class="bi bi-award-fill" aria-hidden="true"></i>@s.AwardName</span>
                        }
                        @if (s.IsLate)
                        {
                            <span class="tag tag-DISQUALIFIED tag-plain"><i class="bi bi-clock-history" aria-hidden="true"></i>Late entry</span>
                        }
                    </span>
                </figcaption>
            </figure>
        }
    </div>

    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount entry(ies), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("ByRating", PageRoute(Model.Page - 1))">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("ByRating", PageRoute(Model.Page + 1))">Next</a>
            }
        </div>
    </nav>
}
