@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Staff.Submissions.SubmissionListItemVm>
@*
    Staff – submission list & filters (/staff/submissions, SCR-26; F-M07-01, F-M07-09).
    Created by BE2 (BE2-06); styled by FE2-04: filters bar, grading progress of the chosen competition, ledger with thumbnails.
*@
@using InstituteOfFineArts.Web.ViewModels.Staff.Submissions
@{
    ViewData["Title"] = "Submissions";
    var search = (SubmissionSearchVm)ViewBag.Search;
    var competitions = (IReadOnlyList<CompetitionOptionVm>)ViewBag.Competitions;
    var progress = (EvaluationProgressVm?)ViewBag.Progress;
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new
    {
        search.CompetitionId, search.Evaluated, search.Rating, search.Student,
        From = search.From?.ToString("yyyy-MM-dd"), To = search.To?.ToString("yyyy-MM-dd"), page,
    };
    var filtered = search.CompetitionId != null || search.Evaluated != null || search.Rating != null
        || !string.IsNullOrEmpty(search.Student) || search.From != null || search.To != null;
}

<div class="page-head">
    <div>
        <h1>Submissions</h1>
        <p class="page-sub">Entries of every competition; choose a competition to follow its grading.</p>
    </div>
    <div class="page-actions">
        <a asp-action="ByRating" class="btn btn-outline-primary"><i class="bi bi-funnel" aria-hidden="true"></i>Search by rating</a>
    </div>
</div>
<partial name="_Alerts" />

<form method="get" asp-action="Index" class="filters" role="search">
    <div class="filter filter-wide">
        <label class="form-label" for="CompetitionId">Competition</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">All competitions</option>
            @foreach (var c in competitions)
            {
                <option value="@c.Id" selected="@(search.CompetitionId == c.Id)">@c.Code – @c.Title</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Evaluated">Evaluation</label>
        <select class="form-select" id="Evaluated" name="Evaluated">
            <option value="">All</option>
            <option value="true" selected="@(search.Evaluated == true)">Evaluated</option>
            <option value="false" selected="@(search.Evaluated == false)">Not evaluated</option>
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Rating">Rating</label>
        <select class="form-select" id="Rating" name="Rating">
            <option value="">All</option>
            @foreach (var r in Enum.GetValues<Rating>())
            {
                <option value="@r" selected="@(search.Rating == r)">@r</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Student">Student name or code</label>
        <input class="form-control" id="Student" name="Student" value="@search.Student" />
    </div>
    <div class="filter">
        <label class="form-label" for="From">From</label>
        <input class="form-control" type="date" id="From" name="From" value="@search.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="To">To</label>
        <input class="form-control" type="date" id="To" name="To" value="@search.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-link">Clear</a>
        }
    </div>
</form>

@* Evaluation progress of the chosen competition (F-M07-09) *@
@if (progress != null)
{
    var percent = progress.Total == 0 ? 0 : (int)Math.Round(100.0 * progress.Evaluated / progress.Total);
    <div class="grading-progress grading-strip" id="evaluation-progress">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="d-flex flex-wrap align-items-center gap-2">
                <a asp-controller="Competitions" asp-action="Details" asp-route-id="@progress.CompetitionId" class="fw-medium">@progress.CompetitionTitle</a>
                <partial name="~/Areas/Staff/Views/Competitions/_Status.cshtml" model="progress.Status" />
            </span>
            <strong class="num">Evaluated @progress.Evaluated / total @progress.Total</strong>
        </div>
        <div class="progress" role="progressbar" aria-label="Grading progress" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: @percent%"></div>
        </div>
    </div>
}

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-images" aria-hidden="true"></i>
        <p>No submissions found.</p>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-outline-primary">Clear the filters</a>
        }
    </div>
}
else
{
    <partial name="_Table" model="Model.Items" />

    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount submission(s), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page - 1))">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next</a>
            }
        </div>
    </nav>
}
