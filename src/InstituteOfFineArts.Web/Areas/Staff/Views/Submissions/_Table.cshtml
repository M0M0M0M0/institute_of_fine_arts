@model IReadOnlyList<InstituteOfFineArts.Web.ViewModels.Staff.Submissions.SubmissionListItemVm>
@*
    Staff – ledger of submissions (/staff/submissions): thumbnail, entry, student, competition, date, rating, award.
    Created by BE2 (BE2-06); styled by FE2-04.
*@

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th><span class="visually-hidden">Image</span></th><th>Title</th><th>Student</th><th>Competition</th><th>Submitted</th><th>Rating</th><th>Award</th></tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="Submissions" asp-action="Details" asp-route-id="@s.Id" class="artwork-frame thumb-frame" tabindex="-1" aria-hidden="true">
                            <img src="/files/submissions/@s.Id/thumb" alt="Thumbnail of @s.Title" width="56" height="56" class="table-thumb" loading="lazy" />
                        </a>
                    </td>
                    <td class="row-title"><a asp-controller="Submissions" asp-action="Details" asp-route-id="@s.Id">@s.Title</a></td>
                    <td><a asp-controller="Students" asp-action="Details" asp-route-id="@s.StudentId">@s.StudentName</a> <span class="text-muted small">@s.StudentCode</span></td>
                    <td><a asp-controller="Competitions" asp-action="Details" asp-route-id="@s.CompetitionId">@s.CompetitionTitle</a></td>
                    <td class="num">
                        <span class="text-nowrap">@s.SubmittedAt.ToString("dd MMM yyyy HH:mm")</span>
                        @if (s.IsLate)
                        {
                            <span class="tag tag-DISQUALIFIED tag-plain"><i class="bi bi-clock-history" aria-hidden="true"></i>Late entry</span>
                        }
                    </td>
                    <td>
                        @if (s.Rating is { } rating)
                        {
                            <span class="tag tag-@rating">@rating</span>
                        }
                        else
                        {
                            <span class="tag tag-NOT_GRADED">Not evaluated</span>
                        }
                    </td>
                    <td>
                        @if (s.AwardName != null)
                        {
                            <span class="tag tag-award"><i class="bi bi-award-fill" aria-hidden="true"></i>@s.AwardName</span>
                        }
                        else
                        {
                            <span class="text-muted">–</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
