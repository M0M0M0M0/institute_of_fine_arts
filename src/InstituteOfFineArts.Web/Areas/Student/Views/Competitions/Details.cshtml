@model InstituteOfFineArts.Web.ViewModels.Student.Competitions.StudentCompetitionDetailsVm
@*
    Student – competition details (/student/competitions/{id}, SCR-42, F-M05-09): description, rules, awards,
    deadline (with countdown while open), own entry and the "Submit an entry" link (ONGOING and not submitted yet).
    Created by BE1 (BE1-06); styled by FE1-04.
*@
@using System.Globalization
@using InstituteOfFineArts.Web.Helpers
@{
    ViewData["Title"] = Model.Title;
    var deadlineIso = CompetitionStatusResolver.SubmissionDeadline(Model.EndDate).ToString("yyyy-MM-dd'T'HH:mm:ss", CultureInfo.InvariantCulture);
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Competitions</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Code</li>
            </ol>
        </nav>
        <h1>@Model.Title</h1>
        <p class="page-sub d-flex flex-wrap align-items-center gap-2"><span>@Model.Code</span> <partial name="_Status" model="Model.Status" /></p>
    </div>
</div>

<partial name="_Alerts" />

<div class="artwork-stage">
    <div>
        @if (Model.HasCover)
        {
            <div class="artwork-frame">
                <img src="/files/competitions/@Model.Id/cover" alt="Cover of @Model.Title" />
            </div>
        }

        @* white-space: pre-line keeps the line breaks typed by staff; Razor still encodes the text (no HTML/XSS) *@
        <section class="section" aria-labelledby="description-title">
            <div class="section-head"><h2 id="description-title">Description</h2></div>
            <p style="white-space: pre-line">@(Model.Description ?? "–")</p>
        </section>

        <section class="section" aria-labelledby="rules-title">
            <div class="section-head"><h2 id="rules-title">Rules &amp; conditions</h2></div>
            <p style="white-space: pre-line">@(Model.Rules ?? "–")</p>
        </section>
    </div>

    <aside aria-labelledby="entry-title">
        <h2 id="entry-title" class="h3 mt-0">Your entry</h2>
        <dl class="details">
            <dt>Start date</dt>
            <dd>@Model.StartDate.ToString("dd MMM yyyy")</dd>
            <dt>Submission deadline</dt>
            <dd>
                @Model.EndDate.ToString("dd MMM yyyy"), 23:59:59
                @if (Model.Status == CompetitionStatus.ONGOING)
                {
                    <div class="deadline" data-deadline="@deadlineIso"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span data-countdown-text></span></div>
                }
            </dd>
        </dl>

        @* The student's own entry, or what they can do now *@
        @if (Model.MySubmission is { } mine)
        {
            <p>
                <strong>You have already submitted an entry:</strong>
                <a href="/student/submissions/@mine.Id">“@mine.Title”</a>, @mine.SubmittedAt.ToString("dd MMM yyyy HH:mm").
            </p>
            <a href="/student/submissions/@mine.Id" class="btn btn-outline-primary"><i class="bi bi-image" aria-hidden="true"></i>Open my entry</a>
        }
        else if (Model.CanSubmit)
        {
            <p>You have not submitted an entry yet.</p>
            <a href="/student/submissions/new?competitionId=@Model.Id" class="btn btn-primary"><i class="bi bi-upload" aria-hidden="true"></i>Submit an entry</a>
        }
        else if (Model.Status == CompetitionStatus.UPCOMING)
        {
            <p class="text-muted">Entries open on @Model.StartDate.ToString("dd MMM yyyy").</p>
        }
        else
        {
            <p class="text-muted">This competition is closed for entries.</p>
        }
    </aside>
</div>

<section class="section" aria-labelledby="awards-title">
    <div class="section-head"><h2 id="awards-title">Awards</h2></div>
    @if (Model.Awards.Count == 0)
    {
        <p class="text-muted">Awards will be announced soon.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th class="text-end">Rank</th><th>Award</th><th class="text-end">Prize</th><th class="text-end">Quantity</th><th>Description</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.Awards)
                    {
                        <tr>
                            <td class="text-end">@a.Rank</td>
                            <td class="row-title">@a.Name</td>
                            <td class="text-end">@a.PrizeValue.ToString("$#,##0.00")</td>
                            <td class="text-end">@a.Quantity</td>
                            <td>@a.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<a asp-action="Index" class="btn btn-link px-0"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to competitions</a>

@section Scripts {
    <script src="~/js/countdown.js" asp-append-version="true"></script>
}
