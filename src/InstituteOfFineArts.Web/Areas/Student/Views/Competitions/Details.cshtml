@model InstituteOfFineArts.Web.ViewModels.Student.Competitions.StudentCompetitionDetailsVm
@*
    Student – competition details (/student/competitions/{id}, SCR-42, F-M05-09): description, rules, awards,
    deadline, own entry and the "Submit an entry" link (ONGOING and not submitted yet).
    Minimal version created by BE1 (BE1-06); FE1 builds the real design in FE1-04.
*@
@{
    ViewData["Title"] = Model.Title;
}

<partial name="_Alerts" />

<div class="mb-3">
    <h1 class="h3 mb-1">@Model.Title</h1>
    <div class="text-muted">@Model.Code · <partial name="_Status" model="Model.Status" /></div>
</div>

@if (Model.HasCover)
{
    <img src="/files/competitions/@Model.Id/cover" alt="Cover of @Model.Title" class="img-fluid rounded mb-3" style="max-height:280px" />
}

<dl class="row">
    <dt class="col-sm-3">Start date</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Submission deadline</dt>
    <dd class="col-sm-9">@Model.EndDate.ToString("dd MMM yyyy"), 23:59:59</dd>
</dl>

@* The student's own entry, or what they can do now *@
<div class="card mb-4">
    <div class="card-body">
        @if (Model.MySubmission is { } mine)
        {
            <p class="mb-0">
                <strong>You have already submitted an entry:</strong> “@mine.Title”, @mine.SubmittedAt.ToString("dd MMM yyyy HH:mm").
            </p>
        }
        else if (Model.CanSubmit)
        {
            <p>You have not submitted an entry yet.</p>
            <a href="/student/submissions/new?competitionId=@Model.Id" class="btn btn-primary">Submit an entry</a>
        }
        else if (Model.Status == CompetitionStatus.UPCOMING)
        {
            <p class="mb-0 text-muted">Entries open on @Model.StartDate.ToString("dd MMM yyyy").</p>
        }
        else
        {
            <p class="mb-0 text-muted">This competition is closed for entries.</p>
        }
    </div>
</div>

@* white-space: pre-line keeps the line breaks typed by staff; Razor still encodes the text (no HTML/XSS) *@
<h2 class="h5">Description</h2>
<p style="white-space: pre-line">@(Model.Description ?? "–")</p>

<h2 class="h5">Rules &amp; conditions</h2>
<p style="white-space: pre-line">@(Model.Rules ?? "–")</p>

<h2 class="h5">Awards</h2>
@if (Model.Awards.Count == 0)
{
    <p class="text-muted">Awards will be announced soon.</p>
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Rank</th><th>Award</th><th class="text-end">Prize</th><th class="text-end">Quantity</th><th>Description</th></tr></thead>
        <tbody>
            @foreach (var a in Model.Awards)
            {
                <tr>
                    <td>@a.Rank</td>
                    <td>@a.Name</td>
                    <td class="text-end">@a.PrizeValue.ToString("$#,##0.00")</td>
                    <td class="text-end">@a.Quantity</td>
                    <td>@a.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-link px-0">Back to competitions</a>
