@model InstituteOfFineArts.Web.Models.Enums.CompetitionStatus
@*
    Status tag of a competition as shown to students (tag-UPCOMING / ONGOING / CLOSED / GRADED from site.css).
    Created by BE1 (BE1-06); styled by FE1-04.
*@
@{
    var text = Model switch
    {
        CompetitionStatus.UPCOMING => "Upcoming",
        CompetitionStatus.ONGOING => "Open for entries",
        CompetitionStatus.CLOSED => "Closed",
        _ => "Results published",
    };
}
<span class="tag tag-@Model">@text</span>
