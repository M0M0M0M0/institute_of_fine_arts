@using InstituteOfFineArts.Web.Infrastructure.Security
@*
    Temporary home page of the Student area (/student).
    Created by BE1 to test the login flow; FE builds the real page
    (remove the Layout line below once the area has its own _ViewStart).
*@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Student";
}

<h1 class="h3">Welcome, @User.GetFullName()</h1>
<p>You are on the home page of the <strong>Student</strong> area (role STUDENT).</p>

<p><a href="/profile">My profile</a> · <a href="/profile/change-password">Change password</a></p>

@* Log out with POST plus the anti-forgery token *@
<form method="post" action="/logout">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-secondary">Log out</button>
</form>
