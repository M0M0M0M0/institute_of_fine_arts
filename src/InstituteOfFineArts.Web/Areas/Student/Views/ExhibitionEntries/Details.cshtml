@model InstituteOfFineArts.Web.ViewModels.Student.ExhibitionEntries.MyEntryDetailsVm
@*
    Student – details of an own exhibition entry (/student/exhibition-entries/{id}, SCR-49, F-M09-10, US-13 AC5):
    painting, exhibition, asking price, status, reject reason, sale and payment; change price / withdraw while PENDING (BR-46).
    Created by BE1 (BE1-12); styled by FE1-08: the painting on the stage, its label and ledgers on the right.
*@
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">My artworks on show</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <h1><em>@Model.Title</em></h1>
        <p class="page-sub d-flex flex-wrap align-items-center gap-2"><span>@Model.ExhibitionName</span> <partial name="_Status" model="Model.Status" /></p>
    </div>
    @* Change price / withdraw only while PENDING; the server checks this again (BR-46) *@
    @if (Model.CanChange)
    {
        <div class="page-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-currency-dollar" aria-hidden="true"></i>Change price</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0"
                  data-confirm="Withdraw this proposal?" data-confirm-ok="Withdraw" data-confirm-title="Withdraw proposal">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-lg" aria-hidden="true"></i>Withdraw</button>
            </form>
        </div>
    }
</div>

<partial name="_Alerts" />

<div class="artwork-stage">
    <figure class="artwork m-0">
        <div class="artwork-frame">
            <img src="/files/submissions/@Model.SubmissionId" alt="@Model.Title – @User.GetFullName()" />
        </div>
        <figcaption class="wall-label">
            <span class="wl-title">@Model.Title</span>
            <span class="wl-meta"><a href="/student/submissions/@Model.SubmissionId">@Model.CompetitionTitle</a></span>
            @if (Model.Rating is { } rating)
            {
                <span class="wl-state"><span class="tag tag-@rating">@rating</span></span>
            }
        </figcaption>
    </figure>

    <div>
        <h2 class="h3 mt-0">Exhibition</h2>
        <dl class="details">
            <dt>Name</dt>
            <dd><a href="/student/exhibitions/@Model.ExhibitionId">@Model.ExhibitionName</a></dd>
            <dt>Venue</dt>
            <dd>@Model.Venue, @Model.City</dd>
            <dt>Dates</dt>
            <dd class="num">@Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy") (@Model.ExhibitionStatus)</dd>
        </dl>

        <h2 class="h3">Entry</h2>
        <dl class="details">
            <dt>Asking price</dt>
            <dd class="num">@Model.AskingPrice.ToString("$#,##0.00")</dd>
            <dt>Status</dt>
            <dd><partial name="_Status" model="Model.Status" /></dd>
            <dt>Sent</dt>
            <dd>
                @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")
                @if (Model.CreatedByStaff)
                {
                    <span class="small text-muted">(sent by staff with the price you quoted)</span>
                }
            </dd>
            @if (Model.RejectReason != null)
            {
                <dt>Reason for rejection</dt>
                <dd style="white-space: pre-line">@Model.RejectReason</dd>
            }
        </dl>

        <h2 class="h3">Sale and payment</h2>
        <dl class="details">
            <dt>Sold?</dt>
            <dd>@(Model.Status == EntryStatus.SOLD ? "Sold" : "Not sold")</dd>
            @if (Model.Status == EntryStatus.SOLD)
            {
                <dt>Customer paid</dt>
                <dd class="num">@Model.SoldPrice?.ToString("$#,##0.00")</dd>
                <dt>Sale date</dt>
                <dd>@Model.SoldDate?.ToString("dd MMM yyyy")</dd>
                <dt>Paid to me</dt>
                <dd class="d-flex flex-wrap align-items-center gap-2">
                    @if (Model.PaidToStudent)
                    {
                        <span class="tag tag-PAID">Paid</span>
                        <span class="num">@Model.PaidAmount?.ToString("$#,##0.00") on @Model.PaidDate?.ToString("dd MMM yyyy")</span>
                    }
                    else
                    {
                        <span class="tag tag-UNPAID">Not paid yet</span>
                    }
                </dd>
            }
        </dl>
    </div>
</div>

<a asp-action="Index" class="btn btn-link px-0 mt-3"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to my exhibition entries</a>
