@model InstituteOfFineArts.Web.ViewModels.Student.ExhibitionEntries.EditPriceFormVm
@*
    Student – change the asking price of a pending proposal (/student/exhibition-entries/{id}/edit, SCR-49, BR-41, BR-46).
    Created by BE1 (BE1-12); styled by FE1-08.
*@
@{
    ViewData["Title"] = "Change asking price";
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">My artworks on show</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></li>
                <li class="breadcrumb-item active" aria-current="page">Change price</li>
            </ol>
        </nav>
        <h1>Change asking price</h1>
        <p class="page-sub"><em>@Model.Title</em>, @Model.ExhibitionName</p>
    </div>
</div>

<partial name="_Alerts" />

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate class="form-sheet">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-4">
        <label asp-for="AskingPrice" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="AskingPrice" type="number" min="0.01" step="0.01" class="form-control" inputmode="decimal" />
            <span class="input-group-text">USD</span>
        </div>
        <span asp-validation-for="AskingPrice" class="text-danger"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>Save</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
