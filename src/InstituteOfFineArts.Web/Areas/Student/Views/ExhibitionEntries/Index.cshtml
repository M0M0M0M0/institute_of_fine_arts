@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Student.ExhibitionEntries.MyEntryListItemVm>
@*
    Student – my exhibition entries (/student/exhibition-entries, SCR-49, F-M09-10, US-13 AC5): painting, exhibition,
    asking price, status, sold?, price paid by the customer, paid to me? + date; filters status / exhibition, paging.
    Created by BE1 (BE1-12); styled by FE1-08: each painting hangs with a wall label carrying its sale state.
*@
@using InstituteOfFineArts.Web.ViewModels.Student.ExhibitionEntries
@{
    ViewData["Title"] = "My exhibition entries";
    var search = (MyEntrySearchVm)ViewBag.Search;
    var exhibitions = (List<MyExhibitionOptionVm>)ViewBag.Exhibitions;
    var me = User.GetFullName();
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new { search.Status, search.ExhibitionId, page };
}

<div class="page-head">
    <div>
        <h1>My exhibition entries</h1>
        <p class="page-sub">Your paintings sent to exhibitions: asking price, status, sale and payment.</p>
    </div>
    <div class="page-actions">
        <a href="/student/exhibitions" class="btn btn-primary"><i class="bi bi-bank" aria-hidden="true"></i>Upcoming exhibitions</a>
    </div>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Index" class="filters">
    <div class="filter">
        <label class="form-label" for="ExhibitionId">Exhibition</label>
        <select class="form-select" id="ExhibitionId" name="ExhibitionId">
            <option value="">All</option>
            @foreach (var x in exhibitions)
            {
                <option value="@x.Id" selected="@(search.ExhibitionId == x.Id)">@x.Name</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Status">Status</label>
        <select class="form-select" id="Status" name="Status">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<EntryStatus>())
            {
                <option value="@s" selected="@(search.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        <a href="/student/exhibition-entries" class="btn btn-link">Clear</a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-easel2" aria-hidden="true"></i>
        <p>No exhibition entries found. Open an upcoming exhibition and choose "Propose an artwork".</p>
        <a href="/student/exhibitions" class="btn btn-outline-primary">Upcoming exhibitions</a>
    </div>
}
else
{
    <div class="art-grid">
        @foreach (var e in Model.Items)
        {
            <figure class="artwork">
                <a class="artwork-frame" asp-action="Details" asp-route-id="@e.Id" tabindex="-1" aria-hidden="true">
                    @if (e.HasThumbnail)
                    {
                        <img src="/files/submissions/@e.SubmissionId/thumb" alt="@e.Title – @me" loading="lazy" />
                    }
                    else
                    {
                        <span class="artwork-missing">Image not available</span>
                    }
                </a>
                <figcaption class="wall-label">
                    <span class="wl-title"><a asp-action="Details" asp-route-id="@e.Id">@e.Title</a></span>
                    <span class="wl-meta">@e.ExhibitionName</span>
                    <span class="wl-meta num">@e.StartDate.ToString("dd MMM yyyy") – @e.EndDate.ToString("dd MMM yyyy")</span>
                    <span class="wl-artist num">Asking price @e.AskingPrice.ToString("$#,##0.00")</span>
                    <span class="wl-state">
                        <partial name="_Status" model="e.Status" />
                        @if (e.PaidToStudent)
                        {
                            <span class="tag tag-PAID">Paid</span>
                            <span class="small">@e.PaidDate?.ToString("dd MMM yyyy")</span>
                        }
                        else if (e.Status == EntryStatus.SOLD)
                        {
                            <span class="tag tag-UNPAID">Not paid yet</span>
                        }
                    </span>
                    <span class="wl-note num">
                        @if (e.Status == EntryStatus.SOLD)
                        {
                            <span>Sold, customer paid @(e.SoldPrice?.ToString("$#,##0.00") ?? "–")</span>
                        }
                        else
                        {
                            <span class="text-muted">Not sold</span>
                        }
                    </span>
                </figcaption>
            </figure>
        }
    </div>

    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount entr@(Model.TotalCount == 1 ? "y" : "ies"), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next<i class="bi bi-chevron-right ms-1 me-0" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}
