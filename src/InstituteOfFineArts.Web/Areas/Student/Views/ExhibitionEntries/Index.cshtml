@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Student.ExhibitionEntries.MyEntryListItemVm>
@*
    Student – my exhibition entries (/student/exhibition-entries, SCR-49, F-M09-10, US-13 AC5): painting, exhibition,
    asking price, status, sold?, price paid by the customer, paid to me? + date; filters status / exhibition, paging.
    Minimal version created by BE1 (BE1-12); FE1 builds the real design in FE1-08.
*@
@using InstituteOfFineArts.Web.ViewModels.Student.ExhibitionEntries
@{
    ViewData["Title"] = "My exhibition entries";
    var search = (MyEntrySearchVm)ViewBag.Search;
    var exhibitions = (List<MyExhibitionOptionVm>)ViewBag.Exhibitions;
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new { search.Status, search.ExhibitionId, page };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My exhibition entries</h1>
    <a href="/student/exhibitions" class="btn btn-primary">Upcoming exhibitions</a>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="ExhibitionId">Exhibition</label>
        <select class="form-select" id="ExhibitionId" name="ExhibitionId">
            <option value="">All</option>
            @foreach (var x in exhibitions)
            {
                <option value="@x.Id" selected="@(search.ExhibitionId == x.Id)">@x.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="Status">Status</label>
        <select class="form-select" id="Status" name="Status">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<EntryStatus>())
            {
                <option value="@s" selected="@(search.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <p class="text-muted">No exhibition entries found. Open an upcoming exhibition and choose "Propose an artwork".</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th></th><th>Painting</th><th>Exhibition</th><th class="text-end">Asking price</th><th>Status</th>
                <th>Sold?</th><th class="text-end">Customer paid</th><th>Paid to me</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Items)
            {
                <tr>
                    <td style="width:90px">
                        @if (e.HasThumbnail)
                        {
                            <img src="/files/submissions/@e.SubmissionId/thumb" alt="@e.Title" class="img-thumbnail" style="max-height:60px" />
                        }
                    </td>
                    <td><a asp-action="Details" asp-route-id="@e.Id">@e.Title</a></td>
                    <td>
                        @e.ExhibitionName
                        <div class="small text-muted">@e.StartDate.ToString("dd MMM yyyy") – @e.EndDate.ToString("dd MMM yyyy")</div>
                    </td>
                    <td class="text-end">@e.AskingPrice.ToString("$#,##0.00")</td>
                    <td><partial name="_Status" model="e.Status" /></td>
                    <td>@(e.Status == EntryStatus.SOLD ? "Sold" : "Not sold")</td>
                    <td class="text-end">@(e.SoldPrice?.ToString("$#,##0.00") ?? "–")</td>
                    <td>
                        @if (e.PaidToStudent)
                        {
                            <span class="badge bg-success">Paid</span>
                            <span class="small text-muted">@e.PaidDate?.ToString("dd MMM yyyy")</span>
                        }
                        else if (e.Status == EntryStatus.SOLD)
                        {
                            <span class="badge bg-warning text-dark">Not paid yet</span>
                        }
                        else
                        {
                            <span class="text-muted">–</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">@Model.TotalCount entr@(Model.TotalCount == 1 ? "y" : "ies") · page @Model.Page of @Model.TotalPages</span>
        <div>
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", PageRoute(Model.Page - 1))">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next</a>
            }
        </div>
    </nav>
}
