@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Student.Results.IssuedAwardItemVm>
@*
    Student – awards issued (/student/awards, SCR-47, F-M06-09, F-M08-04 pub, US-11 AC4, TC-M08-05): awards of
    GRADED competitions; search by competition, student name, award and issued date; paged.
    Created by BE2 (BE2-08); styled by FE2-06: gilt-framed winning paintings with wall labels (award, rank, prize, date).
*@
@{
    ViewData["Title"] = "Awards";
    var search = (InstituteOfFineArts.Web.ViewModels.Student.Results.IssuedAwardSearchVm)ViewBag.Search;
    var competitions = (List<InstituteOfFineArts.Web.ViewModels.Student.Results.GradedCompetitionOptionVm>)ViewBag.Competitions;
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new { search.CompetitionId, search.StudentName, search.Award, From = search.From?.ToString("yyyy-MM-dd"), To = search.To?.ToString("yyyy-MM-dd"), page };
}

<div class="page-head">
    <div>
        <h1>Awards</h1>
        <p class="page-sub">Every award given in competitions with published results.</p>
    </div>
    <div class="page-actions">
        <div class="seg" role="group" aria-label="Results">
            <a href="/student/results">My Results</a>
            <a href="/student/best">Best Works</a>
            <a href="/student/awards" aria-current="page">Awards</a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Awards" class="filters">
    <div class="filter">
        <label class="form-label" for="CompetitionId">Competition</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">All</option>
            @foreach (var c in competitions)
            {
                <option value="@c.Id" selected="@(search.CompetitionId == c.Id)">@c.Title</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="StudentName">Student</label>
        <input class="form-control" id="StudentName" name="StudentName" value="@search.StudentName" />
    </div>
    <div class="filter">
        <label class="form-label" for="Award">Award</label>
        <input class="form-control" id="Award" name="Award" value="@search.Award" />
    </div>
    <div class="filter">
        <label class="form-label" for="From">Issued from</label>
        <input class="form-control" type="date" id="From" name="From" value="@search.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="To">Issued to</label>
        <input class="form-control" type="date" id="To" name="To" value="@search.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        <a href="/student/awards" class="btn btn-link">Clear</a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-trophy" aria-hidden="true"></i>
        <p>No results found.</p>
        <a href="/student/awards" class="btn btn-outline-primary">Clear the search</a>
    </div>
}
else
{
    <div class="art-grid">
        @foreach (var a in Model.Items)
        {
            <figure class="artwork is-awarded">
                <div class="artwork-frame">
                    @if (a.HasThumbnail)
                    {
                        @* Public image: awarded entry of a GRADED competition (BR-20, SubmissionImagePolicy) *@
                        <img src="/files/submissions/@a.SubmissionId/thumb" alt="@a.ArtworkTitle – @a.StudentName" loading="lazy" />
                    }
                    else
                    {
                        <span class="artwork-missing">Image not available</span>
                    }
                </div>
                <figcaption class="wall-label">
                    <span class="wl-title">@a.ArtworkTitle</span>
                    <span class="wl-artist">@a.StudentName</span>
                    <span class="wl-meta">@a.CompetitionTitle</span>
                    <span class="wl-state">
                        <span class="tag tag-award"><i class="bi bi-trophy" aria-hidden="true"></i>@a.AwardName</span>
                        <span class="small">Rank @a.Rank</span>
                    </span>
                    <span class="wl-meta num">@a.PrizeValue.ToString("$#,##0.00"), issued @a.IssuedDate.ToString("dd MMM yyyy")</span>
                    @if (a.PrizeDescription != null)
                    {
                        <span class="wl-meta">@a.PrizeDescription</span>
                    }
                    @if (a.Remarks != null)
                    {
                        <span class="wl-note" style="white-space: pre-line">@a.Remarks</span>
                    }
                </figcaption>
            </figure>
        }
    </div>

    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount award@(Model.TotalCount == 1 ? "" : "s"), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Awards", PageRoute(Model.Page - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Awards", PageRoute(Model.Page + 1))">Next<i class="bi bi-chevron-right ms-1 me-0" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}
