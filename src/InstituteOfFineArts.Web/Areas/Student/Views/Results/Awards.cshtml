@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Student.Results.IssuedAwardItemVm>
@*
    Student – awards issued (/student/awards, SCR-47, F-M06-09, F-M08-04 pub, US-11 AC4, TC-M08-05): awards of
    GRADED competitions; search by competition, student name, award and issued date; paged.
    Minimal version created by BE2 (BE2-08); FE2 builds the real design in FE2-06.
*@
@{
    ViewData["Title"] = "Awards";
    var search = (InstituteOfFineArts.Web.ViewModels.Student.Results.IssuedAwardSearchVm)ViewBag.Search;
    var competitions = (List<InstituteOfFineArts.Web.ViewModels.Student.Results.GradedCompetitionOptionVm>)ViewBag.Competitions;
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new { search.CompetitionId, search.StudentName, search.Award, From = search.From?.ToString("yyyy-MM-dd"), To = search.To?.ToString("yyyy-MM-dd"), page };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Awards</h1>
    <a href="/student/results" class="btn btn-outline-secondary">My Results</a>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Awards" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label" for="CompetitionId">Competition</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">All</option>
            @foreach (var c in competitions)
            {
                <option value="@c.Id" selected="@(search.CompetitionId == c.Id)">@c.Title</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label" for="StudentName">Student</label>
        <input class="form-control" id="StudentName" name="StudentName" value="@search.StudentName" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="Award">Award</label>
        <input class="form-control" id="Award" name="Award" value="@search.Award" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="From">Issued from</label>
        <input class="form-control" type="date" id="From" name="From" value="@search.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="To">Issued to</label>
        <input class="form-control" type="date" id="To" name="To" value="@search.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <p class="text-muted">No results found.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th></th><th>Competition</th><th>Award</th><th>Rank</th><th class="text-end">Prize</th><th>Student</th><th>Artwork</th><th>Issued</th><th>Remarks</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Items)
            {
                <tr>
                    <td style="width:90px">
                        @if (a.HasThumbnail)
                        {
                            @* Public image: awarded entry of a GRADED competition (BR-20, SubmissionImagePolicy) *@
                            <img src="/files/submissions/@a.SubmissionId/thumb" alt="@a.ArtworkTitle" class="img-thumbnail" style="max-height:60px" />
                        }
                    </td>
                    <td>@a.CompetitionTitle</td>
                    <td>@a.AwardName</td>
                    <td>@a.Rank</td>
                    <td class="text-end">
                        @a.PrizeValue.ToString("$#,##0.00")
                        @if (a.PrizeDescription != null)
                        {
                            <div class="small text-muted">@a.PrizeDescription</div>
                        }
                    </td>
                    <td>@a.StudentName</td>
                    <td>@a.ArtworkTitle</td>
                    <td>@a.IssuedDate.ToString("dd MMM yyyy")</td>
                    <td class="small" style="white-space: pre-line">@(a.Remarks ?? "–")</td>
                </tr>
            }
        </tbody>
    </table>

    <nav class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">@Model.TotalCount award@(Model.TotalCount == 1 ? "" : "s") · page @Model.Page of @Model.TotalPages</span>
        <div>
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Awards", PageRoute(Model.Page - 1))">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Awards", PageRoute(Model.Page + 1))">Next</a>
            }
        </div>
    </nav>
}
