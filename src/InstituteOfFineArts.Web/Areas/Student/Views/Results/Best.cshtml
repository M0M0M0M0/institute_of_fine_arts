@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Student.Results.BestWorkItemVm>
@*
    Student – best works (/student/best, SCR-46, F-M06-08, US-10 AC4): BEST entries of every student in GRADED
    competitions with the staff comments; filter by competition, paged.
    Minimal version created by BE2 (BE2-08); FE2 builds the real design in FE2-06.
*@
@{
    ViewData["Title"] = "Best Works";
    var search = (InstituteOfFineArts.Web.ViewModels.Student.Results.BestWorkSearchVm)ViewBag.Search;
    var competitions = (List<InstituteOfFineArts.Web.ViewModels.Student.Results.GradedCompetitionOptionVm>)ViewBag.Competitions;
    // Keeps the filter when moving between pages
    object PageRoute(int page) => new { search.CompetitionId, page };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Best Works</h1>
    <a href="/student/results" class="btn btn-outline-secondary">My Results</a>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Best" class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
        <label class="form-label" for="CompetitionId">Competition</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">All</option>
            @foreach (var c in competitions)
            {
                <option value="@c.Id" selected="@(search.CompetitionId == c.Id)">@c.Title</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <p class="text-muted">No results found.</p>
}
else
{
    @foreach (var b in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-body d-flex gap-3">
                <div style="width:130px" class="flex-shrink-0">
                    @if (b.HasThumbnail)
                    {
                        @* Public image: BEST entry of a GRADED competition (BR-20, SubmissionImagePolicy) *@
                        <img src="/files/submissions/@b.Id/thumb" alt="@b.Title" class="img-thumbnail" style="max-height:120px" />
                    }
                </div>
                <div class="flex-grow-1">
                    <h2 class="h6 mb-1">
                        @b.Title
                        @if (b.AwardName != null)
                        {
                            <span class="badge bg-success ms-1">@b.AwardName</span>
                        }
                    </h2>
                    <div class="text-muted small mb-2">by @b.StudentName · @b.CompetitionTitle</div>
                    <dl class="row mb-0 small">
                        <dt class="col-sm-3">Strengths</dt>
                        <dd class="col-sm-9" style="white-space: pre-line">@(b.PositivePoints ?? "–")</dd>
                        <dt class="col-sm-3">Weaknesses</dt>
                        <dd class="col-sm-9" style="white-space: pre-line">@(b.NegativePoints ?? "–")</dd>
                        <dt class="col-sm-3">Areas of improvement</dt>
                        <dd class="col-sm-9 mb-0" style="white-space: pre-line">@(b.ImprovementAreas ?? "–")</dd>
                    </dl>
                </div>
            </div>
        </div>
    }

    <nav class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">@Model.TotalCount work@(Model.TotalCount == 1 ? "" : "s") · page @Model.Page of @Model.TotalPages</span>
        <div>
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Best", PageRoute(Model.Page - 1))">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Best", PageRoute(Model.Page + 1))">Next</a>
            }
        </div>
    </nav>
}
