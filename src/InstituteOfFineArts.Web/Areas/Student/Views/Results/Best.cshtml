@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Student.Results.BestWorkItemVm>
@*
    Student – best works (/student/best, SCR-46, F-M06-08, US-10 AC4): BEST entries of every student in GRADED
    competitions with the staff comments; filter by competition, paged.
    Created by BE2 (BE2-08); styled by FE2-06: a wall of gilt-framed paintings, the staff comments folded under each label.
*@
@{
    ViewData["Title"] = "Best Works";
    var search = (InstituteOfFineArts.Web.ViewModels.Student.Results.BestWorkSearchVm)ViewBag.Search;
    var competitions = (List<InstituteOfFineArts.Web.ViewModels.Student.Results.GradedCompetitionOptionVm>)ViewBag.Competitions;
    // Keeps the filter when moving between pages
    object PageRoute(int page) => new { search.CompetitionId, page };
}

<div class="page-head">
    <div>
        <h1>Best Works</h1>
        <p class="page-sub">Paintings rated BEST in competitions with published results, with what the staff said about them.</p>
    </div>
    <div class="page-actions">
        <div class="seg" role="group" aria-label="Results">
            <a href="/student/results">My Results</a>
            <a href="/student/best" aria-current="page">Best Works</a>
            <a href="/student/awards">Awards</a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Best" class="filters">
    <div class="filter">
        <label class="form-label" for="CompetitionId">Competition</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">All</option>
            @foreach (var c in competitions)
            {
                <option value="@c.Id" selected="@(search.CompetitionId == c.Id)">@c.Title</option>
            }
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        <a href="/student/best" class="btn btn-link">Clear</a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-stars" aria-hidden="true"></i>
        <p>No results found.</p>
        <a href="/student/best" class="btn btn-outline-primary">Show all competitions</a>
    </div>
}
else
{
    <div class="art-grid is-large">
        @foreach (var b in Model.Items)
        {
            <figure class="artwork is-awarded">
                <div class="artwork-frame">
                    @if (b.HasThumbnail)
                    {
                        @* Public image: BEST entry of a GRADED competition (BR-20, SubmissionImagePolicy) *@
                        <img src="/files/submissions/@b.Id/thumb" alt="@b.Title – @b.StudentName" loading="lazy" />
                    }
                    else
                    {
                        <span class="artwork-missing">Image not available</span>
                    }
                </div>
                <figcaption class="wall-label">
                    <span class="wl-title">@b.Title</span>
                    <span class="wl-artist">@b.StudentName</span>
                    <span class="wl-meta">@b.CompetitionTitle</span>
                    <span class="wl-state">
                        <span class="tag tag-BEST">BEST</span>
                        @if (b.AwardName != null)
                        {
                            <span class="tag tag-award"><i class="bi bi-trophy" aria-hidden="true"></i>@b.AwardName</span>
                        }
                    </span>
                    <details>
                        <summary>Staff comments</summary>
                        <dl>
                            <dt>Strengths</dt>
                            <dd>@(b.PositivePoints ?? "–")</dd>
                            <dt>Weaknesses</dt>
                            <dd>@(b.NegativePoints ?? "–")</dd>
                            <dt>Areas of improvement</dt>
                            <dd>@(b.ImprovementAreas ?? "–")</dd>
                        </dl>
                    </details>
                </figcaption>
            </figure>
        }
    </div>

    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount work@(Model.TotalCount == 1 ? "" : "s"), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Best", PageRoute(Model.Page - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Best", PageRoute(Model.Page + 1))">Next<i class="bi bi-chevron-right ms-1 me-0" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}
