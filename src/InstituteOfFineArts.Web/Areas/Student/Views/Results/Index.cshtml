@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Student.Results.MyResultItemVm>
@*
    Student – my results (/student/results, F-M06-07, US-10 AC2/AC3): every own entry with rating, strengths,
    weaknesses, areas of improvement and award once the competition is GRADED; "Awaiting results" before (BR-24).
    Created by BE2 (BE2-08); styled by FE2-06 as a ledger: one <tbody class="card mb-3"> per entry (the class is kept
    because the e2e script splits the page on it), the staff comments in a full-width second row.
*@
@using InstituteOfFineArts.Web.Services.Implementations
@{
    ViewData["Title"] = "My Results";
    var search = (InstituteOfFineArts.Web.ViewModels.Student.Results.MyResultSearchVm)ViewBag.Search;
    var competitions = (List<InstituteOfFineArts.Web.ViewModels.Student.Submissions.MyCompetitionOptionVm>)ViewBag.Competitions;
    var me = User.GetFullName();
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new { search.CompetitionId, search.Rating, page };
}

<div class="page-head">
    <div>
        <h1>My Results</h1>
        <p class="page-sub">Ratings, awards and the staff comments on your entries, once the results are published.</p>
    </div>
    <div class="page-actions">
        <div class="seg" role="group" aria-label="Results">
            <a href="/student/results" aria-current="page">My Results</a>
            <a href="/student/best">Best Works</a>
            <a href="/student/awards">Awards</a>
        </div>
    </div>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Index" class="filters">
    <div class="filter">
        <label class="form-label" for="CompetitionId">Competition</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">All</option>
            @foreach (var c in competitions)
            {
                <option value="@c.Id" selected="@(search.CompetitionId == c.Id)">@c.Title</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Rating">Rating</label>
        <select class="form-select" id="Rating" name="Rating">
            <option value="">All</option>
            @foreach (var r in Enum.GetValues<Rating>())
            {
                <option value="@r" selected="@(search.Rating == r)">@r</option>
            }
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        <a href="/student/results" class="btn btn-link">Clear</a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-clipboard-check" aria-hidden="true"></i>
        <p>No results found.</p>
        <a href="/student/submissions" class="btn btn-outline-primary">View my entries</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table result-ledger">
            <thead>
                <tr><th><span class="visually-hidden">Image</span></th><th>Entry</th><th>Competition</th><th>Rating</th><th>Award</th></tr>
            </thead>
            @foreach (var s in Model.Items)
            {
                <tbody class="card mb-3">
                    <tr>
                        <td>
                            @if (s.HasThumbnail)
                            {
                                <img src="/files/submissions/@s.Id/thumb" alt="@s.Title – @me" class="table-thumb" loading="lazy" />
                            }
                        </td>
                        <td>
                            <a class="row-title" href="/student/submissions/@s.Id">@s.Title</a>
                            <div class="small text-muted">Submitted @s.SubmittedAt.ToString("dd MMM yyyy HH:mm")</div>
                        </td>
                        <td>
                            @s.CompetitionTitle
                            <div class="mt-1"><partial name="~/Areas/Student/Views/Competitions/_Status.cshtml" model="s.CompetitionStatus" /></div>
                        </td>
                        @* BR-24: the evaluation is only shown once the results are published *@
                        @if (!s.IsPublished)
                        {
                            <td colspan="2"><span class="tag tag-PENDING">@StudentResultService.AwaitingResultsMessage</span></td>
                        }
                        else if (s.Rating is null)
                        {
                            <td colspan="2" class="text-muted">Results are published, but this entry has no evaluation.</td>
                        }
                        else
                        {
                            <td><span class="tag tag-@s.Rating"><strong class="visually-hidden">Rating:</strong> @s.Rating</span></td>
                            <td>
                                @if (s.AwardName != null)
                                {
                                    <span class="tag tag-award"><i class="bi bi-trophy" aria-hidden="true"></i>@s.AwardName</span>
                                    <div class="small text-muted">Rank @s.AwardRank, @s.PrizeValue?.ToString("$#,##0.00")</div>
                                }
                                else
                                {
                                    <span class="text-muted">–</span>
                                }
                            </td>
                        }
                    </tr>
                    @if (s.IsPublished && s.Rating is not null)
                    {
                        <tr class="result-comments">
                            <td></td>
                            <td colspan="4">
                                <dl class="details">
                                    <dt>Strengths</dt>
                                    <dd>@(s.PositivePoints ?? "–")</dd>
                                    <dt>Weaknesses</dt>
                                    <dd>@(s.NegativePoints ?? "–")</dd>
                                    <dt>Areas of improvement</dt>
                                    <dd>@(s.ImprovementAreas ?? "–")</dd>
                                </dl>
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>

    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount entr@(Model.TotalCount == 1 ? "y" : "ies"), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next<i class="bi bi-chevron-right ms-1 me-0" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}
