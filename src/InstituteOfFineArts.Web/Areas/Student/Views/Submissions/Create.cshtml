@model InstituteOfFineArts.Web.ViewModels.Student.Submissions.SubmissionFormVm
@*
    Student – submit an entry (/student/submissions/new?competitionId={id}, SCR-43, F-M06-01).
    Created by BE1 (BE1-07); styled by FE1-05: form sheet, live preview of the chosen JPEG (upload-preview.js),
    text type pills and the deadline countdown (countdown.js).
*@
@using System.Globalization
@using InstituteOfFineArts.Web.Helpers
@{
    ViewData["Title"] = "Submit an entry";
    var deadlineIso = CompetitionStatusResolver.SubmissionDeadline(Model.Deadline).ToString("yyyy-MM-dd'T'HH:mm:ss", CultureInfo.InvariantCulture);
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/student/competitions">Competitions</a></li>
                <li class="breadcrumb-item"><a href="/student/competitions/@Model.CompetitionId">@Model.CompetitionTitle</a></li>
                <li class="breadcrumb-item active" aria-current="page">Submit an entry</li>
            </ol>
        </nav>
        <h1>Submit an entry</h1>
        <p class="page-sub">
            @Model.CompetitionTitle, deadline @Model.Deadline.ToString("dd MMM yyyy"), 23:59:59.
            One entry per competition; you can edit or replace it until the deadline.
        </p>
        <p class="deadline mt-2 mb-0" data-deadline="@deadlineIso"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span data-countdown-text></span></p>
    </div>
</div>

<partial name="_Alerts" />

@* multipart/form-data is required to upload the image; the competition id goes back in the query string *@
<form asp-action="Create" asp-route-competitionId="@Model.CompetitionId" method="post" enctype="multipart/form-data" novalidate class="form-sheet">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <input type="hidden" asp-for="CompetitionId" />

    <div class="mb-4">
        <label asp-for="Image" class="form-label"></label>
        <input asp-for="Image" type="file" accept=".jpg,.jpeg,image/jpeg" class="form-control" data-upload-preview="image-preview" />
        <div class="form-text">JPEG only (.jpg, .jpeg), up to 5 MB. At least 600 px on the shortest side is recommended.</div>
        <span asp-validation-for="Image" class="text-danger"></span>

        @* Filled by upload-preview.js once a file is chosen; it only informs, the server checks the file *@
        <div id="image-preview" class="upload-preview" hidden>
            <div class="artwork-frame is-contain"><img alt="" /></div>
            <div class="wall-label" aria-live="polite">
                <span class="wl-title" data-preview-name></span>
                <span class="wl-meta" data-preview-meta></span>
                <span class="wl-note" data-preview-warn hidden></span>
            </div>
        </div>
    </div>

    <partial name="_Form" model="Model" />

    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-upload" aria-hidden="true"></i>Submit</button>
        <a href="/student/competitions/@Model.CompetitionId" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/upload-preview.js" asp-append-version="true"></script>
    <script src="~/js/countdown.js" asp-append-version="true"></script>
}
