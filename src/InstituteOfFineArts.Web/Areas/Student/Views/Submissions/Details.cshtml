@model InstituteOfFineArts.Web.ViewModels.Student.Submissions.MySubmissionDetailsVm
@*
    Student – details of an own entry (/student/submissions/{id}, SCR-45, F-M06-06, F-M06-07): the painting large on
    the stage, its label (competition, dates, deadline countdown via data-deadline), Edit/Delete while ongoing,
    the poem / quotation / story, and the evaluation once GRADED (BR-24).
    Created by BE1 (BE1-08); styled by FE1-05.
*@
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">My entries</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <h1><em>@Model.Title</em></h1>
        <p class="page-sub d-flex flex-wrap align-items-center gap-2">
            <a href="/student/competitions/@Model.CompetitionId">@Model.CompetitionTitle</a> <span>(@Model.CompetitionCode)</span>
            <partial name="~/Areas/Student/Views/Competitions/_Status.cshtml" model="Model.CompetitionStatus" />
        </p>
    </div>
    @* Edit / Delete only while the competition is ongoing; the server checks this again (BR-13) *@
    @if (Model.CanEdit)
    {
        <div class="page-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0"
                  data-confirm="Delete this entry and its image?" data-confirm-ok="Delete" data-confirm-title="Delete entry">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i>Delete</button>
            </form>
        </div>
    }
</div>

<partial name="_Alerts" />

<div class="artwork-stage">
    <figure class="artwork m-0">
        <div class="artwork-frame" data-zoom data-zoom-download="/files/submissions/@Model.Id?download=true">
            <img src="/files/submissions/@Model.Id" alt="@Model.Title – @User.GetFullName()" />
        </div>
        <figcaption class="small mt-2 text-muted">
            <a href="/files/submissions/@Model.Id?download=true"><i class="bi bi-download me-1" aria-hidden="true"></i>Download original</a>
            <span class="ms-2">@Model.OriginalFileName (@((Model.FileSize / 1024.0).ToString("#,##0")) KB)</span>
        </figcaption>
    </figure>

    <div>
        <dl class="details">
            <dt>Submitted</dt>
            <dd>@Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")</dd>
            @if (Model.UpdatedAt is { } updated)
            {
                <dt>Last changed</dt>
                <dd>@updated.ToString("dd MMM yyyy HH:mm")</dd>
            }
            <dt>Deadline</dt>
            <dd>
                @Model.EndDate.ToString("dd MMM yyyy"), 23:59:59
                @if (Model.CanEdit)
                {
                    @* Countdown target (ISO 8601, institute local time), filled by countdown.js *@
                    <div class="deadline" id="deadline-countdown" data-deadline="@Model.DeadlineIso"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span data-countdown-text></span></div>
                    <div class="small text-muted">You can edit or delete this entry until the deadline.</div>
                }
            </dd>
            <dt>Text type</dt>
            <dd>@Model.TextType</dd>
        </dl>

        @* .artwork-text keeps the line breaks (pre-line); Razor still encodes the text (no HTML/XSS) *@
        <h2 class="h3">Poem / quotation / story</h2>
        <p class="artwork-text">@Model.TextContent</p>

        <h2 class="h3">Description</h2>
        <p style="white-space: pre-line">@Model.Description</p>
    </div>
</div>

<section class="section" aria-labelledby="evaluation-title">
    <div class="section-head"><h2 id="evaluation-title">Evaluation</h2></div>
    @if (Model.Evaluation is { } e)
    {
        <div class="evaluation">
            <p class="d-flex flex-wrap align-items-center gap-2">
                <span class="tag tag-@e.Rating"><strong>Rating:</strong> @e.Rating</span>
                <span class="text-muted small">@e.EvaluatedAt.ToString("dd MMM yyyy")</span>
            </p>
            <dl class="details">
                <dt>Strengths</dt>
                <dd>@(e.PositivePoints ?? "–")</dd>
                <dt>Weaknesses</dt>
                <dd>@(e.NegativePoints ?? "–")</dd>
                <dt>Areas of improvement</dt>
                <dd>@(e.ImprovementAreas ?? "–")</dd>
            </dl>
        </div>
    }
    else if (Model.CompetitionStatus == CompetitionStatus.GRADED)
    {
        <p class="text-muted">Results are published, but this entry has no evaluation.</p>
    }
    else if (Model.CompetitionStatus == CompetitionStatus.CLOSED)
    {
        @* Closed, waiting for staff to publish (US-10 AC2): same text as the My Results page *@
        <p><span class="tag tag-PENDING">@InstituteOfFineArts.Web.Services.Implementations.StudentResultService.AwaitingResultsMessage</span></p>
    }
    else
    {
        <p class="text-muted">Results have not been published yet.</p>
    }
</section>

<a asp-action="Index" class="btn btn-link px-0"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to my entries</a>

@section Scripts {
    <script src="~/js/countdown.js" asp-append-version="true"></script>
}
