@model InstituteOfFineArts.Web.ViewModels.Student.Submissions.MySubmissionDetailsVm
@*
    Student – details of an own entry (/student/submissions/{id}, SCR-45, F-M06-06, F-M06-07): image + download, texts,
    competition, deadline (data-deadline for the countdown script), Edit/Delete while ongoing, evaluation once GRADED (BR-24).
    Minimal version created by BE1 (BE1-08); FE1 builds the real design and the countdown in FE1-05.
*@
@{
    ViewData["Title"] = Model.Title;
}

<partial name="_Alerts" />
@if (TempData["Warning"] is string warning)
{
    <div class="alert alert-warning">@warning</div>
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Title</h1>
        <div class="text-muted">
            <a href="/student/competitions/@Model.CompetitionId">@Model.CompetitionTitle</a> (@Model.CompetitionCode) ·
            <partial name="~/Areas/Student/Views/Competitions/_Status.cshtml" model="Model.CompetitionStatus" />
        </div>
    </div>
    @* Edit / Delete only while the competition is ongoing; the server checks this again (BR-13) *@
    @if (Model.CanEdit)
    {
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this entry and its image?');">
                <button type="submit" class="btn btn-outline-danger">Delete</button>
            </form>
        </div>
    }
</div>

<div class="row">
    <div class="col-lg-6 mb-3">
        <img src="/files/submissions/@Model.Id" alt="@Model.Title" class="img-fluid rounded border" />
        <div class="small mt-1">
            <a href="/files/submissions/@Model.Id?download=true">Download original</a>
            · @Model.OriginalFileName (@((Model.FileSize / 1024.0).ToString("#,##0")) KB)
        </div>
    </div>
    <div class="col-lg-6">
        <dl class="row">
            <dt class="col-sm-4">Submitted</dt>
            <dd class="col-sm-8">@Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")</dd>
            @if (Model.UpdatedAt is { } updated)
            {
                <dt class="col-sm-4">Last changed</dt>
                <dd class="col-sm-8">@updated.ToString("dd MMM yyyy HH:mm")</dd>
            }
            <dt class="col-sm-4">Deadline</dt>
            <dd class="col-sm-8">
                @Model.EndDate.ToString("dd MMM yyyy"), 23:59:59
                @if (Model.CanEdit)
                {
                    @* Countdown target for FE (ISO 8601, institute local time) *@
                    <div class="small text-muted" id="deadline-countdown" data-deadline="@Model.DeadlineIso">You can edit or delete this entry until the deadline.</div>
                }
            </dd>
            <dt class="col-sm-4">Text type</dt>
            <dd class="col-sm-8">@Model.TextType</dd>
        </dl>

        @* white-space: pre-line keeps the line breaks; Razor still encodes the text (no HTML/XSS) *@
        <h2 class="h5">Poem / quotation / story</h2>
        <p style="white-space: pre-line">@Model.TextContent</p>

        <h2 class="h5">Description</h2>
        <p style="white-space: pre-line">@Model.Description</p>
    </div>
</div>

<h2 class="h5 mt-3">Evaluation</h2>
@if (Model.Evaluation is { } e)
{
    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-2"><strong>Rating:</strong> @e.Rating <span class="text-muted small">(@e.EvaluatedAt.ToString("dd MMM yyyy"))</span></p>
            <p class="mb-1"><strong>Strengths</strong></p>
            <p style="white-space: pre-line">@(e.PositivePoints ?? "–")</p>
            <p class="mb-1"><strong>Weaknesses</strong></p>
            <p style="white-space: pre-line">@(e.NegativePoints ?? "–")</p>
            <p class="mb-1"><strong>Areas of improvement</strong></p>
            <p class="mb-0" style="white-space: pre-line">@(e.ImprovementAreas ?? "–")</p>
        </div>
    </div>
}
else if (Model.CompetitionStatus == CompetitionStatus.GRADED)
{
    <p class="text-muted">Results are published, but this entry has no evaluation.</p>
}
else
{
    <p class="text-muted">Results have not been published yet.</p>
}

<a asp-action="Index" class="btn btn-link px-0">Back to my entries</a>
