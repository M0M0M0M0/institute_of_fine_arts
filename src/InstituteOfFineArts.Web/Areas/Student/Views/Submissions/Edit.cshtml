@model InstituteOfFineArts.Web.ViewModels.Student.Submissions.SubmissionEditVm
@*
    Student – edit an entry and its pictures (/student/submissions/{id}/edit, SCR-43, F-M06-02, F-M06-03).
    Only while the competition is ongoing (BR-13). Created by BE1 (BE1-09); styled by FE1-05: form sheet, current
    pictures (remove, choose the cover), live preview of pictures to add (upload-preview.js), text type pills, countdown.
    The entry keeps 1 to 5 pictures (BR-18); the server checks the count again.
*@
@using System.Globalization
@using InstituteOfFineArts.Web.Helpers
@using InstituteOfFineArts.Web.Infrastructure.FileStorage
@{
    ViewData["Title"] = "Edit entry";
    var max = UploadOptions.MaxImagesPerSubmission;
    var left = Math.Max(0, max - Model.CurrentImages.Count);
    var deadlineIso = CompetitionStatusResolver.SubmissionDeadline(Model.Deadline).ToString("yyyy-MM-dd'T'HH:mm:ss", CultureInfo.InvariantCulture);
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/student/submissions">My entries</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">Entry details</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
        <h1>Edit entry</h1>
        <p class="page-sub">@Model.CompetitionTitle: you can change your entry until @Model.Deadline.ToString("dd MMM yyyy"), 23:59:59.</p>
        <p class="deadline mt-2 mb-0" data-deadline="@deadlineIso"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span data-countdown-text></span></p>
    </div>
</div>

<partial name="_Alerts" />

@* multipart/form-data is required to upload new pictures *@
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate class="form-sheet">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <fieldset class="mb-4">
        <legend class="form-label">Current pictures</legend>
        @if (Model.CurrentImages.Count == 0)
        {
            @* Entry saved before pictures were kept one by one: its single image *@
            <div class="upload-preview mt-0 mb-3">
                <div class="artwork-frame is-contain"><img src="/files/submissions/@Model.Id/thumb" alt="Current image" /></div>
                <div class="wall-label"><span class="wl-meta">Current file: @Model.OriginalFileName</span></div>
            </div>
        }
        else
        {
            <ul class="upload-list" data-current-images>
                @foreach (var img in Model.CurrentImages)
                {
                    var removing = Model.RemoveImageIds.Contains(img.Id);
                    var cover = Model.CoverImageId.HasValue ? Model.CoverImageId == img.Id : img.IsCover;
                    <li class="upload-item @(removing ? "is-removed" : "")">
                        <div class="upload-thumb"><img src="/files/submission-images/@img.Id/thumb" alt="" loading="lazy" /></div>
                        <div class="upload-info">
                            <span class="upload-name">@img.FileName</span>
                            <span class="upload-meta">@((img.FileSize / 1024.0).ToString("#,##0")) KB@(img.IsCover ? " · current cover" : "")</span>
                            <div class="upload-choices">
                                <label class="form-check-label"><input type="radio" class="form-check-input me-1" name="CoverImageId" value="@img.Id" checked="@cover" />Cover</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" name="RemoveImageIds" value="@img.Id" checked="@removing" data-remove-image />Remove</label>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
    </fieldset>

    <div class="mb-4">
        <label asp-for="NewImages" class="form-label"></label>
        <input asp-for="NewImages" type="file" multiple accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="form-control"
               data-upload-multi="image-list" data-max-files="@left" data-max-total="@max" />
        <div class="form-text">
            Optional. An entry has 1 to @max pictures of the same artwork (JPG, PNG or WebP, up to 10 MB each).
            Removed pictures are deleted when you save. To make a new picture the cover, save first, then choose it here.
        </div>
        <span asp-validation-for="NewImages" class="text-danger d-block"></span>

        @* Filled by upload-preview.js once files are chosen; it only informs, the server checks every file *@
        <ul id="image-list" class="upload-list" aria-live="polite" hidden></ul>
    </div>

    <partial name="_Form" model="Model" />

    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/upload-preview.js" asp-append-version="true"></script>
    <script src="~/js/countdown.js" asp-append-version="true"></script>
}
