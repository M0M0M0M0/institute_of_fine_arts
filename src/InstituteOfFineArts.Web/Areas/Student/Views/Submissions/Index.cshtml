@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Student.Submissions.MySubmissionListItemVm>
@*
    Student – my entries (/student/submissions, SCR-44, F-M06-05): own entries only, filters and paging.
    Each painting hangs with a wall label carrying its state: deadline countdown + Edit while ONGOING,
    "Awaiting results" once CLOSED, the rating once GRADED.
    Created by BE1 (BE1-08); styled by FE1-05.
*@
@using System.Globalization
@using InstituteOfFineArts.Web.Helpers
@using InstituteOfFineArts.Web.Services.Implementations
@{
    ViewData["Title"] = "My entries";
    var search = (InstituteOfFineArts.Web.ViewModels.Student.Submissions.MySubmissionSearchVm)ViewBag.Search;
    var competitions = (List<InstituteOfFineArts.Web.ViewModels.Student.Submissions.MyCompetitionOptionVm>)ViewBag.Competitions;
    var me = User.GetFullName();
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new { search.CompetitionId, search.Title, search.Rating, From = search.From?.ToString("yyyy-MM-dd"), To = search.To?.ToString("yyyy-MM-dd"), page };
}

<div class="page-head">
    <div>
        <h1>My entries</h1>
        <p class="page-sub">Your paintings, with the time left to change them or their result.</p>
    </div>
    <div class="page-actions">
        <a href="/student/competitions" class="btn btn-primary"><i class="bi bi-easel" aria-hidden="true"></i>Find a competition</a>
    </div>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Index" class="filters">
    <div class="filter">
        <label class="form-label" for="CompetitionId">Competition</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">All</option>
            @foreach (var c in competitions)
            {
                <option value="@c.Id" selected="@(search.CompetitionId == c.Id)">@c.Title</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Title">Title</label>
        <input class="form-control" id="Title" name="Title" value="@search.Title" />
    </div>
    <div class="filter">
        <label class="form-label" for="From">Submitted from</label>
        <input class="form-control" type="date" id="From" name="From" value="@search.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="To">Submitted to</label>
        <input class="form-control" type="date" id="To" name="To" value="@search.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="Rating">Rating</label>
        <select class="form-select" id="Rating" name="Rating">
            <option value="">All</option>
            @foreach (var r in Enum.GetValues<Rating>())
            {
                <option value="@r" selected="@(search.Rating == r)">@r</option>
            }
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        <a href="/student/submissions" class="btn btn-link">Clear</a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-images" aria-hidden="true"></i>
        <p>No entries found.</p>
        <a href="/student/competitions" class="btn btn-outline-primary">Find a competition</a>
    </div>
}
else
{
    <div class="art-grid">
        @foreach (var s in Model.Items)
        {
            var awarded = s.CompetitionStatus == CompetitionStatus.GRADED && s.Rating == Rating.BEST;
            <figure class="artwork@(awarded ? " is-awarded" : "")">
                <a class="artwork-frame" asp-action="Details" asp-route-id="@s.Id" tabindex="-1" aria-hidden="true">
                    @if (s.HasThumbnail)
                    {
                        <img src="/files/submissions/@s.Id/thumb" alt="@s.Title – @me" loading="lazy" />
                    }
                    else
                    {
                        <span class="artwork-missing">Image not available</span>
                    }
                </a>
                <figcaption class="wall-label">
                    <span class="wl-title"><a asp-action="Details" asp-route-id="@s.Id">@s.Title</a></span>
                    <span class="wl-meta">@s.CompetitionTitle</span>
                    <span class="wl-meta">Submitted @s.SubmittedAt.ToString("dd MMM yyyy HH:mm")</span>
                    <span class="wl-state">
                        @if (s.CompetitionStatus == CompetitionStatus.GRADED)
                        {
                            if (s.Rating is { } rating)
                            {
                                <span class="tag tag-@rating">@rating</span>
                            }
                            else
                            {
                                <span class="tag tag-NOT_GRADED">Not graded</span>
                            }
                        }
                        else if (s.CompetitionStatus == CompetitionStatus.CLOSED)
                        {
                            <span class="tag tag-PENDING">@StudentResultService.AwaitingResultsMessage</span>
                        }
                        else
                        {
                            <partial name="~/Areas/Student/Views/Competitions/_Status.cshtml" model="s.CompetitionStatus" />
                        }
                    </span>
                    @if (s.CanEdit)
                    {
                        <span class="wl-note deadline" data-deadline="@CompetitionStatusResolver.SubmissionDeadline(s.EndDate).ToString("yyyy-MM-dd'T'HH:mm:ss", CultureInfo.InvariantCulture)">
                            <i class="bi bi-hourglass-split" aria-hidden="true"></i><span data-countdown-text>until @s.EndDate.ToString("dd MMM yyyy")</span>
                        </span>
                        <span class="wl-actions">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
                        </span>
                    }
                    else
                    {
                        <span class="wl-note text-muted small"><i class="bi bi-lock me-1" aria-hidden="true"></i>Locked</span>
                    }
                </figcaption>
            </figure>
        }
    </div>

    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount entr@(Model.TotalCount == 1 ? "y" : "ies"), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next<i class="bi bi-chevron-right ms-1 me-0" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}

@section Scripts {
    <script src="~/js/countdown.js" asp-append-version="true"></script>
}
