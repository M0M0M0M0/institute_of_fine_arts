@model InstituteOfFineArts.Web.ViewModels.Staff.Evaluations.EvaluationPageVm
@*
    Teacher – grade an entry (/teacher/evaluations/{submissionId}, SCR-27, F-M07-03..05, F-M07-08; TODO steps 4–5).
    - Left: the pictures of the entry (zoom, download), the wall label, the text and description.
    - Right: the judge's own grade – a score 0–100 and a comment per criterion of the competition, the weighted total
      shown live (wwwroot/js/grading-form.js, calculated again by the server), the general comments; or "Disqualify"
      with the reason. A late entry can only be disqualified (BR-14).
    - The jury: who has graded this entry (never the other judges' scores before the results are published).
    - Once GRADED: the whole score sheet of the jury.
*@
@using InstituteOfFineArts.Web.ViewModels.Staff.Evaluations
@{
    ViewData["Title"] = $"Evaluate – {Model.Title}";
    var criteria = Model.Criteria.ToDictionary(c => c.CompetitionCriterionId);
    string? Error(string key) => ViewData.ModelState.TryGetValue(key, out var e) && e.Errors.Count > 0 ? e.Errors[0].ErrorMessage : null;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var images = new InstituteOfFineArts.Web.ViewModels.Common.EntryImagesVm(Model.SubmissionId, Model.ImageIds, $"{Model.Title} – {Model.StudentName}", true);
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/teacher/submissions?competitionId=@Model.CompetitionId">Entries</a></li>
                <li class="breadcrumb-item"><a href="/teacher/submissions/@Model.SubmissionId">@Model.Title</a></li>
                <li class="breadcrumb-item active" aria-current="page">Evaluate</li>
            </ol>
        </nav>
        <h1>Evaluate entry</h1>
        <p class="page-sub d-flex flex-wrap align-items-center gap-2">
            <span>@Model.CompetitionTitle, @Model.CompetitionCode</span>
            <partial name="~/Areas/Staff/Views/Competitions/_Status.cshtml" model="Model.CompetitionStatus" />
        </p>
    </div>
    <div class="page-actions">
        <a href="/teacher/submissions/@Model.SubmissionId" class="btn btn-outline-primary"><i class="bi bi-file-earmark-image" aria-hidden="true"></i>Submission details</a>
        <a href="/teacher/submissions?competitionId=@Model.CompetitionId&Evaluated=false" class="btn btn-link">Back to entries</a>
    </div>
</div>
<partial name="_Alerts" />

@if (Model.IsLate)
{
    <div class="alert alert-danger late-warning" role="alert">
        <i class="bi bi-clock-history" aria-hidden="true"></i>
        <div><strong>Late entry.</strong> Submitted after the deadline (@Model.EndDate.ToString("dd MMM yyyy"), 23:59:59), so it can only be disqualified.</div>
    </div>
}
@if (Model.ReadOnlyReason != null)
{
    <div class="alert alert-info"><i class="bi bi-lock" aria-hidden="true"></i><div>@Model.ReadOnlyReason</div></div>
}

<div class="artwork-stage grading-stage">
    <figure class="artwork m-0">
        <partial name="_EntryImages" model="images" />
        <figcaption class="wall-label wall-label-long">
            <span class="wl-title">@Model.Title</span>
            <span class="wl-artist">@Model.StudentName (@Model.StudentCode)</span>
            <span class="wl-meta">@Model.CompetitionTitle</span>
            <span class="wl-meta num">Submitted at @Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")</span>
        </figcaption>
        <div class="mt-4">
            <h2 class="h3">Text (@Model.TextType)</h2>
            <p class="artwork-text">@Model.TextContent</p>
            <h2 class="h3">Description</h2>
            <p style="white-space: pre-line">@Model.Description</p>
        </div>
    </figure>

    <div class="grading-panel">
        <div class="section-head"><h2>Your grade</h2></div>
        @if (Model.HasEvaluation)
        {
            <p class="text-muted small">You last saved it on @Model.EvaluatedAt?.ToString("dd MMM yyyy HH:mm")@(Model.MyTotal is { } t ? $", total {t.ToString("0.00", inv)} / 100" : Model.Form.Disqualified ? ", disqualified" : "").</p>
        }

        @if (Model.CanEvaluate)
        {
            <form asp-action="Index" asp-route-submissionId="@Model.SubmissionId" method="post" novalidate class="form-sheet" data-grading-form>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <input type="hidden" name="Form.Version" value="@Model.Form.Version" />

                <div class="form-check form-switch mb-3">
                    @if (Model.IsLate)
                    {
                        <input type="hidden" name="Form.Disqualified" value="true" />
                        <input class="form-check-input" type="checkbox" id="Form_Disqualified" checked disabled />
                    }
                    else
                    {
                        <input class="form-check-input" type="checkbox" name="Form.Disqualified" id="Form_Disqualified" value="true" checked="@Model.Form.Disqualified" data-disqualify />
                        <input type="hidden" name="Form.Disqualified" value="false" />
                    }
                    <label class="form-check-label" for="Form_Disqualified">Disqualify this entry (rules broken, late…) – no scores, a reason is required</label>
                </div>

                <fieldset class="mb-3" data-scores>
                    <legend class="form-label">Scores (0–100)</legend>
                    @if (Error("Form.Scores") is { } scoresError)
                    {
                        <p class="text-danger small">@scoresError</p>
                    }
                    @for (var i = 0; i < Model.Form.Scores.Count; i++)
                    {
                        var line = Model.Form.Scores[i];
                        if (!criteria.TryGetValue(line.CompetitionCriterionId, out var c)) { continue; }
                        <div class="score-row">
                            <input type="hidden" name="Form.Scores[@i].CompetitionCriterionId" value="@c.CompetitionCriterionId" />
                            <label class="score-name" for="score-@i">
                                <strong>@c.Name</strong> <span class="text-muted small num">@c.Weight.ToString("0.##", inv) %</span>
                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <span class="small text-muted d-block">@c.Description</span>
                                }
                            </label>
                            <input class="form-control score-input num" id="score-@i" name="Form.Scores[@i].Score" type="number" min="0" max="100" step="0.01"
                                   value="@line.Score?.ToString("0.##", inv)" data-weight="@c.Weight.ToString(inv)" inputmode="decimal" />
                            <textarea class="form-control form-control-sm score-comment" name="Form.Scores[@i].Comment" rows="1" maxlength="1000"
                                      placeholder="Comment on @c.Name (optional)" aria-label="Comment on @c.Name">@line.Comment</textarea>
                            @foreach (var field in new[] { "Score", "Comment" })
                            {
                                if (Error($"Form.Scores[{i}].{field}") is { } e)
                                {
                                    <span class="text-danger small score-error">@e</span>
                                }
                            }
                        </div>
                    }
                    <p class="score-total">Weighted total: <strong class="num" data-score-total>–</strong> / 100</p>
                </fieldset>

                <div class="mb-3">
                    <label for="Form_PositivePoints" class="form-label">Positive points</label>
                    <textarea id="Form_PositivePoints" name="Form.PositivePoints" class="form-control" rows="3" maxlength="2000">@Model.Form.PositivePoints</textarea>
                    <div class="form-text">Required unless the entry is disqualified.</div>
                    <span class="text-danger small">@Error("Form.PositivePoints")</span>
                </div>
                <div class="mb-3">
                    <label for="Form_NegativePoints" class="form-label">Negative points <span class="text-muted small" data-reason-hint>(the reason when disqualified)</span></label>
                    <textarea id="Form_NegativePoints" name="Form.NegativePoints" class="form-control" rows="3" maxlength="2000">@Model.Form.NegativePoints</textarea>
                    <span class="text-danger small">@Error("Form.NegativePoints")</span>
                </div>
                <div class="mb-3">
                    <label for="Form_ImprovementAreas" class="form-label">Improvement areas</label>
                    <textarea id="Form_ImprovementAreas" name="Form.ImprovementAreas" class="form-control" rows="3" maxlength="2000">@Model.Form.ImprovementAreas</textarea>
                    <span class="text-danger small">@Error("Form.ImprovementAreas")</span>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i>Save my grade</button>
            </form>
        }
        else if (Model.HasEvaluation)
        {
            <dl class="details">
                @if (Model.Form.Disqualified)
                {
                    <dt>Result</dt><dd><span class="tag tag-DISQUALIFIED">Disqualified</span></dd>
                }
                @foreach (var s in Model.Form.Scores.Where(s => criteria.ContainsKey(s.CompetitionCriterionId)))
                {
                    <dt>@criteria[s.CompetitionCriterionId].Name</dt>
                    <dd><span class="num">@(s.Score?.ToString("0.##", inv) ?? "–")</span>@if (s.Comment != null) { <span class="text-muted"> – @s.Comment</span> }</dd>
                }
                <dt>Positive points</dt><dd style="white-space: pre-line">@(Model.Form.PositivePoints ?? "–")</dd>
                <dt>Negative points</dt><dd style="white-space: pre-line">@(Model.Form.NegativePoints ?? "–")</dd>
                <dt>Improvement areas</dt><dd style="white-space: pre-line">@(Model.Form.ImprovementAreas ?? "–")</dd>
            </dl>
        }

        @if (Model.CanDelete)
        {
            <form asp-action="Delete" asp-route-submissionId="@Model.SubmissionId" method="post" class="mt-3"
                  data-confirm="Delete your grade of this entry?" data-confirm-ok="Delete">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i>Delete my grade</button>
            </form>
        }

        <div class="section-head mt-4"><h2 class="h3">Jury</h2></div>
        <p class="small text-muted">Each judge grades on their own; the scores of the others are shown after the results are published.</p>
        <ul class="list-unstyled jury-progress">
            @foreach (var j in Model.Jury)
            {
                <li>
                    <i class="bi @(j.Done ? "bi-check-circle-fill text-success" : "bi-circle text-muted")" aria-hidden="true"></i>
                    @j.Name@(j.IsMe ? " (you)" : "")@(j.IsChair ? ", chair" : "")
                    <span class="visually-hidden">@(j.Done ? "has graded" : "has not graded yet")</span>
                </li>
            }
        </ul>
    </div>
</div>

@if (Model.ScoreSheet is { } sheet)
{
    <section class="section" aria-labelledby="sheet-title">
        <div class="section-head"><h2 id="sheet-title">Score sheet of the jury</h2></div>
        <partial name="_ScoreSheet" model="sheet" />
    </section>
}

@section Scripts {
    <script src="~/js/grading-form.js" asp-append-version="true"></script>
}
