@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Staff.Submissions.SubmissionListItemVm>
@*
    Teacher – entries to grade (/teacher/submissions, SCR-53): filters competition, evaluation, rating, student, date
    range; grading progress of the chosen competition. Only competitions whose submission period is over (CLOSED or
    GRADED) are listed: the service (closedOnly) leaves the others out, so nothing leaks before the deadline.
    Reuses the table partial of the Staff area (its links go to the Teacher controllers of the same name).
*@
@using InstituteOfFineArts.Web.ViewModels.Staff.Submissions
@{
    ViewData["Title"] = "Submissions";
    var search = (SubmissionSearchVm)ViewBag.Search;
    var competitions = (IReadOnlyList<CompetitionOptionVm>)ViewBag.Competitions;
    var progress = (EvaluationProgressVm?)ViewBag.Progress;
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new
    {
        search.CompetitionId, search.CompetitionStatus, search.Evaluated, search.Rating, search.Student,
        From = search.From?.ToString("yyyy-MM-dd"), To = search.To?.ToString("yyyy-MM-dd"), page,
    };
    var filtered = search.CompetitionId != null || search.CompetitionStatus != null || search.Evaluated != null || search.Rating != null || !string.IsNullOrEmpty(search.Student) || search.From != null || search.To != null;
}

<div class="page-head">
    <div>
        <h1>Entries</h1>
        <p class="page-sub">Entries of the competitions that are closed for entries. Open an entry to grade it.</p>
    </div>
</div>

<partial name="_Alerts" />

@* GET search form: filters only, nothing is changed *@
<form method="get" asp-action="Index" class="filters" role="search">
    <div class="filter is-wide">
        <label class="form-label" for="CompetitionId">Competition</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">All competitions</option>
            @foreach (var c in competitions)
            {
                <option value="@c.Id" selected="@(search.CompetitionId == c.Id)">@c.Code – @c.Title</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="CompetitionStatus">Competition status</label>
        <select class="form-select" id="CompetitionStatus" name="CompetitionStatus">
            <option value="">All</option>
            @* Teachers only see closed competitions: CLOSED (to grade) or GRADED (published) *@
            @foreach (var st in new[] { CompetitionStatus.CLOSED, CompetitionStatus.GRADED })
            {
                <option value="@st" selected="@(search.CompetitionStatus == st)">@InstituteOfFineArts.Web.Helpers.EnumText.Of(st)</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Evaluated">Your grade</label>
        <select class="form-select" id="Evaluated" name="Evaluated">
            <option value="">All</option>
            <option value="true" selected="@(search.Evaluated == true)">Graded by me</option>
            <option value="false" selected="@(search.Evaluated == false)">To grade</option>
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Rating">Rating</label>
        <select class="form-select" id="Rating" name="Rating">
            <option value="">All</option>
            @foreach (var r in Enum.GetValues<Rating>())
            {
                <option value="@r" selected="@(search.Rating == r)">@r</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Student">Student name or code</label>
        <input class="form-control" id="Student" name="Student" value="@search.Student" />
    </div>
    <div class="filter">
        <label class="form-label" for="From">From</label>
        <input class="form-control" type="date" id="From" name="From" value="@search.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="To">To</label>
        <input class="form-control" type="date" id="To" name="To" value="@search.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-link">Clear</a>
        }
    </div>
</form>

@* Grading progress of the chosen competition (F-M07-09) *@
@if (progress != null)
{
    var percent = progress.Total == 0 ? 0 : (int)Math.Round(100.0 * progress.Evaluated / progress.Total);
    <div class="alert alert-info flex-wrap justify-content-between align-items-center" id="evaluation-progress">
        <span>
            <a asp-controller="Competitions" asp-action="Details" asp-route-id="@progress.CompetitionId">@progress.CompetitionTitle</a>
            <partial name="~/Areas/Staff/Views/Competitions/_Status.cshtml" model="progress.Status" />
        </span>
        <span class="d-flex align-items-center gap-3">
            <progress class="meter progress-inline" max="100" value="@percent" aria-label="Grading progress">@percent%</progress>
            <strong class="num">Graded by the whole jury @progress.Evaluated / total @progress.Total</strong>
        </span>
    </div>
}

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-images" aria-hidden="true"></i>
        <p>No submissions found.</p>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-outline-primary">Clear the filters</a>
        }
    </div>
}
else
{
    <div class="table-responsive">
        @{ ViewData["StudentLinks"] = false; }
        <partial name="~/Areas/Staff/Views/Submissions/_Table.cshtml" model="Model.Items" />
    </div>

    @* Pager keeps the current filters *@
    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount submission(s), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next<i class="bi bi-chevron-right ms-1" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}
