<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- User Secrets store id: each machine sets its own connection string (e.g. SQL Server in Docker) without putting passwords in the repo -->
    <UserSecretsId>bec49735-9165-4447-87f1-f6b7886b0b36</UserSecretsId>
  </PropertyGroup>

  <!-- Unit tests may call internal members (e.g. the sample data seeder) -->
  <ItemGroup>
    <InternalsVisibleTo Include="InstituteOfFineArts.Tests" />
  </ItemGroup>

  <!-- Libraries used by the project (fixed versions so every team member builds the same) -->
  <ItemGroup>
    <!-- BCrypt password hashing -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <!-- Excel export of the reports (optional feature M14) -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- Keep table/column names in snake_case as in the database design -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Sending e-mail: forgot password and notifications (optional features M12, M16) -->
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <!-- EF Core: migration tooling (development only) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- PDF export of the reports (optional feature M14, Community licence) -->
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- Logging to files -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Thumbnail generation when paintings are uploaded -->
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <!-- Upgrades a transitive dependency of Microsoft.Data.SqlClient to a patched version (the default 9.0.11 triggers vulnerability warning NU1903) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
