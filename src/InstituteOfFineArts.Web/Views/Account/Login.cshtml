@model InstituteOfFineArts.Web.ViewModels.Account.LoginVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<InstituteOfFineArts.Web.SharedResource> L
@*
    Login page (/login) – used by every role.
    Minimal version created by BE1 so the feature works; FE1 builds the real design in task FE1-02.
*@
@{
    ViewData["Title"] = L["Log in"].Value;
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <h1 class="h3 mb-3">@L["Log in"]</h1>
        @* Success message after a password reset (F-M16-01) *@
        <partial name="_Alerts" />

        @* Form posts to POST /login; the asp-* tag helpers add the anti-forgery token *@
        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            @* General errors: wrong username/password, locked account *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">@L["Log in"]</button>
        </form>

        @* Forgot password link (F-M16-01) *@
        <p class="mt-3 text-center">
            <a asp-controller="PasswordReset" asp-action="ForgotPassword">Forgot password?</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
