@model InstituteOfFineArts.Web.ViewModels.Account.LoginVm
@*
    Trang đăng nhập (/login) – dùng cho mọi vai trò.
    Bản tối thiểu do BE1 tạo để chạy được chức năng; FE1 làm giao diện thật trong task FE1-02.
*@
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <h1 class="h3 mb-3">Đăng nhập</h1>

        @* Form gửi về POST /login; asp-* tự chèn anti-forgery token *@
        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            @* Lỗi chung: sai tài khoản / mật khẩu, tài khoản bị khóa *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
