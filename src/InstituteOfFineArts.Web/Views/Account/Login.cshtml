@model InstituteOfFineArts.Web.ViewModels.Account.LoginVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<InstituteOfFineArts.Web.SharedResource> L
@*
    Login page (/login) – used by every role.
    Created by BE1; styled by FE1-02: one calm white sheet with the wordmark on the mist band.
*@
@{
    ViewData["Title"] = L["Log in"].Value;
    ViewData["FullBleed"] = true;
}

<section class="band band-mist auth-band">
    <div class="auth-sheet">
        <a class="wordmark" href="/" aria-label="Institute of Fine Arts – home"><partial name="_Wordmark" model="@("ink")" /></a>
        <h1>@L["Log in"]</h1>
        @* Success message after a password reset (F-M16-01) *@
        <partial name="_Alerts" />

        @* Form posts to POST /login; the asp-* tag helpers add the anti-forgery token *@
        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            @* General errors: wrong username/password, locked account *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">@L["Log in"]</button>
        </form>

        @* Forgot password link (F-M16-01) *@
        <p class="auth-foot">
            <a asp-controller="PasswordReset" asp-action="ForgotPassword">@L["Forgot password?"]</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
