@{
    Layout = null;
    ViewData["Title"] = "Log In - Institute of Fine Arts";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-wrapper container-fluid p-0">
        <div class="row g-0 h-100">
            <!-- CỘT ẢNH: Tăng độ rộng lên 7/12 (lg) và 8/12 (xl) -->
        <div class="col-lg-7 col-xl-8 d-none d-md-block auth-image-col">
            <img src="~/img/authen.jpg" alt="Art Authentication" class="auth-bg-img" />
            <!-- Lớp phủ tạo hiệu ứng fade trải dài -->
            <div class="auth-fade-right"></div>
        </div>

        <!-- CỘT FORM: Thu gọn vừa vặn để chữ không bị loãng -->
        <div class="col-lg-5 col-xl-4 d-flex align-items-center justify-content-center bg-white auth-form-col">
            <div class="auth-form-container w-100 px-4 px-xl-5">
                    <div class="mb-5">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small">
                            <i class="bi bi-arrow-left me-1"></i> Back to Gallery
                        </a>
                    </div>

                    <h2 class="auth-title fw-normal mb-2">Welcome Back</h2>
                    <p class="text-muted small mb-4">Please enter your details to sign in.</p>

                    <form asp-controller="Authentication" asp-action="Login" method="post">
                        <div class="form-floating mb-4">
                            <input type="email" class="form-control auth-input shadow-none" id="floatingInput" placeholder="name@example.com" required>
                            <label for="floatingInput" class="text-muted">Email address</label>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <input type="password" class="form-control auth-input shadow-none" id="floatingPassword" placeholder="Password" required>
                            <label for="floatingPassword" class="text-muted">Password</label>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 small">
                            <div class="form-check">
                                <input class="form-check-input shadow-none auth-checkbox" type="checkbox" id="rememberMe">
                                <label class="form-check-label text-muted" for="rememberMe">Remember me</label>
                            </div>
                            <a href="#" class="text-dark text-decoration-none border-bottom border-dark pb-1">Forgot password?</a>
                        </div>

                        <button class="btn btn-dark w-100 py-3 mb-4 rounded-0 auth-btn" type="submit">Sign In</button>

                        <div class="text-center">
    <p class="small text-muted mb-0">Don't have an account? 
        <a href="javascript:void(0)" 
           class="text-dark fw-bold ms-1 text-decoration-none border-bottom border-dark" 
           data-bs-toggle="modal" 
           data-bs-target="#registerModal">
           Create account
        </a>
    </p>
</div>

<!-- ==========================================================================
     2. POPUP MODAL ĐĂNG KÝ (REGISTER MODAL)
     ========================================================================== -->
<div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content rounded-0 border-0 shadow-lg">
            
            <!-- Modal Header -->
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <div>
                    <h3 class="modal-title art-title fw-normal" id="registerModalLabel">Create Account</h3>
                    <p class="text-muted small mb-0">Join our community of art collectors & creators</p>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-4 py-3">
                <form id="registerForm" asp-controller="Authentication" asp-action="Register" method="post" novalidate>
                    
                    <!-- Full Name -->
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control auth-input shadow-none" id="regFullName" placeholder="Full Name" required>
                        <label for="regFullName" class="text-muted">Full Name</label>
                        <div class="invalid-feedback small">Please enter your full name.</div>
                    </div>

                    <!-- Date of Birth -->
                    <div class="form-floating mb-3">
                        <input type="date" class="form-control auth-input shadow-none" id="regDob" placeholder="Date of Birth" required>
                        <label for="regDob" class="text-muted">Date of Birth</label>
                        <div class="invalid-feedback small">Please select your date of birth.</div>
                    </div>

                    <!-- Email Address -->
                    <div class="form-floating mb-3">
                        <input type="email" class="form-control auth-input shadow-none" id="regEmail" placeholder="name@example.com" required>
                        <label for="regEmail" class="text-muted">Email address</label>
                        <div class="invalid-feedback small" id="emailFeedback">Please enter a valid email address.</div>
                    </div>

                    <!-- Password -->
                    <div class="form-floating mb-2">
                        <input type="password" class="form-control auth-input shadow-none" id="regPassword" placeholder="Password" required>
                        <label for="regPassword" class="text-muted">Password</label>
                    </div>

                    <!-- REAL-TIME PASSWORD CHECKLIST -->
                    <div class="password-checklist p-3 mb-3 bg-light rounded-1 border">
                        <span class="d-block small fw-bold text-muted mb-2">Password requirements:</span>
                        <ul class="list-unstyled mb-0 small" style="font-size: 0.82rem; line-height: 1.6;">
                            <li id="rule-len" class="text-danger">
                                <i class="bi bi-x-circle me-1"></i> At least 8 characters
                            </li>
                            <li id="rule-upper" class="text-danger">
                                <i class="bi bi-x-circle me-1"></i> At least 1 uppercase letter (A-Z)
                            </li>
                            <li id="rule-number" class="text-danger">
                                <i class="bi bi-x-circle me-1"></i> At least 1 number (0-9)
                            </li>
                            <li id="rule-special" class="text-danger">
                                <i class="bi bi-x-circle me-1"></i> At least 1 special character (!@@#$...)
                            </li>
                        </ul>
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-floating mb-2">
                        <input type="password" class="form-control auth-input shadow-none" id="regConfirmPassword" placeholder="Confirm Password" required>
                        <label for="regConfirmPassword" class="text-muted">Confirm Password</label>
                    </div>
                    
                    <!-- Confirm Match Notice -->
                    <div class="mb-4">
                        <span id="rule-match" class="small text-danger" style="font-size: 0.82rem;">
                            <i class="bi bi-x-circle me-1"></i> Passwords must match
                        </span>
                    </div>

                    <!-- Submit Button -->
                    <button class="btn btn-dark w-100 py-3 rounded-0 auth-btn" type="submit" id="btnRegisterSubmit">
                        Create Account
                    </button>
                </form>
            </div>
            
        </div>
    </div>
</div>
                    </form>
                </div>
            </div>
        </div>
    </div>

<!-- Đảm bảo đã có Bootstrap JS và Bootstrap Icons để icon hiển thị đúng -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    const passwordInput = document.getElementById("regPassword");
    const confirmInput = document.getElementById("regConfirmPassword");
    const emailInput = document.getElementById("regEmail");
    const registerForm = document.getElementById("registerForm");

    // Checklist elements
    const ruleLen = document.getElementById("rule-len");
    const ruleUpper = document.getElementById("rule-upper");
    const ruleNumber = document.getElementById("rule-number");
    const ruleSpecial = document.getElementById("rule-special");
    const ruleMatch = document.getElementById("rule-match");

    // Helper function to update status
    function setStatus(element, isValid, validText, invalidText) {
        const icon = element.querySelector("i");
        if (isValid) {
            element.classList.remove("text-danger");
            element.classList.add("text-success");
            icon.className = "bi bi-check-circle-fill me-1";
            if (validText) element.lastChild.textContent = " " + validText;
        } else {
            element.classList.remove("text-success");
            element.classList.add("text-danger");
            icon.className = "bi bi-x-circle me-1";
            if (invalidText) element.lastChild.textContent = " " + invalidText;
        }
    }

    // 1. Password validation on input
    passwordInput.addEventListener("input", function () {
        const val = passwordInput.value;

        const isLenValid = val.length >= 8;
        const isUpperValid = /[A-Z]/.test(val);
        const isNumValid = /[0-9]/.test(val);
        const isSpecialValid = /[^A-Za-z0-9]/.test(val);

        setStatus(ruleLen, isLenValid);
        setStatus(ruleUpper, isUpperValid);
        setStatus(ruleNumber, isNumValid);
        setStatus(ruleSpecial, isSpecialValid);

        checkConfirmMatch();
    });

    // 2. Confirm password match check
    confirmInput.addEventListener("input", checkConfirmMatch);

    function checkConfirmMatch() {
        const pwd = passwordInput.value;
        const confirmVal = confirmInput.value;
        const isMatch = (pwd.length > 0) && (pwd === confirmVal);

        setStatus(
            ruleMatch, 
            isMatch, 
            "Passwords match", 
            "Passwords must match"
        );
        return isMatch;
    }

    // 3. Email regex validation
    function validateEmail(email) {
        const re = /^[^\s\u0040]+\u0040[^\s\u0040]+\.[^\s\u0040]+$/;
        return re.test(email);
    }

    emailInput.addEventListener("input", function () {
        if (validateEmail(emailInput.value)) {
            emailInput.classList.remove("is-invalid");
            emailInput.classList.add("is-valid");
        } else {
            emailInput.classList.remove("is-valid");
            emailInput.classList.add("is-invalid");
        }
    });

    // 4. Form submit validation check
    registerForm.addEventListener("submit", function (e) {
        const val = passwordInput.value;
        const isAllPasswordValid = 
            val.length >= 8 &&
            /[A-Z]/.test(val) &&
            /[0-9]/.test(val) &&
            /[^A-Za-z0-9]/.test(val) &&
            checkConfirmMatch();

        const isEmailValid = validateEmail(emailInput.value);

        if (!isAllPasswordValid || !isEmailValid || !registerForm.checkValidity()) {
            e.preventDefault();
            e.stopPropagation();
            
            if (!isEmailValid) emailInput.classList.add("is-invalid");
            registerForm.classList.add("was-validated");
        }
    });
});
</script>
</body>
</html>
