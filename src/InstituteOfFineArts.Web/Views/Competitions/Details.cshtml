@model InstituteOfFineArts.Web.ViewModels.Public.PublicCompetitionDetailsVm
@*
    Public competition details (/competitions/{id}, SCR-02, F-M02-05, TC-M02-05): description, rules, dates, awards
    and, when GRADED, the winners. Guests get "Log in to submit"; signed-in students get "Submit an entry" while
    the competition is ONGOING. No entry texts and no evaluations are shown (role matrix §2.3).
    Minimal version created by BE2 (BE2-11); FE2 builds the real design in FE2-08.
*@
@using InstituteOfFineArts.Web.Helpers
@using InstituteOfFineArts.Web.Models.Enums
@{
    ViewData["Title"] = Model.Title;
    var isGuest = User.Identity?.IsAuthenticated != true;
    var isStudent = User.IsInRole(RoleNames.Student);
}

<partial name="_Alerts" />

<div class="mb-3">
    <h1 class="h3 mb-1">@Model.Title</h1>
    <div class="text-muted">@Model.Code · <partial name="_Status" model="Model.Status" /></div>
</div>

@if (Model.HasCover)
{
    <img src="/files/competitions/@Model.Id/cover" alt="Cover of @Model.Title" class="img-fluid rounded mb-3" style="max-height:280px" />
}

<dl class="row">
    <dt class="col-sm-3">Start date</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Submission deadline</dt>
    <dd class="col-sm-9">@Model.EndDate.ToString("dd MMM yyyy"), 23:59:59</dd>
    <dt class="col-sm-3">Entries</dt>
    <dd class="col-sm-9">@Model.SubmissionCount</dd>
</dl>

@* How to take part: guests log in first, students submit while ONGOING (BR-13) *@
@if (Model.Status == CompetitionStatus.ONGOING)
{
    <div class="card mb-4">
        <div class="card-body">
            @if (isGuest)
            {
                <p>Students of the institute can submit one painting to this competition.</p>
                <a href="/login?returnUrl=/student/competitions/@Model.Id" class="btn btn-primary">Log in to submit</a>
            }
            else if (isStudent)
            {
                <a href="/student/submissions/new?competitionId=@Model.Id" class="btn btn-primary">Submit an entry</a>
                <a href="/student/competitions/@Model.Id" class="btn btn-link">My entry for this competition</a>
            }
            else
            {
                <p class="mb-0 text-muted">This competition is open for student entries.</p>
            }
        </div>
    </div>
}
else if (Model.Status == CompetitionStatus.UPCOMING)
{
    <p class="text-muted">Entries open on @Model.StartDate.ToString("dd MMM yyyy").</p>
}

@* white-space: pre-line keeps the line breaks typed by staff; Razor still encodes the text (no HTML/XSS) *@
<h2 class="h5">Description</h2>
<p style="white-space: pre-line">@(Model.Description ?? "–")</p>

<h2 class="h5">Rules &amp; conditions</h2>
<p style="white-space: pre-line">@(Model.Rules ?? "–")</p>

<h2 class="h5">Awards</h2>
@if (Model.Awards.Count == 0)
{
    <p class="text-muted">Awards will be announced soon.</p>
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Rank</th><th>Award</th><th class="text-end">Prize</th><th class="text-end">Quantity</th><th>Description</th></tr></thead>
        <tbody>
            @foreach (var a in Model.Awards)
            {
                <tr>
                    <td>@a.Rank</td>
                    <td>@a.Name</td>
                    <td class="text-end">@a.PrizeValue.ToString("$#,##0.00")</td>
                    <td class="text-end">@a.Quantity</td>
                    <td>@a.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

@* Winners only once the results are published (US-02 AC4) *@
@if (Model.Status == CompetitionStatus.GRADED)
{
    <h2 class="h5 mt-4">Winners</h2>
    @if (Model.ResultRemarks != null)
    {
        <p style="white-space: pre-line">@Model.ResultRemarks</p>
    }
    @if (Model.Winners.Count == 0)
    {
        <p class="text-muted">No awards were issued in this competition.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var w in Model.Winners)
            {
                <div class="col-6 col-md-3">
                    <div class="card h-100">
                        @if (w.HasThumbnail)
                        {
                            <img src="/files/submissions/@w.SubmissionId/thumb" alt="@w.ArtworkTitle" class="card-img-top" />
                        }
                        <div class="card-body p-2">
                            <div class="small"><span class="badge bg-success">@w.AwardName</span></div>
                            <div class="fw-semibold">“@w.ArtworkTitle”</div>
                            <div class="small text-muted">@w.StudentName</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<a asp-action="Index" class="btn btn-link px-0 mt-3">Back to competitions</a>
