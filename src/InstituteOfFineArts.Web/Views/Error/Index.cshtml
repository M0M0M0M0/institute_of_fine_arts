@model InstituteOfFineArts.Web.ViewModels.Common.ErrorVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<InstituteOfFineArts.Web.SharedResource> L
@*
    Friendly error page (/error/{code}) – 403, 404, 413, 500…
    Created by BE1; styled by QA-03: the status number in Didone as the page's subject, one sentence, a way home.
    Texts come from ErrorController.Describe (kept).
*@
@{
    ViewData["Title"] = L[Model.Title].Value;
}

<div class="error-page">
    <p class="error-code" aria-hidden="true">@Model.StatusCode</p>
    <h1>@L[Model.Title]</h1>
    <p class="mb-4">@L[Model.Message]</p>

    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a href="/" class="btn btn-primary btn-lg"><i class="bi bi-house" aria-hidden="true"></i>@L["Go to the home page"]</a>
        @if (Model.StatusCode == 403 && User.Identity?.IsAuthenticated == true)
        {
            <a href="/profile" class="btn btn-outline-primary btn-lg">@L["My profile"]</a>
        }
        @if (Model.StatusCode == 401)
        {
            <a href="/login" class="btn btn-outline-primary btn-lg">@L["Log in"]</a>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small text-muted mt-5">@L["Request ID:"] <code>@Model.RequestId</code></p>
    }

    @* Development only: the exception text (never filled in Production) *@
    @if (!string.IsNullOrEmpty(Model.DeveloperDetails))
    {
        <pre class="text-start small bg-light border p-3 mt-3 overflow-auto">@Model.DeveloperDetails</pre>
    }
</div>
