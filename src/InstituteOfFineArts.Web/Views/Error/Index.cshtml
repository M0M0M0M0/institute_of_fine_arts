@model InstituteOfFineArts.Web.ViewModels.Common.ErrorVm
@*
    Friendly error page (/error/{code}) – 403, 404, 413, 500…
    Minimal version created by BE1; FE can restyle it (keep the texts from ErrorController.Describe).
*@
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center text-center py-5">
    <div class="col-md-8">
        <p class="display-4 text-muted mb-2">@Model.StatusCode</p>
        <h1 class="h3 mb-3">@Model.Title</h1>
        <p class="mb-4">@Model.Message</p>

        <a href="/" class="btn btn-primary">Go to the home page</a>
        @if (Model.StatusCode == 403 && User.Identity?.IsAuthenticated == true)
        {
            <a href="/profile" class="btn btn-outline-secondary ms-2">My profile</a>
        }
        @if (Model.StatusCode == 401)
        {
            <a href="/login" class="btn btn-outline-secondary ms-2">Log in</a>
        }

        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="small text-muted mt-4">Request ID: <code>@Model.RequestId</code></p>
        }

        @* Development only: the exception text (never filled in Production) *@
        @if (!string.IsNullOrEmpty(Model.DeveloperDetails))
        {
            <pre class="text-start small bg-light border p-3 mt-3 overflow-auto">@Model.DeveloperDetails</pre>
        }
    </div>
</div>
