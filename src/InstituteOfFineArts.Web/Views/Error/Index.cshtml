@model InstituteOfFineArts.Web.ViewModels.Common.ErrorVm

@{
    ViewData["Title"] = $"{Model.StatusCode} - {Model.Title}";

    // Select a visual style based on the HTTP status code.
    var accentText = Model.StatusCode switch
    {
        >= 500 => "text-danger",
        403 => "text-warning-emphasis",
        _ => "text-primary"
    };

    var accentBorder = Model.StatusCode switch
    {
        >= 500 => "border-danger bg-danger-subtle",
        403 => "border-warning bg-warning-subtle",
        _ => "border-primary bg-primary-subtle"
    };
}

@* Shared error page for 400–599 HTTP status codes. *@

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-9 col-lg-7 col-xl-6">

        <div class="card border-0 shadow-sm">
            <div class="card-body text-center p-4 p-md-5">

                @* Display the HTTP status code. *@
                <div class="d-inline-flex align-items-center justify-content-center
                    rounded-circle border border-4 mb-4 @accentBorder"
                     style="width: 140px; height: 140px;">

                    <span class="display-4 fw-bold @accentText">
                        @Model.StatusCode
                    </span>
                </div>

                <p class="small fw-semibold text-uppercase text-muted mb-2">
                    HTTP Error
                </p>

                <h1 class="h2 fw-bold mb-3">
                    @Model.Title
                </h1>

                <p class="text-muted mb-4">
                    @Model.Message
                </p>

                @* Navigation buttons. *@
                <div class="d-flex flex-wrap justify-content-center gap-2">

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-area=""
                       class="btn btn-primary px-4">
                        Back to Home
                    </a>

                    @if (Model.StatusCode == 403
                         && User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/profile"
                           class="btn btn-outline-secondary px-4">
                            My Profile
                        </a>
                    }

                    @if (Model.StatusCode == 401)
                    {
                        <a href="/login"
                           class="btn btn-outline-secondary px-4">
                            Log In
                        </a>
                    }

                </div>

                @* Display request ID for troubleshooting. *@
                @if (!string.IsNullOrEmpty(Model.RequestId))
                {
                    <p class="small text-muted mt-4 mb-0">
                        Request ID:
                        <code>@Model.RequestId</code>
                    </p>
                }

                @* Developer details are only provided in Development. *@
                @if (!string.IsNullOrEmpty(Model.DeveloperDetails))
                {
                    <details class="text-start mt-4">
                        <summary class="text-muted small">
                            Developer Details
                        </summary>

                        <pre class="small bg-light border rounded p-3 mt-2 overflow-auto">@Model.DeveloperDetails</pre>
                    </details>
                }

            </div>
        </div>

    </div>
</div>
