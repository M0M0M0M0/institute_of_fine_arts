@model InstituteOfFineArts.Web.ViewModels.Reports.ExhibitionSalesReportVm?
@*
    RPT-04 Exhibition artworks & sales revenue (/reports/rpt-04, SCR-33; F-M10-04, F-M10-08; TC-M10-05). STAFF, MANAGER.
    Created by BE2-12; styled by FE2-09 / QA-07 (page head with pills, filters bar, print summary, ledger, totals, A4 landscape print).
*@
@using InstituteOfFineArts.Web.Helpers
@using InstituteOfFineArts.Web.Models.Enums
@using InstituteOfFineArts.Web.Services.Implementations
@using InstituteOfFineArts.Web.ViewModels.Reports
@using InstituteOfFineArts.Web.ViewModels.Staff.ExhibitionEntries
@{
    ViewData["Title"] = "RPT-04 Exhibition artworks & sales";
    var search = (ExhibitionSalesSearchVm)ViewBag.Search;
    var exhibitions = (List<EntryExhibitionOptionVm>)ViewBag.Exhibitions;
    var exhibitionName = exhibitions.FirstOrDefault(x => x.Id == search.ExhibitionId)?.Name ?? "All exhibitions";
}

<div class="report-page">
<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/reports">All reports</a></li>
                <li class="breadcrumb-item active" aria-current="page">RPT-04</li>
            </ol>
        </nav>
        <h1>RPT-04 Exhibition artworks &amp; sales revenue</h1>
        <p class="page-sub">Paintings sent to exhibitions, what sold, and what has been paid to the students.</p>
    </div>
    <div class="page-actions d-print-none">
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer" aria-hidden="true"></i>Print</button>
        <partial name="~/Views/Reports/_ExportButtons.cshtml" model='"/reports/rpt-04"' />
    </div>
</div>
<partial name="_Alerts" />

@* Filters: hidden when printing, replaced by a one-line summary *@
<form method="get" asp-action="Rpt04" class="filters d-print-none">
    <div asp-validation-summary="All" class="text-danger w-100"></div>
    <div class="filter">
        <label class="form-label" for="ExhibitionId">Exhibition</label>
        <select class="form-select" id="ExhibitionId" name="ExhibitionId">
            <option value="">All exhibitions</option>
            @foreach (var x in exhibitions)
            {
                <option value="@x.Id" selected="@(search.ExhibitionId == x.Id)">@x.Name (@x.StartDate.ToString("dd MMM yyyy"))</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="From">Exhibition period from</label>
        <input class="form-control" type="date" id="From" name="From" value="@search.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="To">to</label>
        <input class="form-control" type="date" id="To" name="To" value="@search.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="Status">Entry status</label>
        <select class="form-select" id="Status" name="Status">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<EntryStatus>())
            {
                <option value="@s" selected="@(search.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="Student">Student name or code</label>
        <input class="form-control" id="Student" name="Student" value="@search.Student" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i>View</button>
        <a href="/reports/rpt-04" class="btn btn-link">Clear</a>
    </div>
</form>

<dl class="criteria d-none d-print-flex">
    <div><dt>Exhibition</dt><dd>@exhibitionName</dd></div>
    <div><dt>Period</dt><dd>@(search.From?.ToString("dd MMM yyyy") ?? "…") – @(search.To?.ToString("dd MMM yyyy") ?? "…")</dd></div>
    <div><dt>Status</dt><dd>@(search.Status?.ToString() ?? "all")</dd></div>
    <div><dt>Student</dt><dd>@(string.IsNullOrWhiteSpace(search.Student) ? "all" : search.Student)</dd></div>
    <div><dt>Printed</dt><dd>@DateTimeHelper.Now.ToString("dd MMM yyyy HH:mm")</dd></div>
</dl>

@if (Model == null)
{
    // Invalid filters: the error is shown above
}
else if (Model.Totals.Entries == 0)
{
    <div class="empty">
        <i class="bi bi-inbox" aria-hidden="true"></i>
        <p>No data</p>
    </div>
}
else
{
    var t = Model.Totals;
    if (Model.Truncated)
    {
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div>Only the first @ExhibitionReportService.MaxRows rows are shown; the totals include every matching painting. Narrow the filters to see all rows.</div></div>
    }
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th class="text-end">#</th><th>Exhibition</th><th>Painting</th><th>Student</th><th>Rating</th><th class="text-end">Asking price</th>
                    <th>Status</th><th class="text-end">Sold price</th><th class="text-end">Sold date</th><th>Customer</th><th>Paid to student</th>
                    <th class="text-end">Amount paid</th><th class="text-end">Paid date</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Rows.Count; i++)
                {
                    var r = Model.Rows[i];
                    <tr>
                        <td class="text-end">@(i + 1)</td>
                        <td>@r.ExhibitionName</td>
                        <td>@r.Title</td>
                        <td>@r.StudentName <span class="text-muted small">@r.StudentCode</span></td>
                        <td>@if (r.Rating is { } rating) { <span class="tag tag-@rating">@rating</span> } else { <text>–</text> }</td>
                        <td class="text-end">@r.AskingPrice.ToString("$#,##0.00")</td>
                        <td><partial name="_Status" model="r.Status" /></td>
                        <td class="text-end">@(r.SoldPrice?.ToString("$#,##0.00") ?? "–")</td>
                        <td class="text-end text-nowrap">@(r.SoldDate?.ToString("dd MMM yyyy") ?? "–")</td>
                        <td>@(r.CustomerName ?? "–")</td>
                        <td>@if (r.Status == EntryStatus.SOLD) { if (r.PaidToStudent) { <span class="tag tag-PAID">Yes</span> } else { <span class="tag tag-UNPAID">No</span> } } else { <text>–</text> }</td>
                        <td class="text-end">@(r.PaidAmount?.ToString("$#,##0.00") ?? "–")</td>
                        <td class="text-end text-nowrap">@(r.PaidDate?.ToString("dd MMM yyyy") ?? "–")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Totals of §7 over every matching painting (TC-M10-05) *@
    <section class="section">
        <div class="section-head"><h2>Totals</h2></div>
        <table class="table table-sm table-totals">
            <tbody>
                <tr><th>Matching entries</th><td class="text-end">@t.Entries</td></tr>
                <tr><th>Paintings sent (accepted, sold, unsold)</th><td class="text-end">@t.Sent</td></tr>
                <tr><th>Sold</th><td class="text-end">@t.Sold</td></tr>
                <tr><th>Not sold (on show or unsold)</th><td class="text-end">@t.Unsold</td></tr>
                <tr><th>Total asking price (sent paintings)</th><td class="text-end">@t.TotalAskingPrice.ToString("$#,##0.00")</td></tr>
                <tr><th>Total sold price (revenue)</th><td class="text-end">@t.TotalSoldPrice.ToString("$#,##0.00")</td></tr>
                <tr><th>Asking price of the sold paintings</th><td class="text-end">@t.SoldAskingPrice.ToString("$#,##0.00")</td></tr>
                <tr><th>Difference (sold price − asking price of the sold paintings)</th><td class="text-end">@t.Difference.ToString("$#,##0.00")</td></tr>
                <tr><th>Paid to students</th><td class="text-end">@t.PaidCount painting(s) · @t.PaidAmount.ToString("$#,##0.00")</td></tr>
                <tr><th>Not paid to students yet</th><td class="text-end">@t.UnpaidCount painting(s) · @t.UnpaidAmount.ToString("$#,##0.00")</td></tr>
            </tbody>
        </table>
    </section>
    <p class="text-muted small">@Model.Rows.Count row(s) shown.</p>
}
</div>
