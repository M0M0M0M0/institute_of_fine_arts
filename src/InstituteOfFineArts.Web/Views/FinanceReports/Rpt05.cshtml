@model InstituteOfFineArts.Web.ViewModels.Reports.StudentDebtReportVm?
@*
    RPT-05 Money owed to students (/reports/rpt-05, SCR-33; F-M10-05, F-M10-08; BR-45): sold paintings not paid yet. STAFF, MANAGER.
    Minimal version created by BE2 (BE2-12); FE2 builds the real design in FE2-09.
*@
@using InstituteOfFineArts.Web.Helpers
@using InstituteOfFineArts.Web.Services.Implementations
@using InstituteOfFineArts.Web.ViewModels.Reports
@using InstituteOfFineArts.Web.ViewModels.Staff.ExhibitionEntries
@{
    ViewData["Title"] = "RPT-05 Money owed to students";
    var search = (StudentDebtSearchVm)ViewBag.Search;
    var exhibitions = (List<EntryExhibitionOptionVm>)ViewBag.Exhibitions;
    var exhibitionName = exhibitions.FirstOrDefault(x => x.Id == search.ExhibitionId)?.Name ?? "All exhibitions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">RPT-05 Money owed to students</h1>
    <div class="d-print-none">
        <a href="/reports" class="btn btn-outline-secondary">All reports</a>
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">Print</button>
        <partial name="~/Views/Reports/_ExportButtons.cshtml" model='"/reports/rpt-05"' />
    </div>
</div>
<partial name="_Alerts" />

@* Filters: hidden when printing, replaced by a one-line summary *@
<form method="get" asp-action="Rpt05" class="row g-2 align-items-end mb-3 d-print-none">
    <div asp-validation-summary="All" class="text-danger col-12"></div>
    <div class="col-md-3">
        <label class="form-label" for="ExhibitionId">Exhibition</label>
        <select class="form-select" id="ExhibitionId" name="ExhibitionId">
            <option value="">All exhibitions</option>
            @foreach (var x in exhibitions)
            {
                <option value="@x.Id" selected="@(search.ExhibitionId == x.Id)">@x.Name (@x.StartDate.ToString("dd MMM yyyy"))</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="Student">Student name or code</label>
        <input class="form-control" id="Student" name="Student" value="@search.Student" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="From">Sold from</label>
        <input class="form-control" type="date" id="From" name="From" value="@search.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="To">Sold to</label>
        <input class="form-control" type="date" id="To" name="To" value="@search.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">View</button>
    </div>
</form>

<p class="d-none d-print-block small">
    @exhibitionName · sold @(search.From?.ToString("dd MMM yyyy") ?? "…") – @(search.To?.ToString("dd MMM yyyy") ?? "…")
    · student @(string.IsNullOrWhiteSpace(search.Student) ? "all" : search.Student)
    · printed @DateTimeHelper.Now.ToString("dd MMM yyyy HH:mm")
</p>

@if (Model == null)
{
    // Invalid filters: the error is shown above
}
else if (Model.Count == 0)
{
    <p class="text-muted">No data</p>
}
else
{
    if (Model.Truncated)
    {
        <div class="alert alert-warning">Only the first @ExhibitionReportService.MaxRows rows are shown; the total includes every matching painting. Narrow the filters to see all rows.</div>
    }
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th><th>Student</th><th>Student code</th><th>Painting</th><th>Exhibition</th><th>Sold date</th>
                    <th class="text-end">Sold price</th><th class="text-end">Days unpaid</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Rows.Count; i++)
                {
                    var r = Model.Rows[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@r.StudentName</td>
                        <td>@r.StudentCode</td>
                        <td>@r.Title</td>
                        <td>@r.ExhibitionName</td>
                        <td>@r.SoldDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end">@r.SoldPrice.ToString("$#,##0.00")</td>
                        <td class="text-end">@r.DaysUnpaid</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @* Total of §7 over every matching painting *@
                <tr class="fw-bold">
                    <td colspan="6">Total unpaid (@Model.Count painting(s))</td>
                    <td class="text-end">@Model.TotalUnpaid.ToString("$#,##0.00")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <p class="text-muted small">@Model.Rows.Count row(s) shown.</p>
}
