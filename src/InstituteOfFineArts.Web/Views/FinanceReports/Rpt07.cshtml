@model InstituteOfFineArts.Web.ViewModels.Reports.AccountStatisticsReportVm
@*
    RPT-07 Account statistics (/reports/rpt-07, SCR-33; F-M10-07, F-M10-08): accounts per role and status, students per
    course / class and enrollment status. ADMIN, MANAGER.
    Minimal version created by BE2 (BE2-12); FE2 builds the real design in FE2-09.
*@
@using InstituteOfFineArts.Web.Helpers
@using InstituteOfFineArts.Web.Models.Enums
@using InstituteOfFineArts.Web.ViewModels.Reports
@{
    ViewData["Title"] = "RPT-07 Account statistics";
    var search = (AccountStatisticsSearchVm)ViewBag.Search;
    var statuses = Enum.GetValues<EnrollmentStatus>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">RPT-07 Account statistics</h1>
    <div class="d-print-none">
        <a href="/reports" class="btn btn-outline-secondary">All reports</a>
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">Print</button>
    </div>
</div>

@* Filters: hidden when printing, replaced by a one-line summary *@
<form method="get" asp-action="Rpt07" class="row g-2 align-items-end mb-3 d-print-none">
    <div class="col-md-3">
        <label class="form-label" for="Role">Role</label>
        <select class="form-select" id="Role" name="Role">
            <option value="">All roles</option>
            @foreach (var r in Enum.GetValues<Role>())
            {
                <option value="@r" selected="@(search.Role == r)">@r</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="Active">Account status</label>
        <select class="form-select" id="Active" name="Active">
            <option value="">Active and inactive</option>
            <option value="true" selected="@(search.Active == true)">Active</option>
            <option value="false" selected="@(search.Active == false)">Inactive (locked)</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="ClassOrCourse">Class or course</label>
        <input class="form-control" id="ClassOrCourse" name="ClassOrCourse" value="@search.ClassOrCourse" placeholder="e.g. Painting" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">View</button>
    </div>
</form>

<p class="d-none d-print-block small">
    Role @(search.Role?.ToString() ?? "all") · status @(search.Active switch { true => "active", false => "inactive", _ => "all" })
    · class / course @(string.IsNullOrWhiteSpace(search.ClassOrCourse) ? "all" : search.ClassOrCourse)
    · printed @DateTimeHelper.Now.ToString("dd MMM yyyy HH:mm")
</p>

<h2 class="h5">Accounts per role</h2>
@if (Model.TotalAccounts == 0)
{
    <p class="text-muted">No data</p>
}
else
{
    <table class="table table-sm table-bordered w-auto">
        <thead class="table-light">
            <tr><th>Role</th><th class="text-end">Active</th><th class="text-end">Inactive</th><th class="text-end">Total</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Roles)
            {
                <tr>
                    <td>@r.Role</td>
                    <td class="text-end">@r.Active</td>
                    <td class="text-end">@r.Inactive</td>
                    <td class="text-end">@r.Total</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td>Total</td>
                <td class="text-end">@Model.TotalActive</td>
                <td class="text-end">@Model.TotalInactive</td>
                <td class="text-end">@Model.TotalAccounts</td>
            </tr>
        </tfoot>
    </table>
}

@* Students per course / class: only when students are part of the selection *@
@if (Model.ShowStudents)
{
    <h2 class="h5 mt-4">Students per course and class</h2>
    if (Model.Classes.Count == 0)
    {
        <p class="text-muted">No data</p>
    }
    else
    {
        var totals = Model.StudentsByStatus;
        <div class="table-responsive">
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Course</th><th>Class</th>
                        @foreach (var s in statuses)
                        {
                            <th class="text-end">@s</th>
                        }
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Classes)
                    {
                        <tr>
                            <td>@c.CourseName</td>
                            <td>@(c.ClassName ?? "–")</td>
                            @foreach (var s in statuses)
                            {
                                <td class="text-end">@c.ByStatus[s]</td>
                            }
                            <td class="text-end">@c.Total</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="2">Total</td>
                        @foreach (var s in statuses)
                        {
                            <td class="text-end">@totals[s]</td>
                        }
                        <td class="text-end">@Model.TotalStudents</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <p class="text-muted small">@Model.Classes.Count course / class row(s).</p>
    }
}
