@*
    Public "About us" page (/about, SCR-06, F-M02-08): static information about the institute and how to contact it.
    Created by BE2 (BE2-11); styled by QA-05 / FE2-08 as a read-mode page: Didone headings, a comfortable measure,
    taking part and contact on the stone band.
*@
@{
    ViewData["Title"] = "About us";
    ViewData["FullBleed"] = true;
}

<section class="band">
    <div class="band-inner read">
        <h1>About the Institute of Fine Arts</h1>
        <p>
            The Institute of Fine Arts teaches drawing and painting to students of every age. Our teachers organise
            painting competitions throughout the year; the best paintings receive awards and are shown at exhibitions
            across the country, where visitors can also buy them.
        </p>
    </div>
</section>

<section class="band band-stone">
    <div class="band-inner split-2">
        <div class="read">
            <h2>Take part</h2>
            <ul>
                <li>See the <a href="/competitions">competitions</a> that are open for entries or coming soon.</li>
                <li>Browse the <a href="/gallery">gallery</a> of awarded paintings.</li>
                <li>Students <a href="/login">log in</a> to submit their paintings and see their results.</li>
            </ul>
        </div>
        <div class="read">
            <h2>Contact</h2>
            <p>
                For enrolment, competitions or buying a painting shown at an exhibition, contact the institute office.
                Students can also ask their teachers during classes.
            </p>
        </div>
    </div>
</section>
