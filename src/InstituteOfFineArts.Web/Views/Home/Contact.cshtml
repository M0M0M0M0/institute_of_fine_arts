@{
    ViewData["Title"] = "Contact Us";
}

<div class="container my-5 py-3">
    <!-- Header tiêu đề -->
    <div class="text-center mb-5">
        <h1 class="art-title display-5 mb-3">Get in Touch</h1>
        <p class="text-muted">We would love to welcome you to our gallery or assist with your art collection inquiries.</p>
    </div>

    <div class="row g-5 align-items-stretch">

        <!-- CỘT TRÁI: THÔNG TIN LIÊN HỆ -->
        <div class="col-lg-5 d-flex flex-column justify-content-between">
            <div>
                <h3 class="art-title mb-4">Gallery Location & Info</h3>

                <!-- Địa chỉ -->
                <div class="d-flex mb-4">
                    <div class="me-3 fs-4 text-dark">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-uppercase" style="letter-spacing: 0.5px;">Address</h6>
                        <p class="text-muted small mb-0 lh-base">
                            Institute of Fine Arts<br>
                            42 Yet Kieu Street, Cua Nam, Hoan Kiem<br>
                            Hanoi, Vietnam
                        </p>
                    </div>
                </div>

                <!-- Số điện thoại -->
                <div class="d-flex mb-4">
                    <div class="me-3 fs-4 text-dark">
                        <i class="bi bi-telephone"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-uppercase" style="letter-spacing: 0.5px;">Phone</h6>
                        <p class="text-muted small mb-0">
                            <a href="tel:+842438221876" class="text-muted text-decoration-none">+84 (0) 24 3822 1876</a>
                        </p>
                    </div>
                </div>

                <!-- Email -->
                <div class="d-flex mb-4">
                    <div class="me-3 fs-4 text-dark">
                        <i class="bi bi-envelope"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-uppercase" style="letter-spacing: 0.5px;">Email</h6>
                        <p class="text-muted small mb-0">
                            <a href="mailto:info@@instituteoffinearts.com" class="text-muted text-decoration-none">info@@instituteoffinearts.com</a>
                        </p>
                    </div>
                </div>

                <!-- Giờ mở cửa -->
                <div class="d-flex mb-4">
                    <div class="me-3 fs-4 text-dark">
                        <i class="bi bi-clock"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-uppercase" style="letter-spacing: 0.5px;">Opening Hours</h6>
                        <p class="text-muted small mb-0 lh-base">
                            Monday – Friday: 9:00 AM – 6:00 PM<br>
                            Saturday – Sunday: 10:00 AM – 5:00 PM
                        </p>
                    </div>
                </div>
            </div>

            <!-- Ghi chú tư vấn -->
            <div class="p-4 bg-light border mt-3">
                <h6 class="fw-bold mb-2">Need an Art Consultation?</h6>
                <p class="small text-muted mb-0">
                    Our curators provide free 1-on-1 virtual or in-person advisory to help you find the perfect piece for your space.
                </p>
            </div>
        </div>

        <!-- CỘT PHẢI: NHÚNG BẢN ĐỒ GOOGLE MAPS -->
        <div class="col-lg-7">
            <div class="contact-map-wrapper h-100 border">
                <iframe class="w-100 h-100"
                        style="min-height: 450px; border: 0;"
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3724.1206126626683!2d105.84074217596956!3d21.027859887807755!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ab965cf45a19%3A0x67375a02476b7dbb!2zNDIgUC4gWeG6v3QgS2nDqnUsIEPhu61hIE5hbSwgSG_DoG4gS2nhur9tLCBIw6AgTuG7mWksIFZpZXRuYW0!5e0!3m2!1sen!2s!4v1715000000000!5m2!1sen!2s"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>

    </div>
</div>
