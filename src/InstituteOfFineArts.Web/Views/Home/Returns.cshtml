@{
    ViewData["Title"] = "Returns & Refunds";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="text-center mb-5">
        <h1 class="art-title display-5 mb-3">Returns & Refunds</h1>
        <p class="text-muted">Buy with confidence. 7-day satisfaction guaranteed.</p>
    </div>

    <div class="content-block text-muted lh-lg small">
        <h4 class="text-dark fw-normal mb-3">Our 7-Day Return Policy</h4>
        <p class="mb-4">
            We want you to love your new art. If a piece doesn't quite work in your space, you can return it within <strong>seven days</strong> of receiving your order, and we will issue you a full refund for the price of the art.
        </p>

        <h4 class="text-dark fw-normal mb-3">Return Requirements</h4>
        <ul class="mb-4">
            <li class="mb-2">Art must be returned in its <strong>original packaging</strong>.</li>
            <li class="mb-2">We will pay for return shipping on pieces measuring up to 50 inches on the longest side.</li>
            <li class="mb-2">For artwork longer than 50 inches, we will issue a refund minus a return shipping fee of $300.</li>
            <li class="mb-2">For international orders, you are responsible for the cost of return shipping and any customs fees.</li>
        </ul>

        <h4 class="text-dark fw-normal mb-3">Exceptions</h4>
        <p>
            At this time, there are no returns on commissioned special orders or artwork that has been custom-framed or altered at the request of the customer.
        </p>
    </div>
</div>
