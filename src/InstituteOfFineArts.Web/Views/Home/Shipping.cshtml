@{
    ViewData["Title"] = "Shipping Information";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="text-center mb-5">
        <h1 class="art-title display-5 mb-3">Shipping Information</h1>
        <p class="text-muted">Safe, secure, and fully insured delivery to your door.</p>
    </div>

    <div class="row g-5 mt-2">
        <div class="col-md-6">
            <h5 class="fw-bold mb-3"><i class="bi bi-box-seam me-2"></i> Custom Packaging</h5>
            <p class="text-muted small lh-lg">
                We package every artwork in a custom-built, heavy-duty cardboard art box lined with high-density foam. This ensures your one-of-a-kind original painting is fully protected against moisture and impact during transit.
            </p>
        </div>

        <div class="col-md-6">
            <h5 class="fw-bold mb-3"><i class="bi bi-shield-check me-2"></i> Fully Insured</h5>
            <p class="text-muted small lh-lg">
                Every shipment is fully insured by us. In the rare event that an artwork is damaged during shipping, we will handle the insurance claim and issue you a full refund immediately.
            </p>
        </div>

        <div class="col-md-6">
            <h5 class="fw-bold mb-3"><i class="bi bi-clock-history me-2"></i> Delivery Time</h5>
            <p class="text-muted small lh-lg">
                Artwork is shipped directly from the artist's studio. It typically takes 7 to 10 business days for your artwork to arrive. Once your order ships, we will email you a FedEx tracking number.
            </p>
        </div>

        <div class="col-md-6">
            <h5 class="fw-bold mb-3"><i class="bi bi-globe me-2"></i> International Shipping</h5>
            <p class="text-muted small lh-lg">
                We ship to over 50 countries worldwide. International shipping rates are calculated at checkout. Please note that buyers are responsible for any customs and import taxes that may apply in their country.
            </p>
        </div>
    </div>
</div>
