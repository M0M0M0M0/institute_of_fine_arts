@model InstituteOfFineArts.Web.ViewModels.Account.ForgotPasswordVm
@*
    Forgot password (/forgot-password) – F-M16-01, anyone (not signed in), in the FE101 sign-in frame
    (Views/Shared/_LayoutAuth.cshtml). Always answers with the same neutral message (no account enumeration).
*@
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Forgot password";
}

<h1 class="art-title fw-normal mb-2 h2">Forgot your password?</h1>
<p class="text-muted small mb-4">
    Enter your username or e-mail. If the account exists, we will e-mail you a link to set a new password.
</p>

@* Neutral "we have sent a link" message after the request *@
<partial name="_Alerts" />

<form asp-controller="PasswordReset" asp-action="ForgotPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="form-floating mb-4">
        <input asp-for="UserNameOrEmail" class="form-control auth-input shadow-none" placeholder=" "
               autocomplete="username" autofocus />
        <label asp-for="UserNameOrEmail" class="text-muted"></label>
        <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
    </div>

    <button class="btn btn-dark w-100 py-3 mb-4 rounded-0 auth-btn" type="submit">Send reset link</button>

    <p class="text-center small mb-0">
        <a asp-controller="Account" asp-action="Login" class="text-dark text-decoration-none border-bottom border-dark pb-1">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to sign in
        </a>
    </p>
</form>
