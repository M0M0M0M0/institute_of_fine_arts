@model InstituteOfFineArts.Web.ViewModels.Account.ForgotPasswordVm
@*
    Forgot password (/forgot-password) – F-M16-01, anyone (not signed in).
    Minimal version created by BE1-OPT so the feature works; FE builds the real design in FE1-OPT.
*@
@{
    ViewData["Title"] = "Forgot password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Forgot password</h1>
        <partial name="_Alerts" />

        <p class="text-muted">Enter your username or e-mail. If the account exists, we will e-mail you a link to set a new password.</p>

        <form asp-controller="PasswordReset" asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="UserNameOrEmail" class="form-label"></label>
                <input asp-for="UserNameOrEmail" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Send reset link</button>
            <a asp-controller="Account" asp-action="Login" class="btn btn-link">Back to log in</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
