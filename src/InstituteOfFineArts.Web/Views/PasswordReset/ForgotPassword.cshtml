@model InstituteOfFineArts.Web.ViewModels.Account.ForgotPasswordVm
@*
    Forgot password (/forgot-password) – F-M16-01, anyone (not signed in).
    Created by BE1-OPT; styled by FE1-OPT in the sign-in sheet style (white sheet on the mist band).
*@
@{
    ViewData["Title"] = "Forgot password";
    ViewData["FullBleed"] = true;
}

<section class="band band-mist auth-band">
    <div class="auth-sheet">
        <a class="wordmark" href="/" aria-label="Institute of Fine Arts – home"><partial name="_Wordmark" model="@("ink")" /></a>
        <h1>Forgot password</h1>
        <partial name="_Alerts" />

        <p class="text-muted">Enter your username or e-mail. If the account exists, we will e-mail you a link to set a new password.</p>

        <form asp-controller="PasswordReset" asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-4">
                <label asp-for="UserNameOrEmail" class="form-label"></label>
                <input asp-for="UserNameOrEmail" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Send reset link</button>
        </form>

        <p class="auth-foot">
            <a asp-controller="Account" asp-action="Login">Back to log in</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
