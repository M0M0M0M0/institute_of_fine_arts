@using InstituteOfFineArts.Web.Services.Implementations
@model InstituteOfFineArts.Web.ViewModels.Account.ResetPasswordVm
@*
    Set a new password (/reset-password?token=...) – F-M16-01, opened from the e-mail link.
    Created by BE1-OPT; styled by FE1-OPT in the sign-in sheet style (white sheet on the mist band).
*@
@{
    ViewData["Title"] = "Reset password";
    ViewData["FullBleed"] = true;
}

<section class="band band-mist auth-band">
    <div class="auth-sheet">
        <a class="wordmark" href="/" aria-label="Institute of Fine Arts – home"><partial name="_Wordmark" model="@("ink")" /></a>
        <h1>Reset password</h1>

        @if (!Model.TokenValid)
        {
            @* Unknown, used or expired link: no form, only a way to ask for a new one *@
            <div class="alert alert-danger" role="alert"><i class="bi bi-x-circle" aria-hidden="true"></i><div>@PasswordResetService.InvalidLinkMessage</div></div>
            <a asp-controller="PasswordReset" asp-action="ForgotPassword" class="btn btn-primary btn-lg w-100 mt-2">Request a new link</a>
        }
        else
        {
            <form asp-controller="PasswordReset" asp-action="ResetPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                    <div class="form-text">At least 8 characters, with at least one letter and one digit.</div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">Set new password</button>
            </form>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
