@using InstituteOfFineArts.Web.Services.Implementations
@model InstituteOfFineArts.Web.ViewModels.Account.ResetPasswordVm
@*
    Set a new password (/reset-password?token=...) – F-M16-01, opened from the e-mail link.
    Minimal version created by BE1-OPT so the feature works; FE builds the real design in FE1-OPT.
*@
@{
    ViewData["Title"] = "Reset password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Reset password</h1>

        @if (!Model.TokenValid)
        {
            @* Unknown, used or expired link: no form, only a way to ask for a new one *@
            <div class="alert alert-danger">@PasswordResetService.InvalidLinkMessage</div>
            <a asp-controller="PasswordReset" asp-action="ForgotPassword" class="btn btn-primary">Request a new link</a>
        }
        else
        {
            <form asp-controller="PasswordReset" asp-action="ResetPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                    <div class="form-text">At least 8 characters, with at least one letter and one digit.</div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Set new password</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
