@using InstituteOfFineArts.Web.Services.Implementations
@model InstituteOfFineArts.Web.ViewModels.Account.ResetPasswordVm
@*
    Set a new password (/reset-password?token=...) – F-M16-01, opened from the button in the reset e-mail, in the
    FE101 sign-in frame (Views/Shared/_LayoutAuth.cshtml). Every request e-mails its own random link: valid for 30
    minutes, works once, and a newer request makes older links stop working (PasswordResetService).
    The rules of BR-02 are ticked off while typing; the server checks them again.
*@
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Set a new password";
    var minutes = (int)PasswordResetService.TokenLifetime.TotalMinutes;
}

@if (!Model.TokenValid)
{
    @* Unknown, used or expired link: no form, only a way to ask for a new one *@
    <h1 class="art-title fw-normal mb-2 h2">This link no longer works</h1>
    <p class="text-muted small mb-4">
        A reset link can be used once and only for @minutes minutes, and asking for a new one replaces the older links.
    </p>
    <div class="alert alert-danger small" role="alert">@PasswordResetService.InvalidLinkMessage</div>
    <a asp-controller="PasswordReset" asp-action="ForgotPassword" class="btn btn-dark w-100 py-3 mb-4 rounded-0 auth-btn">
        Send me a new link
    </a>
    <p class="text-center small mb-0">
        <a asp-controller="Account" asp-action="Login" class="text-dark text-decoration-none border-bottom border-dark pb-1">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to sign in
        </a>
    </p>
}
else
{
    <h1 class="art-title fw-normal mb-2 h2">Set a new password</h1>
    <p class="text-muted small mb-4">Choose a new password for your account. After saving, sign in with it.</p>

    <form asp-controller="PasswordReset" asp-action="ResetPassword" method="post" novalidate id="reset-form">
        @* Expired / used link or locked account found while saving *@
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <input type="hidden" asp-for="Token" />

        <div class="form-floating mb-2 position-relative">
            <input asp-for="NewPassword" class="form-control auth-input shadow-none pe-5" placeholder=" "
                   autocomplete="new-password" autofocus />
            <label asp-for="NewPassword" class="text-muted"></label>
            <button type="button" class="btn btn-link text-muted position-absolute top-50 end-0 translate-middle-y me-1 auth-reveal"
                    data-reveal="NewPassword" aria-label="Show password" aria-pressed="false">
                <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="text-danger small d-block mb-2"></span>

        @* BR-02, ticked off while typing (the server checks again) *@
        <ul class="list-unstyled small mb-3 auth-rules" aria-live="polite">
            <li data-rule="length"><i class="bi bi-circle me-1" aria-hidden="true"></i>At least 8 characters</li>
            <li data-rule="letter"><i class="bi bi-circle me-1" aria-hidden="true"></i>At least one letter</li>
            <li data-rule="digit"><i class="bi bi-circle me-1" aria-hidden="true"></i>At least one digit</li>
        </ul>

        <div class="form-floating mb-2 position-relative">
            <input asp-for="ConfirmPassword" class="form-control auth-input shadow-none pe-5" placeholder=" "
                   autocomplete="new-password" />
            <label asp-for="ConfirmPassword" class="text-muted"></label>
            <button type="button" class="btn btn-link text-muted position-absolute top-50 end-0 translate-middle-y me-1 auth-reveal"
                    data-reveal="ConfirmPassword" aria-label="Show password" aria-pressed="false">
                <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mb-2"></span>
        <p class="small mb-4 auth-match" aria-live="polite"></p>

        <button class="btn btn-dark w-100 py-3 mb-4 rounded-0 auth-btn" type="submit">Save new password</button>

        <p class="text-center small text-muted mb-0">This link works once and expires @minutes minutes after it was sent.</p>
    </form>
}

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('reset-form');
            if (!form) return;
            const pwd = document.getElementById('NewPassword');
            const confirm = document.getElementById('ConfirmPassword');
            const match = form.querySelector('.auth-match');
            const rules = {
                length: v => v.length >= 8,
                letter: v => /\p{L}/u.test(v),
                digit: v => /\d/.test(v),
            };

            function tick() {
                const v = pwd.value;
                form.querySelectorAll('.auth-rules li').forEach(li => {
                    const ok = rules[li.dataset.rule](v);
                    li.classList.toggle('text-success', ok);
                    li.classList.toggle('text-muted', !ok);
                    li.querySelector('i').className = (ok ? 'bi bi-check-circle-fill' : 'bi bi-circle') + ' me-1';
                });
                if (!confirm.value) {
                    match.textContent = '';
                } else if (confirm.value === v) {
                    match.className = 'small mb-4 auth-match text-success';
                    match.innerHTML = '<i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>The passwords match';
                } else {
                    match.className = 'small mb-4 auth-match text-danger';
                    match.innerHTML = '<i class="bi bi-x-circle me-1" aria-hidden="true"></i>The passwords do not match yet';
                }
            }
            pwd.addEventListener('input', tick);
            confirm.addEventListener('input', tick);
            tick();

            // Show / hide the typed password
            form.querySelectorAll('.auth-reveal').forEach(btn => btn.addEventListener('click', () => {
                const input = document.getElementById(btn.dataset.reveal);
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-pressed', String(show));
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            }));
        })();
    </script>
}
