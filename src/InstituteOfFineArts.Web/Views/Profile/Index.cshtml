@model InstituteOfFineArts.Web.ViewModels.Profile.ProfileVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<InstituteOfFineArts.Web.SharedResource> L
@*
    My profile (/profile) – every signed-in role.
    Created by BE1; styled by FE1-02: page head, account details as a dl.details list, contact details in a form sheet.
    Only Phone and Address are posted; the other fields are display-only.
*@
@{
    ViewData["Title"] = L["My profile"].Value;
}

<div class="page-head">
    <div>
        <h1>@L["My profile"]</h1>
    </div>
    <div class="page-actions">
        <a asp-controller="Profile" asp-action="ChangePassword" class="btn btn-outline-primary"><i class="bi bi-key" aria-hidden="true"></i>@L["Change password"]</a>
    </div>
</div>
<div>
    <div>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i><div>@L[success]</div></div>
        }

        <dl class="details">
            <dt>@Html.DisplayNameFor(m => m.FullName)</dt>
            <dd>@Model.FullName</dd>

            <dt>@Html.DisplayNameFor(m => m.Username)</dt>
            <dd>@Model.Username</dd>

            <dt>@Html.DisplayNameFor(m => m.Role)</dt>
            <dd>@Model.Role</dd>

            <dt>@Html.DisplayNameFor(m => m.Email)</dt>
            <dd>@Model.Email</dd>

            @if (Model.Code != null)
            {
                <dt>@Html.DisplayNameFor(m => m.Code)</dt>
                <dd>@Model.Code</dd>
            }
            @if (Model.CourseOrPosition != null)
            {
                <dt>@L[Model.Role == InstituteOfFineArts.Web.Models.Enums.Role.STUDENT ? "Course" : "Position"]</dt>
                <dd>@Model.CourseOrPosition</dd>
            }
            @if (Model.Classes != null)
            {
                <dt>@Html.DisplayNameFor(m => m.Classes)</dt>
                <dd>@Model.Classes</dd>
            }
            @if (Model.Subjects != null)
            {
                <dt>@Html.DisplayNameFor(m => m.Subjects)</dt>
                <dd>@Model.Subjects</dd>
            }
            @if (Model.SinceDate is { } since)
            {
                <dt>@L[Model.Role == InstituteOfFineArts.Web.Models.Enums.Role.STUDENT ? "Enrolled on" : "Joined on"]</dt>
                <dd>@since.ToString("dd MMM yyyy")</dd>
            }
            @if (Model.DateOfBirth is { } dob)
            {
                <dt>@Html.DisplayNameFor(m => m.DateOfBirth)</dt>
                <dd>@dob.ToString("dd MMM yyyy")</dd>
            }
            @if (Model.Gender != null)
            {
                <dt>@Html.DisplayNameFor(m => m.Gender)</dt>
                <dd>@Model.Gender</dd>
            }
            @if (Model.LastLoginAt is { } lastLogin)
            {
                <dt>@Html.DisplayNameFor(m => m.LastLoginAt)</dt>
                <dd>@lastLogin.ToString("dd MMM yyyy HH:mm")</dd>
            }
        </dl>

        <div class="section-head mt-5"><h2>@L["Contact details"]</h2></div>
        @* Posts only Phone and Address (EditProfileVm); asp-* adds the anti-forgery token *@
        <form asp-controller="Profile" asp-action="Index" method="post" novalidate class="form-sheet">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" autocomplete="tel" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" autocomplete="street-address" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@L["Save changes"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
