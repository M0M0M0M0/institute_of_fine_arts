@model IReadOnlyList<ReportLinkVm>
@*
    Report index (/reports, F-M10-08, US-14): only the reports the current role may open, with a one-line description.
    Minimal version created by BE2-12; FE builds the real design in FE2-09.
*@
@{
    ViewData["Title"] = "Reports";
}

<h1 class="h3 mb-3">Reports</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">No reports are available for your role.</p>
}
else
{
    <div class="list-group" id="report-list">
        @foreach (var report in Model)
        {
            <a href="@report.Url" class="list-group-item list-group-item-action">
                <div class="fw-semibold">@report.Code – @report.Title</div>
                <div class="small text-muted">@report.Description</div>
            </a>
        }
    </div>
}
