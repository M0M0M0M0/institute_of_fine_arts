@model IReadOnlyList<ReportLinkVm>
@*
    Report index (/reports, F-M10-08, US-14): only the reports the current role may open, with a one-line description.
    Created by BE2-12; styled by FE2-09 (a calm list with hairlines, no card grid).
*@
@{
    ViewData["Title"] = "Reports";
}

<div class="page-head">
    <div>
        <h1>Reports</h1>
        <p class="page-sub">Each report can be filtered, printed and exported to Excel or PDF.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty">
        <i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>
        <p>No reports are available for your role.</p>
    </div>
}
else
{
    <ul class="report-list" id="report-list">
        @foreach (var report in Model)
        {
            <li>
                <a href="@report.Url">
                    <span class="report-code">@report.Code</span>
                    <span class="report-title">@report.Title</span>
                    <span class="report-desc">@report.Description</span>
                </a>
            </li>
        }
    </ul>
}
