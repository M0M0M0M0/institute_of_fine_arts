@model Rpt01PageVm
@*
    RPT-01 – Submissions of one competition in a date range by rating (/reports/rpt-01; F-M10-01, the example of the
    assignment; TC-M10-01..04). Columns and totals of the BA doc §7. Read only; Print button.
    Created by BE2-12; styled by FE2-09 / QA-07 (page head with pills, filters bar, filter summary, ledger, totals, A4 landscape print).
*@
@{
    ViewData["Title"] = "RPT-01 Submissions by rating";
    var report = ReportCatalog.All.First(r => r.Code == "RPT-01");
    var filter = Model.Filter;
    var result = Model.Result;
    // Submission details page of the user's area (staff or manager)
    var detailsBase = User.IsInRole(RoleNames.Manager) ? "/manager/submissions/" : "/staff/submissions/";
    var ratingChoices = Enum.GetValues<Rating>().Select(r => (Value: r.ToString(), Text: r.ToString()))
        .Append((Value: Rpt01FilterVm.NotGraded, Text: "Not graded")).ToList();
}

<div class="report-page">
<partial name="_ReportHeader" model="report" />

<form method="get" action="/reports/rpt-01" class="filters d-print-none" id="report-filters">
    <div class="filter">
        <label class="form-label" for="CompetitionId">Competition *</label>
        <select class="form-select" id="CompetitionId" name="CompetitionId">
            <option value="">– Choose –</option>
            @foreach (var c in Model.Competitions)
            {
                <option value="@c.Id" selected="@(filter.CompetitionId == c.Id)">@c.Code – @c.Title</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="From">Submitted from</label>
        <input class="form-control" type="date" id="From" name="From" value="@filter.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="To">Submitted to</label>
        <input class="form-control" type="date" id="To" name="To" value="@filter.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="Ratings">Ratings</label>
        <select class="form-select" id="Ratings" name="Ratings" multiple size="4" aria-describedby="ratings-help">
            @foreach (var choice in ratingChoices)
            {
                <option value="@choice.Value" selected="@filter.Ratings.Contains(choice.Value)">@choice.Text</option>
            }
        </select>
        <div class="form-text" id="ratings-help">None selected = all.</div>
    </div>
    <div class="filter">
        <label class="form-label" for="ClassName">Class</label>
        <select class="form-select" id="ClassName" name="ClassName">
            <option value="">All classes</option>
            @foreach (var c in Model.Classes)
            {
                <option value="@c" selected="@(filter.ClassName == c)">@c</option>
            }
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i>View</button>
        <a href="/reports/rpt-01" class="btn btn-link">Clear</a>
    </div>
</form>

<div asp-validation-summary="All" class="text-danger mb-2" id="report-errors"></div>

@if (result != null)
{
    @* Filters as text, so the printed report says what it contains *@
    <dl class="criteria" id="report-criteria">
        <div><dt>Competition</dt><dd><strong>@result.CompetitionCode – @result.CompetitionTitle</strong></dd></div>
        <div><dt>Submitted</dt><dd>from @(filter.From?.ToString("dd MMM yyyy") ?? "the start") to @(filter.To?.ToString("dd MMM yyyy") ?? "now")</dd></div>
        <div><dt>Ratings</dt><dd>@(filter.Ratings.Count == 0 ? "all" : string.Join(", ", ratingChoices.Where(c => filter.Ratings.Contains(c.Value)).Select(c => c.Text)))</dd></div>
        <div><dt>Class</dt><dd>@(string.IsNullOrWhiteSpace(filter.ClassName) ? "all" : filter.ClassName)</dd></div>
    </dl>

    if (result.TotalCount == 0)
    {
        <div class="empty" id="no-data">
            <i class="bi bi-inbox" aria-hidden="true"></i>
            <p>No data</p>
        </div>
    }
    else
    {
        if (result.IsTruncated)
        {
            <partial name="_Truncated" model="result.TotalCount" />
        }
        <div class="table-responsive">
            <table class="table table-sm table-hover" id="report-table">
                <thead>
                    <tr>
                        <th class="text-end">No.</th>
                        <th>Student code</th>
                        <th>Full name</th>
                        <th>Class</th>
                        <th>Painting title</th>
                        <th class="text-end">Submitted</th>
                        <th class="text-end">Last modified</th>
                        <th>Rating</th>
                        <th>Evaluated by</th>
                        <th class="text-end">Evaluated on</th>
                        <th>Award</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in result.Rows)
                    {
                        <tr data-submission-id="@row.SubmissionId">
                            <td class="text-end">@row.No</td>
                            <td>@row.StudentCode</td>
                            <td>@row.StudentName</td>
                            <td>@row.ClassName</td>
                            <td><a href="@(detailsBase + row.SubmissionId)">@row.Title</a></td>
                            <td class="text-end text-nowrap">@row.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-end text-nowrap">@row.UpdatedAt?.ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="tag tag-@(row.Rating?.ToString() ?? Rpt01FilterVm.NotGraded)">@(row.Rating?.ToString() ?? "Not graded")</span></td>
                            <td>@row.EvaluatorName</td>
                            <td class="text-end text-nowrap">@row.EvaluatedAt?.ToString("dd MMM yyyy")</td>
                            <td>@(row.AwardName == null ? "No" : "Yes – " + row.AwardName)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* Totals of §7: total number of entries and the number per rating *@
    <h2 class="visually-hidden">Totals</h2>
    <table class="table table-sm table-totals" id="report-totals">
        <tbody>
            <tr><th>Total submissions</th><td class="text-end" data-total="ALL">@result.TotalCount</td></tr>
            @foreach (var r in Enum.GetValues<Rating>())
            {
                <tr><th>@r</th><td class="text-end" data-total="@r">@result.CountByRating[r]</td></tr>
            }
            <tr><th>Not graded</th><td class="text-end" data-total="@Rpt01FilterVm.NotGraded">@result.NotGradedCount</td></tr>
        </tbody>
    </table>
}
else if (ViewData.ModelState.IsValid)
{
    <div class="empty">
        <i class="bi bi-funnel" aria-hidden="true"></i>
        <p>Choose a competition and click View.</p>
    </div>
}
</div>
