@model string
@*
    "Export Excel" / "Export PDF" buttons of a report (F-M14-01): link to {report URL}/export?format=xlsx|pdf with the
    current filters of the page. Model = report URL, e.g. /reports/rpt-01. Hidden when printing.
    Created by BE2-OPT 1; styled by FE2-OPT (outline pills with icons).
*@
@using InstituteOfFineArts.Web.Services.Implementations
@{
    var exportPath = Model + "/export";
}
<a class="btn btn-outline-primary d-print-none" id="export-xlsx"
   href="@ReportExportService.HtmlReportUrl(exportPath, Context.Request.Query, "xlsx")"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i>Export Excel</a>
<a class="btn btn-outline-primary d-print-none" id="export-pdf"
   href="@ReportExportService.HtmlReportUrl(exportPath, Context.Request.Query, "pdf")"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>Export PDF</a>
