@model int
@* Warning shown when a report matched more rows than it displays (cap: CompetitionReportService.MaxRows). Created by BE2-12; styled by FE2-09. *@
<div class="alert alert-warning" id="rows-truncated">
    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
    <div>
        The result has @Model.ToString("#,##0") rows; only the first
        @InstituteOfFineArts.Web.Services.Implementations.CompetitionReportService.MaxRows.ToString("#,##0") are shown.
        Narrow the filters to see every row.
    </div>
</div>
