@model InstituteOfFineArts.Web.ViewModels.Staff.Exhibitions.ExhibitionDetailsVm
@*
    Exhibition details shared by /staff/exhibitions/{id} (SCR-29) and /manager/exhibitions/{id} (SCR-56):
    information, status, entry counts by status, edit / delete. ViewData["ArtworksUrl"] adds the "Artworks" link
    to the entry list of the area (/staff/exhibition-entries?exhibitionId={id} by BE1-12, /manager/... by BE2-13).
    Created by BE2-09; styled by FE2-07 (Didone name, entry counts as one ledger strip, dates and venue in dl.details).
    The paintings themselves hang on the "Artworks" page (wall-labelled grid); this view model carries only the counts.
*@
@{
    var artworksUrl = ViewData["ArtworksUrl"] as string;
}

<div class="page-head">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Exhibitions</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <h1>@Model.Name</h1>
        <p class="page-sub"><partial name="~/Views/Shared/Exhibitions/_ExhibitionStatus.cshtml" model="Model.Status" /> <span class="ms-1">@Model.Venue, @Model.City</span></p>
    </div>
    <div class="page-actions">
        @if (artworksUrl != null)
        {
            <a href="@artworksUrl" class="btn btn-primary"><i class="bi bi-easel2" aria-hidden="true"></i>Artworks</a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
        @if (Model.CanDelete)
        {
            @* POST with anti-forgery token; site.js asks for confirmation first *@
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this exhibition?" data-confirm-ok="Delete">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash" aria-hidden="true"></i>Delete</button>
            </form>
        }
    </div>
</div>

<partial name="_Alerts" />

@* Entry summary by status (read from exhibition_entry), one ledger strip *@
<section class="section mt-0" aria-labelledby="artworks-heading">
    <div class="section-head">
        <h2 id="artworks-heading">Artworks</h2>
        @if (artworksUrl != null && Model.TotalEntries > 0)
        {
            <a href="@artworksUrl">See the paintings on the wall</a>
        }
    </div>
    @if (Model.TotalEntries == 0)
    {
        <div class="empty">
            <i class="bi bi-easel2" aria-hidden="true"></i>
            <p>No artworks have been sent to this exhibition yet.</p>
            @if (artworksUrl != null)
            {
                <a href="@artworksUrl" class="btn btn-outline-primary">Artworks</a>
            }
        </div>
    }
    else
    {
        <dl class="ledger is-dense">
            <div><dt>Total</dt><dd>@Model.TotalEntries</dd></div>
            @foreach (var c in Model.EntryCounts)
            {
                <div><dt><span class="tag tag-@c.Status">@c.Status</span></dt><dd>@c.Count</dd></div>
            }
            <div><dt>Total sales</dt><dd class="money">@Model.SoldTotal.ToString("$#,##0.00")</dd></div>
        </dl>
        <p class="text-muted small">An exhibition that already has artworks cannot be deleted.</p>
    }
</section>

<section class="section" aria-labelledby="about-heading">
    <div class="section-head"><h2 id="about-heading">About the exhibition</h2></div>
    <dl class="details">
        <dt>Venue</dt>
        <dd>@Model.Venue</dd>
        <dt>City / province</dt>
        <dd>@Model.City</dd>
        <dt>Organizer</dt>
        <dd>@(Model.Organizer ?? "–")</dd>
        <dt>Dates</dt>
        <dd class="num">@Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy")</dd>
        <dt>Created by</dt>
        <dd>@Model.CreatedByName, @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
    </dl>

    @* .pre-line keeps the line breaks typed by staff; Razor still encodes the text (no HTML/XSS) *@
    <h3>Description</h3>
    <p class="pre-line">@(Model.Description ?? "–")</p>
</section>

<p class="mt-4"><a asp-action="Index" class="btn btn-link px-0"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to exhibitions</a></p>
