@model InstituteOfFineArts.Web.ViewModels.Staff.Exhibitions.ExhibitionDetailsVm
@*
    Exhibition details shared by /staff/exhibitions/{id} (SCR-29) and /manager/exhibitions/{id} (SCR-56):
    information, status, entry counts by status, edit / delete. ViewData["ArtworksUrl"] (Staff only) adds the
    "Artworks" link to the staff entry list (/staff/exhibition-entries?exhibitionId={id}, built by BE1-12).
    Minimal version created by BE2-09; FE2 builds the real design in FE2-07.
*@
@{
    var artworksUrl = ViewData["ArtworksUrl"] as string;
}

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Name</h1>
        <div class="text-muted">@Model.City · <partial name="~/Views/Shared/Exhibitions/_ExhibitionStatus.cshtml" model="Model.Status" /></div>
    </div>
    <div class="d-flex gap-2">
        @if (artworksUrl != null)
        {
            <a href="@artworksUrl" class="btn btn-outline-secondary">Artworks</a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
        @if (Model.CanDelete)
        {
            @* POST with anti-forgery token; the browser asks for confirmation first *@
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this exhibition?');">
                <button type="submit" class="btn btn-outline-danger">Delete</button>
            </form>
        }
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@Model.Venue</dd>
    <dt class="col-sm-3">City / province</dt>
    <dd class="col-sm-9">@Model.City</dd>
    <dt class="col-sm-3">Organizer</dt>
    <dd class="col-sm-9">@(Model.Organizer ?? "–")</dd>
    <dt class="col-sm-3">Dates</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Created by</dt>
    <dd class="col-sm-9">@Model.CreatedByName, @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
</dl>

@* white-space: pre-line keeps the line breaks typed by staff; Razor still encodes the text (no HTML/XSS) *@
<h2 class="h5">Description</h2>
<p style="white-space: pre-line">@(Model.Description ?? "–")</p>

@* Entry summary by status (read from exhibition_entry) *@
<h2 class="h5">Artworks</h2>
@if (Model.TotalEntries == 0)
{
    <p class="text-muted">No artworks have been sent to this exhibition yet.</p>
}
else
{
    <table class="table table-sm w-auto">
        <tbody>
            @foreach (var c in Model.EntryCounts)
            {
                <tr><td>@c.Status</td><td class="text-end">@c.Count</td></tr>
            }
            <tr class="fw-semibold"><td>Total</td><td class="text-end">@Model.TotalEntries</td></tr>
        </tbody>
    </table>
    <p>Total sales: @Model.SoldTotal.ToString("$#,##0.00")</p>
    <p class="text-muted small">An exhibition that already has artworks cannot be deleted.</p>
}

<a asp-action="Index" class="btn btn-link px-0">Back to exhibitions</a>
