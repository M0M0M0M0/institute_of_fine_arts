@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Staff.Exhibitions.ExhibitionListItemVm>
@*
    Exhibition list & search shared by /staff/exhibitions (SCR-29) and /manager/exhibitions (SCR-56).
    Links use the current area, so the same markup works in both. Filters come from ViewBag.Search.
    Minimal version created by BE2-09; FE2 builds the real design in FE2-07.
*@
@{
    var search = (InstituteOfFineArts.Web.ViewModels.Staff.Exhibitions.ExhibitionSearchVm)ViewBag.Search;
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new { search.Keyword, search.City, search.Status, From = search.From?.ToString("yyyy-MM-dd"), To = search.To?.ToString("yyyy-MM-dd"), page };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Exhibitions</h1>
    <a asp-action="Create" class="btn btn-primary">New exhibition</a>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label" for="Keyword">Name</label>
        <input class="form-control" id="Keyword" name="Keyword" value="@search.Keyword" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="City">City</label>
        <input class="form-control" id="City" name="City" value="@search.City" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="Status">Status</label>
        <select class="form-select" id="Status" name="Status">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<InstituteOfFineArts.Web.Models.Enums.ExhibitionStatus>())
            {
                <option value="@s" selected="@(search.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label" for="From">From</label>
        <input class="form-control" type="date" id="From" name="From" value="@search.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="To">To</label>
        <input class="form-control" type="date" id="To" name="To" value="@search.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
    </div>
</form>
@if (Model.TotalCount == 0)
{
    <p class="text-muted">No exhibitions found.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Name</th><th>City</th><th>Venue</th><th>Start</th><th>End</th><th>Status</th><th class="text-end">Artworks</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Items)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@e.Id">@e.Name</a></td>
                    <td>@e.City</td>
                    <td>@e.Venue</td>
                    <td>@e.StartDate.ToString("dd MMM yyyy")</td>
                    <td>@e.EndDate.ToString("dd MMM yyyy")</td>
                    <td><partial name="~/Views/Shared/Exhibitions/_ExhibitionStatus.cshtml" model="e.Status" /></td>
                    <td class="text-end">@e.EntryCount</td>
                </tr>
            }
        </tbody>
    </table>

    <nav class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">@Model.TotalCount exhibition(s) · page @Model.Page of @Model.TotalPages</span>
        <div>
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", PageRoute(Model.Page - 1))">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next</a>
            }
        </div>
    </nav>
}
