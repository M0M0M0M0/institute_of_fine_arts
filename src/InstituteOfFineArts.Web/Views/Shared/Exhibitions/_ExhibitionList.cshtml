@model InstituteOfFineArts.Web.ViewModels.Common.PagedResult<InstituteOfFineArts.Web.ViewModels.Staff.Exhibitions.ExhibitionListItemVm>
@*
    Exhibition list & search shared by /staff/exhibitions (SCR-29) and /manager/exhibitions (SCR-56).
    Links use the current area, so the same markup works in both. Filters come from ViewBag.Search.
    Created by BE2-09; styled by FE2-07 (page head, mist filter band, ledger table, pager).
*@
@{
    var search = (InstituteOfFineArts.Web.ViewModels.Staff.Exhibitions.ExhibitionSearchVm)ViewBag.Search;
    // Keeps the filters when moving between pages
    object PageRoute(int page) => new { search.Keyword, search.City, search.Status, From = search.From?.ToString("yyyy-MM-dd"), To = search.To?.ToString("yyyy-MM-dd"), page };
    var filtered = !string.IsNullOrEmpty(search.Keyword) || !string.IsNullOrEmpty(search.City) || search.Status != null || search.From != null || search.To != null;
}

<div class="page-head">
    <div>
        <h1>Exhibitions</h1>
        <p class="page-sub">Where the students' paintings are hung, shown and sold.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>New exhibition</a>
    </div>
</div>

<partial name="_Alerts" />

<form method="get" asp-action="Index" class="filters" role="search">
    <div class="filter">
        <label class="form-label" for="Keyword">Name</label>
        <input class="form-control" id="Keyword" name="Keyword" value="@search.Keyword" />
    </div>
    <div class="filter">
        <label class="form-label" for="City">City</label>
        <input class="form-control" id="City" name="City" value="@search.City" />
    </div>
    <div class="filter">
        <label class="form-label" for="Status">Status</label>
        <select class="form-select" id="Status" name="Status">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<InstituteOfFineArts.Web.Models.Enums.ExhibitionStatus>())
            {
                <option value="@s" selected="@(search.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="filter">
        <label class="form-label" for="From">From</label>
        <input class="form-control" type="date" id="From" name="From" value="@search.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter">
        <label class="form-label" for="To">To</label>
        <input class="form-control" type="date" id="To" name="To" value="@search.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-link">Clear</a>
        }
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="empty">
        <i class="bi bi-bank" aria-hidden="true"></i>
        <p>No exhibitions found.</p>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-outline-primary">Clear the filters</a>
        }
        else
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>New exhibition</a>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th scope="col">Name</th><th scope="col">City</th><th scope="col">Venue</th><th scope="col" class="text-end">Start</th><th scope="col" class="text-end">End</th><th scope="col">Status</th><th scope="col" class="text-end">Artworks</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Items)
                {
                    <tr>
                        <td class="row-title"><a asp-action="Details" asp-route-id="@e.Id">@e.Name</a></td>
                        <td>@e.City</td>
                        <td>@e.Venue</td>
                        <td class="text-end text-nowrap">@e.StartDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end text-nowrap">@e.EndDate.ToString("dd MMM yyyy")</td>
                        <td><partial name="~/Views/Shared/Exhibitions/_ExhibitionStatus.cshtml" model="e.Status" /></td>
                        <td class="text-end">@e.EntryCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="pager" aria-label="Pages">
        <span>@Model.TotalCount exhibition(s), page @Model.Page of @Model.TotalPages</span>
        <div class="pager-links">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page - 1))"><i class="bi bi-chevron-left" aria-hidden="true"></i>Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", PageRoute(Model.Page + 1))">Next<i class="bi bi-chevron-right ms-1" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}
