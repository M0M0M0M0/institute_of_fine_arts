@model InstituteOfFineArts.Web.Models.Enums.ExhibitionStatus
@*
    Tag for an exhibition status (UPCOMING / ONGOING / FINISHED), shared by the Staff, Manager and Student pages.
    Created by BE2-09; styled by FE2-07 (tag classes of site.css §7).
*@
@{
    var text = Model switch
    {
        InstituteOfFineArts.Web.Models.Enums.ExhibitionStatus.UPCOMING => "Upcoming",
        InstituteOfFineArts.Web.Models.Enums.ExhibitionStatus.ONGOING => "Ongoing",
        _ => "Finished",
    };
}
<span class="tag tag-@Model">@text</span>
