@inject Microsoft.Extensions.Localization.IStringLocalizer<InstituteOfFineArts.Web.SharedResource> L
@using InstituteOfFineArts.Web.Helpers
@*
    Public layout (FE1-01): slim white bar with the wordmark, public links and the account action,
    the page, and the navy footer. Pages with a full-bleed painting set ViewData["FullBleed"] = true;
    other pages are placed in the standard page column.
    Signed-in users also see a link back to their workspace (role dashboard).
*@
@{
    var path = (Context.Request.Path.Value ?? "/").TrimEnd('/').ToLowerInvariant();
    string? Current(string url) => (url == "/" ? path is "" or "/" : path == url || path.StartsWith(url + "/")) ? "page" : null;

    // Workspace of the signed-in role
    string? workspace = null;
    if (User.IsInRole(RoleNames.Admin)) { workspace = "/admin"; }
    else if (User.IsInRole(RoleNames.Manager)) { workspace = "/manager"; }
    else if (User.IsInRole(RoleNames.Staff)) { workspace = "/staff"; }
    else if (User.IsInRole(RoleNames.Student)) { workspace = "/student"; }
    var fullBleed = ViewData["FullBleed"] is true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#content">@L["Skip to content"]</a>
    <header class="site-header d-print-none" id="site-header">
        <nav class="site-nav" aria-label="@L["Main menu"]">
            <a class="wordmark" href="/" aria-label="Institute of Fine Arts – home"><partial name="_Wordmark" model="@("ink")" /></a>
            <button type="button" class="btn btn-sm btn-outline-primary site-menu-toggle" data-site-menu aria-controls="site-header" aria-expanded="false">
                <i class="bi bi-list" aria-hidden="true"></i>@L["Menu"]
            </button>
            <ul class="site-links">
                <li><a href="/" aria-current="@Current("/")">@L["Home"]</a></li>
                <li><a href="/competitions" aria-current="@Current("/competitions")">@L["Competitions"]</a></li>
                <li><a href="/gallery" aria-current="@Current("/gallery")">@L["Gallery"]</a></li>
                <li><a href="/about" aria-current="@Current("/about")">@L["About"]</a></li>
            </ul>
            <div class="site-actions">
                <div class="lang-switch"><partial name="_LanguageSwitch" /></div>
                @if (workspace != null)
                {
                    <a class="btn btn-sm btn-outline-primary" href="@workspace"><i class="bi bi-grid" aria-hidden="true"></i>@L["My workspace"]</a>
                    @* Log out with POST plus the anti-forgery token *@
                    <form method="post" action="/logout" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-link">@L["Log out"]</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-primary" href="/login">@L["Log in"]</a>
                }
            </div>
        </nav>
    </header>

    <main class="site-main" id="content" tabindex="-1">
        @if (fullBleed)
        {
            @RenderBody()
        }
        else
        {
            <div class="page">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="site-footer d-print-none">
        <div class="footer-inner">
            <div>
                <a class="wordmark mb-3" href="/" aria-label="Institute of Fine Arts – home"><partial name="_Wordmark" model="@("white")" /></a>
                <p class="mb-0">@L["Painting and animation courses, student competitions and exhibitions of their best work."]</p>
            </div>
            <div>
                <ul>
                    <li><a href="/competitions">@L["Competitions"]</a></li>
                    <li><a href="/gallery">@L["Gallery"]</a></li>
                    <li><a href="/about">@L["About"]</a></li>
                </ul>
            </div>
            <div>
                <ul>
                    @if (workspace != null)
                    {
                        <li><a href="@workspace">@L["My workspace"]</a></li>
                    }
                    else
                    {
                        <li><a href="/login">@L["Log in"]</a></li>
                    }
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">@L["Privacy"]</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-base">
            <span>&copy; @DateTimeHelper.Today.Year Institute of Fine Arts</span>
            <span>@L["Prices in USD"]</span>
        </div>
    </footer>
    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
