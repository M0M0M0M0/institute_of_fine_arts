@inject Microsoft.Extensions.Localization.IStringLocalizer<InstituteOfFineArts.Web.SharedResource> L
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InstituteOfFineArts.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InstituteOfFineArts.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @* d-print-none: menu and footer are left out when a report is printed (F-M10-08) *@
    <header class="d-print-none">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">InstituteOfFineArts.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @* Temporary menu per role, added by BE when integrating week 3; FE replaces it with the real navigation (FE2-01) *@
                    @{
                        var menu = new List<(string Text, string Url)>();
                        if (User.IsInRole(InstituteOfFineArts.Web.Helpers.RoleNames.Admin))
                        {
                            menu.AddRange([("Dashboard", "/admin"), ("Staff", "/admin/staff"), ("Students", "/admin/students"), ("Reports", "/reports")]);
                        }
                        else if (User.IsInRole(InstituteOfFineArts.Web.Helpers.RoleNames.Manager))
                        {
                            menu.AddRange([("Dashboard", "/manager"), ("Students", "/manager/students"), ("Staff", "/manager/staff"),
                                ("Competitions", "/manager/competitions"), ("Submissions", "/manager/submissions"), ("Awards", "/manager/awards"),
                                ("Exhibitions", "/manager/exhibitions"), ("Artworks", "/manager/exhibition-entries"),
                                ("Customers", "/manager/customers"), ("Reports", "/reports")]);
                        }
                        else if (User.IsInRole(InstituteOfFineArts.Web.Helpers.RoleNames.Staff))
                        {
                            menu.AddRange([("Dashboard", "/staff"), ("Competitions", "/staff/competitions"), ("Submissions", "/staff/submissions"),
                                ("Awards", "/staff/awards"), ("Students", "/staff/students"), ("Exhibitions", "/staff/exhibitions"),
                                ("Artworks", "/staff/exhibition-entries"), ("Customers", "/staff/customers"), ("Reports", "/reports")]);
                        }
                        else if (User.IsInRole(InstituteOfFineArts.Web.Helpers.RoleNames.Student))
                        {
                            menu.AddRange([("Dashboard", "/student"), ("Competitions", "/student/competitions"), ("My entries", "/student/submissions"),
                                ("My results", "/student/results"), ("Best works", "/student/best"), ("Awards", "/student/awards"),
                                ("Exhibitions", "/student/exhibitions"), ("My artworks on show", "/student/exhibition-entries")]);
                        }
                        else
                        {
                            menu.AddRange([("Home", "/"), ("Competitions", "/competitions"), ("Gallery", "/gallery"), ("About", "/about")]);
                        }
                    }
                    <ul class="navbar-nav flex-grow-1 flex-wrap">
                        @foreach (var item in menu)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="@item.Url">@L[item.Text]</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* Notification bell (M12, F-M12-02): unread count + 5 newest *@
                            @await Component.InvokeAsync("NotificationBell")
                            <li class="nav-item"><a class="nav-link text-dark" href="/profile">@L["Profile"]</a></li>
                            <li class="nav-item">
                                @* Log out with POST plus the anti-forgery token *@
                                <form method="post" action="/logout" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link text-dark">@L["Log out"]</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" href="/login">@L["Log in"]</a></li>
                        }
                    </ul>
                    @* English / Vietnamese switch (F-M19-01) *@
                    <partial name="_LanguageSwitch" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted d-print-none">
        <div class="container">
            &copy; 2026 - InstituteOfFineArts.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
