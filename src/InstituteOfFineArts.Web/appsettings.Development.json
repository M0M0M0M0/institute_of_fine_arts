{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // E-mail (BE1-OPT): Host empty = write .eml files to PickupDirectory (outside wwwroot, git-ignored).
  // To send real mail set Host/UserName/Password with User Secrets – never put the password here.
  "Email": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "FromAddress": "no-reply@ifa.local",
    "FromName": "Institute of Fine Arts",
    "PickupDirectory": "mail-pickup"
    // No AppBaseUrl in Development: links in e-mails use the address the page was opened with (localhost, a LAN IP,
    // any port), so the reset button always opens the server you are using. Outside Development it is required.
  }
}
