{
  // Chuỗi kết nối SQL Server: mặc định dùng Windows Authentication trên máy local.
  // SQL Server Express: đổi Server=localhost\\SQLEXPRESS
  // Dùng tài khoản SQL: KHÔNG ghi mật khẩu ở đây, đặt bằng User Secrets (xem README.md)
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=IFA_DB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  // Cấu hình lưu ảnh dự thi bằng File I/O (thư mục nằm ngoài wwwroot)
  "Upload": {
    "RootPath": "uploads",
    "MaxFileSizeBytes": 5242880,
    "ThumbnailWidth": 400
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
