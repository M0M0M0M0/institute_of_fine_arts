{
  // SQL Server connection string: Windows Authentication on the local machine by default.
  // SQL Server Express: use Server=localhost\\SQLEXPRESS
  // SQL login or SQL Server in Docker: do NOT put the password here, set it with User Secrets (see README.md)
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=IFA_DB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  // Storage of competition images with File I/O (folder outside wwwroot)
  "Upload": {
    "RootPath": "uploads",
    "MaxFileSizeBytes": 5242880,
    "ThumbnailWidth": 400
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
